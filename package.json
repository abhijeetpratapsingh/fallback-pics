{
  "name": "fallback-pics",
  "version": "1.0.0",
  "description": "Never show broken images again - A modern placeholder image service",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "worker:dev": "pnpm --filter @fallback-pics/worker dev",
    "worker:deploy": "pnpm --filter @fallback-pics/worker deploy",
    "web:dev": "pnpm --filter @fallback-pics/web dev",
    "web:build": "pnpm --filter @fallback-pics/web build",
    "web:seo:smoke": "pnpm --filter @fallback-pics/web seo:smoke",
    "web:seo:priority": "pnpm --filter @fallback-pics/web seo:priority",
    "web:visual:qa": "pnpm --filter @fallback-pics/web visual:qa",
    "deploy": "./deploy.sh --production",
    "deploy:preview": "./deploy.sh",
    "deploy:worker": "./deploy.sh --worker-only --production",
    "deploy:web": "./deploy.sh --web-only --production",
    "deploy:all": "./deploy.sh --production"
  },
  "keywords": [
    "placeholder",
    "image",
    "fallback",
    "developer-tools",
    "cloudflare-workers"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.12.0"
}
