---
import '../../../../theme.css';
import '../styles/modern-ui.css';
import '../styles/accessibility.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  header?: boolean;
  footer?: boolean;
  robots?: string;
}

const { 
  title, 
  description = "Lightning-fast placeholder images for developers. Simple URLs, instant results, zero configuration.",
  keywords = "placeholder images, image placeholder api, dummy images, developer tools, web development, mockup images, fallback images, svg placeholder, png placeholder",
  canonical,
  ogImage = "https://fallback.pics/api/v1/1200x630/7C3AED/FFFFFF?text=fallback.pics",
  ogImageWidth,
  ogImageHeight,
  header = true,
  footer = true,
  robots = 'index, follow',
} = Astro.props;

const fullTitle = title.includes('fallback.pics') ? title : `${title} - fallback.pics`;
const currentUrl = canonical || `https://fallback.pics${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={robots} />
    <meta name="author" content="ABHIJEET PRATAP SINGH" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={currentUrl} />
    
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="fallback.pics" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@fallbackpics" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Additional SEO -->
    <meta name="theme-color" content="#7C3AED" />
    <meta name="application-name" content="fallback.pics" />
    <meta name="msapplication-TileColor" content="#7C3AED" />
    
    <title>{fullTitle}</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400..800&display=swap" rel="stylesheet" />

    <GoogleAnalytics />
  </head>
  <body>
    <!-- Skip to main content link for screen readers -->
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    {header && <SiteHeader />}
    <slot />
    {footer && <SiteFooter />}
  </body>
</html>

<style is:global>
  html {
    font-family: var(--font-sans);
    background: var(--color-surface);
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-display);
  }

  pre,
  code,
  kbd,
  samp {
    font-family: var(--font-mono);
  }
</style>
