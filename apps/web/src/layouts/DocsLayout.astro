---
import Layout from './Layout.astro';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
}

const {
  title,
  description = 'Documentation for fallback.pics fallback image infrastructure.',
  keywords = 'fallback.pics docs, placeholder image api docs, fallback image api',
} = Astro.props;
---

<Layout title={title} description={description} keywords={keywords} header="docs">
  <main id="main-content" class="docs-shell">
    <slot />
  </main>
</Layout>

<style>
  .docs-shell {
    min-height: 100vh;
    overflow-x: clip;
    background: var(--color-surface-subtle);
    color: var(--color-text);
  }

  .docs-shell :global(*) {
    box-sizing: border-box;
  }

  .docs-shell :global(pre),
  .docs-shell :global(code),
  .docs-shell :global(table) {
    max-width: 100%;
  }

  .docs-shell :global(pre) {
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .docs-shell :global(code) {
      overflow-wrap: anywhere;
    }
  }
</style>
