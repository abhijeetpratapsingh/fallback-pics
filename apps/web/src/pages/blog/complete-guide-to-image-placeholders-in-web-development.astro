                  <pre class="text-green-400 text-sm"><code>/* CSS for loading states */
img[loading="lazy"] {
  background: url('data:image/svg+xml,&lt;svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300"&gt;&lt;rect width="100%" height="100%" fill="%23f3f4f6"/&gt;&lt;text x="50%" y="50%" text-anchor="middle" dy=".3em" fill="%239ca3af"&gt;Loading...&lt;/text&gt;&lt;/svg&gt;');
  background-size: cover;
}

/* Intersection Observer for custom loading */
const imageObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      const img = entry.target;
      img.src = img.dataset.src;
      img.classList.remove('lazy');
      imageObserver.unobserve(img);
    }
  });
});

document.querySelectorAll('img[data-src]').forEach(img => {
  imageObserver.observe(img);
});</code></pre>
                </div>
              </div>
            </div>
          </div>
        </section>

