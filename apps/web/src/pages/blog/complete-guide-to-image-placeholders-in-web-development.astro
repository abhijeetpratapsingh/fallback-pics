                <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
                  <pre class="text-green-400 text-sm"><code>import { useState, useEffect } from 'react';

function useImageLoader(src, placeholder, fallback) {
  const [imageSrc, setImageSrc] = useState(placeholder);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(false);

  useEffect(() => {
    const img = new Image();
    
    img.onload = () => {
      setImageSrc(src);
      setLoading(false);
    };
    
    img.onerror = () => {
      setImageSrc(fallback);
      setLoading(false);
      setError(true);
    };
    
    img.src = src;
  }, [src, fallback]);

  return { imageSrc, loading, error };
}

// Component usage
function SmartImage({ src, alt, className }) {
  const { imageSrc, loading, error } = useImageLoader(
    src,
    'https://fallback.pics/400x300/F3F4F6/9CA3AF?text=Loading...',
    'https://fallback.pics/400x300/FEE2E2/DC2626?text=Failed+to+load'
  );

  return (
    &lt;img
      src={imageSrc}
      alt={alt}
      className={`${className} ${loading ? 'loading' : ''} ${error ? 'error' : ''}`}
    /&gt;
  );
}</code></pre>
