                <pre class="text-green-400 text-sm"><code>// Predictive image preloader
class PredictivePreloader {
  constructor() {
    this.preloadCache = new Set();
    this.observeUserBehavior();
  }
  
  observeUserBehavior() {
    // Preload on hover with delay
    document.addEventListener('mouseover', (e) => {
      const link = e.target.closest('a[href]');
      if (link && !this.preloadCache.has(link.href)) {
        setTimeout(() => {
          if (link.matches(':hover')) {
            this.preloadPage(link.href);
          }
        }, 100); // Small delay to avoid accidental hovers
      }
    });
    
    // Preload visible images early
    this.observeNearbyImages();
  }
  
  observeNearbyImages() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const img = entry.target;
          const nextImages = this.getNextImages(img, 2);
          nextImages.forEach(nextImg => this.preloadImage(nextImg));
        }
      });
    }, {
      rootMargin: '100px' // Start preloading when image is 100px away
    });
    
    document.querySelectorAll('img[data-src]').forEach(img => {
      observer.observe(img);
    });
  }
  
  preloadImage(src) {
    if (this.preloadCache.has(src)) return;
    
    this.preloadCache.add(src);
    const link = document.createElement('link');
    link.rel = 'preload';
    link.as = 'image';
    link.href = src;
    document.head.appendChild(link);
  }
  
  getNextImages(currentImg, count = 2) {
    const images = Array.from(document.querySelectorAll('img[data-src]'));
    const currentIndex = images.indexOf(currentImg);
    
    return images
      .slice(currentIndex + 1, currentIndex + 1 + count)
      .map(img => img.dataset.src)
      .filter(Boolean);
  }
}

// Initialize predictive preloader
new PredictivePreloader();</code></pre>
