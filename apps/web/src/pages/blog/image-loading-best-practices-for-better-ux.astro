                <pre class="text-green-400 text-sm"><code>// Connection-aware preloading
class AdaptivePreloader {
  constructor() {
    this.connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    this.preloadStrategy = this.determineStrategy();
  }
  
  determineStrategy() {
    if (!this.connection) return 'moderate';
    
    const { effectiveType, downlink, saveData } = this.connection;
    
    // Respect user's data saving preference
    if (saveData) return 'minimal';
    
    // Adapt based on connection speed
    if (effectiveType === '4g' && downlink > 1.5) return 'aggressive';
    if (effectiveType === '3g' || downlink > 0.5) return 'moderate';
    return 'minimal';
  }
  
  preloadImages(images) {
    const strategies = {
      aggressive: () => this.preloadAll(images),
      moderate: () => this.preloadCritical(images),
      minimal: () => this.preloadHero(images)
    };
    
    strategies[this.preloadStrategy]();
  }
  
  preloadAll(images) {
    // Preload all above-the-fold and some below
    images.slice(0, 10).forEach(img => this.preload(img));
  }
  
  preloadCritical(images) {
    // Preload only critical above-the-fold images
    images.slice(0, 3).forEach(img => this.preload(img));
  }
  
  preloadHero(images) {
    // Preload only hero/banner images
    const heroImages = images.filter(img => 
      img.classList.contains('hero') || 
      img.closest('.hero, .banner')
    );
    heroImages.forEach(img => this.preload(img));
  }
  
  preload(imgElement) {
    const link = document.createElement('link');
    link.rel = 'preload';
    link.as = 'image';
    link.href = imgElement.dataset.src || imgElement.src;
    document.head.appendChild(link);
  }
}

// Initialize adaptive preloader
const preloader = new AdaptivePreloader();
preloader.preloadImages(document.querySelectorAll('img'));</code></pre>
