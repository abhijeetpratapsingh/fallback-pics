                  <li>• Limited customization options</li>
                  <li>• No placeholder control</li>
                  <li>• Can't implement progressive loading</li>
                </ul>
              </div>
            </div>

            <div class="border-l-4 border-blue-400 bg-blue-50 p-6 rounded-r-lg">
              <h3 class="text-xl font-semibold text-blue-900 mb-4">Intersection Observer Lazy Loading</h3>
              <p class="text-blue-800 mb-4">Advanced lazy loading with full control and placeholder support:</p>
              <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto mb-4">
                <pre class="text-green-400 text-sm"><code>// Enhanced lazy loading with placeholders
class LazyImageLoader {
  constructor() {
    this.imageObserver = new IntersectionObserver(
      this.handleIntersection.bind(this),
      {
        rootMargin: '50px 0px', // Start loading 50px before visible
        threshold: 0.01
      }
    );
    
    this.init();
  }
  
  init() {
    document.querySelectorAll('img[data-src]').forEach(img => {
      // Show placeholder immediately
      img.src = img.dataset.placeholder || 
        'https://fallback.pics/400x300/F3F4F6/9CA3AF?text=Loading...';
      
      this.imageObserver.observe(img);
    });
  }
  
  handleIntersection(entries) {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        this.loadImage(entry.target);
        this.imageObserver.unobserve(entry.target);
      }
    });
  }
  
  loadImage(img) {
    const image = new Image();
    
    image.onload = () => {
      img.src = img.dataset.src;
      img.classList.add('loaded');
    };
    
    image.onerror = () => {
      img.src = img.dataset.fallback || 
        'https://fallback.pics/400x300/FEE2E2/DC2626?text=Failed+to+load';
      img.classList.add('error');
    };
    
    image.src = img.dataset.src;
  }
}

// Initialize
new LazyImageLoader();</code></pre>
