                <pre class="text-green-400 text-sm"><code>// Custom image performance tracking
class ImageMetrics {
  constructor() {
    this.imageStats = {
      totalImages: 0,
      loadedImages: 0,
      failedImages: 0,
      fallbacksUsed: 0,
      averageLoadTime: 0,
      largestImage: 0,
      totalBytes: 0
    };
    
    this.startTracking();
  }
  
  startTracking() {
    // Track all images on page
    const images = document.querySelectorAll('img');
    this.imageStats.totalImages = images.length;
    
    images.forEach(img => this.trackImage(img));
    
    // Track dynamically added images
    const observer = new MutationObserver((mutations) => {
      mutations.forEach(mutation => {
        mutation.addedNodes.forEach(node => {
          if (node.tagName === 'IMG') {
            this.imageStats.totalImages++;
            this.trackImage(node);
          }
        });
      });
    });
    
    observer.observe(document.body, {
      childList: true,
      subtree: true
    });
  }
  
  trackImage(img) {
    const startTime = performance.now();
    
    const handleLoad = () => {
      const loadTime = performance.now() - startTime;
      this.imageStats.loadedImages++;
      this.updateAverageLoadTime(loadTime);
      
      // Get image size if possible
      this.getImageSize(img.src).then(size => {
        this.imageStats.totalBytes += size;
        this.imageStats.largestImage = Math.max(this.imageStats.largestImage, size);
        this.reportStats();
      });
    };
    
    const handleError = () => {
      this.imageStats.failedImages++;
      if (img.classList.contains('fallback-active')) {
        this.imageStats.fallbacksUsed++;
      }
      this.reportStats();
    };
    
    if (img.complete) {
      if (img.naturalWidth > 0) {
        handleLoad();
      } else {
        handleError();
      }
    } else {
      img.addEventListener('load', handleLoad);
      img.addEventListener('error', handleError);
    }
  }
  
  updateAverageLoadTime(newTime) {
    const count = this.imageStats.loadedImages;
    this.imageStats.averageLoadTime = 
      (this.imageStats.averageLoadTime * (count - 1) + newTime) / count;
  }
  
  async getImageSize(url) {
    try {
      const response = await fetch(url, { method: 'HEAD' });
      return parseInt(response.headers.get('content-length')) || 0;
    } catch {
      return 0;
    }
  }
  
  reportStats() {
    const successRate = (this.imageStats.loadedImages / this.imageStats.totalImages * 100).toFixed(1);
    const fallbackRate = (this.imageStats.fallbacksUsed / this.imageStats.totalImages * 100).toFixed(1);
    
    console.log('Image Performance Stats:', {
      ...this.imageStats,
      successRate: `${successRate}%`,
      fallbackRate: `${fallbackRate}%`,
      averageLoadTime: `${this.imageStats.averageLoadTime.toFixed(0)}ms`,
      totalBytes: `${(this.imageStats.totalBytes / 1024).toFixed(0)}KB`
    });
  }
}

// Initialize tracking
new ImageMetrics();</code></pre>
