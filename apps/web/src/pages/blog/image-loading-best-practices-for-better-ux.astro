class LQIPLoader {
  constructor(img) {
    this.img = img;
    this.lowQualitySrc = img.dataset.lqip; // base64 thumbnail
    this.highQualitySrc = img.dataset.src;
    
    this.loadProgressive();
  }
  
  loadProgressive() {
    // 1. Show LQIP immediately with blur
    this.img.src = this.lowQualitySrc;
    this.img.style.filter = 'blur(5px)';
    this.img.style.transform = 'scale(1.05)';
    
    // 2. Preload high quality image
    const highQualityImage = new Image();
    
    highQualityImage.onload = () => {
      // 3. Fade in sharp image
      this.img.style.transition = 'all 0.3s ease';
      this.img.src = this.highQualitySrc;
      this.img.style.filter = 'blur(0px)';
      this.img.style.transform = 'scale(1)';
    };
    
    highQualityImage.src = this.highQualitySrc;
  }
}</code></pre>
