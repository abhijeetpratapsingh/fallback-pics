                <pre class="text-green-400 text-sm"><code>// Smart retry mechanism
class SmartRetryLoader {
  constructor(img, options = {}) {
    this.img = img;
    this.originalSrc = img.dataset.src;
    this.maxRetries = options.maxRetries || 3;
    this.retryDelay = options.retryDelay || 1000;
    this.backoffMultiplier = options.backoffMultiplier || 2;
    
    this.retryCount = 0;
    this.load();
  }
  
  load() {
    const tempImg = new Image();
    
    tempImg.onload = () => {
      this.img.src = this.originalSrc;
      this.img.classList.add('loaded');
    };
    
    tempImg.onerror = () => {
      this.handleError();
    };
    
    tempImg.src = this.originalSrc;
  }
  
  handleError() {
    if (this.retryCount < this.maxRetries) {
      this.retryCount++;
      const delay = this.retryDelay * Math.pow(this.backoffMultiplier, this.retryCount - 1);
      
      console.log(`Retrying image load (attempt ${this.retryCount}/${this.maxRetries}) in ${delay}ms`);
      
      setTimeout(() => {
        this.load();
      }, delay);
    } else {
      this.showFallback();
    }
  }
  
  showFallback() {
    this.img.src = this.img.dataset.fallback || 
      'https://fallback.pics/400x300/FEE2E2/DC2626?text=Failed+to+load';
    this.img.classList.add('error');
  }
}

// Usage with exponential backoff
// Retry after 1s, then 2s, then 4s
new SmartRetryLoader(document.querySelector('img'), {
  maxRetries: 3,
  retryDelay: 1000,
  backoffMultiplier: 2
});</code></pre>
