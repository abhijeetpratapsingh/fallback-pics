class MultiStageLoader {
  constructor(img, stages) {
    this.img = img;
    this.stages = stages; // Array of {src, quality, size}
    this.currentStage = 0;
    
    this.loadNextStage();
  }
  
  loadNextStage() {
    if (this.currentStage >= this.stages.length) return;
    
    const stage = this.stages[this.currentStage];
    const tempImage = new Image();
    
    tempImage.onload = () => {
      this.img.src = stage.src;
      this.currentStage++;
      
      // Continue to next stage after a brief delay
      setTimeout(() => this.loadNextStage(), 100);
    };
    
    tempImage.src = stage.src;
  }
}</code></pre>
