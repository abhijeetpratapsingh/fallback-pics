class FormatSelector {
  constructor() {
    this.supportedFormats = this.detectFormats();
  }
  
  detectFormats() {
    const canvas = document.createElement('canvas');
    canvas.width = canvas.height = 1;
    const ctx = canvas.getContext('2d');
    
    return {
      avif: canvas.toDataURL('image/avif').indexOf('data:image/avif') === 0,
      webp: canvas.toDataURL('image/webp').indexOf('data:image/webp') === 0,
      jpeg: true, // Universal support
      png: true   // Universal support
    };
  }
  
  getBestFormat(imageType = 'photo') {
    const formatPriority = {
      photo: ['avif', 'webp', 'jpeg'],
      graphic: ['avif', 'webp', 'png'],
      icon: ['svg', 'webp', 'png'],
      transparent: ['avif', 'webp', 'png']
    };
    
    const priority = formatPriority[imageType] || formatPriority.photo;
    
    for (const format of priority) {
      if (this.supportedFormats[format]) {
        return format;
      }
    }
    
    return 'jpeg'; // Ultimate fallback
  }
  
  getOptimalUrl(baseUrl, imageType) {
    const format = this.getBestFormat(imageType);
    return `${baseUrl}.${format}`;
  }
}

// Usage
const selector = new FormatSelector();
const optimizedUrl = selector.getOptimalUrl('https://fallback.pics/800x600', 'photo');
