              <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto mb-4">
                <pre class="text-green-400 text-sm"><code>import { useState, useEffect, useRef } from 'react';

function useLazyImage(src, placeholder) {
  const [imageSrc, setImageSrc] = useState(placeholder);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(false);
  const imgRef = useRef();

  useEffect(() => {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          const image = new Image();
          
          image.onload = () => {
            setImageSrc(src);
            setLoading(false);
          };
          
          image.onerror = () => {
            setError(true);
            setLoading(false);
          };
          
          image.src = src;
          observer.disconnect();
        }
      },
      { rootMargin: '50px' }
    );

    if (imgRef.current) {
      observer.observe(imgRef.current);
    }

    return () => observer.disconnect();
  }, [src]);

  return { imgRef, imageSrc, loading, error };
}

// Component usage
function LazyImage({ src, placeholder, alt, ...props }) {
  const { imgRef, imageSrc, loading, error } = useLazyImage(
    src, 
    placeholder || 'https://fallback.pics/400x300?text=Loading'
  );

  return (
    &lt;img
      ref={imgRef}
      src={imageSrc}
      alt={alt}
      className={`transition-opacity duration-300 ${
        loading ? 'opacity-50' : 'opacity-100'
      }`}
      {...props}
    /&gt;
  );
}</code></pre>
