                <pre class="text-green-400 text-sm"><code>// Robust fallback system
class RobustImageLoader {
  constructor(img, options = {}) {
    this.img = img;
    this.sources = [
      options.primary || img.dataset.src,
      options.backup || img.dataset.backup,
      options.placeholder || `https://fallback.pics/${img.width || 400}x${img.height || 300}/E5E5E5/9CA3AF?text=Image+Unavailable`,
      options.emergency || 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300"><rect width="100%" height="100%" fill="%23f3f4f6"/><text x="50%" y="50%" text-anchor="middle" dy=".3em" fill="%239ca3af">Image</text></svg>'
    ].filter(Boolean);
    
    this.currentSourceIndex = 0;
    this.loadWithFallback();
  }
  
  loadWithFallback() {
    if (this.currentSourceIndex >= this.sources.length) {
      this.handleFinalFailure();
      return;
    }
    
    const currentSource = this.sources[this.currentSourceIndex];
    const tempImg = new Image();
    
    tempImg.onload = () => {
      this.img.src = currentSource;
      this.img.classList.remove('loading', 'error');
      this.img.classList.add('loaded');
    };
    
    tempImg.onerror = () => {
      console.warn(`Image failed to load: ${currentSource}`);
      this.currentSourceIndex++;
      this.loadWithFallback();
    };
    
    tempImg.src = currentSource;
  }
  
  handleFinalFailure() {
    // All sources failed, use CSS background
    this.img.style.display = 'none';
    const fallback = document.createElement('div');
    fallback.className = 'image-fallback-final';
    fallback.style.cssText = `
      width: ${this.img.width || 400}px;
      height: ${this.img.height || 300}px;
      background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
