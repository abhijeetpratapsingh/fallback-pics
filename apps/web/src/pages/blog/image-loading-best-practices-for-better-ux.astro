import { getCLS, getFID, getFCP, getLCP, getTTFB } from 'web-vitals';

class ImagePerformanceMonitor {
  constructor() {
    this.metrics = {};
    this.initializeTracking();
  }
  
  initializeTracking() {
    // Track Core Web Vitals
    getCLS(this.handleCLS.bind(this));
    getFID(this.handleFID.bind(this));
    getFCP(this.handleFCP.bind(this));
    getLCP(this.handleLCP.bind(this));
    getTTFB(this.handleTTFB.bind(this));
    
    // Track image-specific metrics
    this.trackImageLoadTimes();
    this.trackFallbackUsage();
  }
  
  handleLCP(metric) {
    this.metrics.lcp = metric;
    
    // Check if LCP element is an image
    if (metric.entries[metric.entries.length - 1].element?.tagName === 'IMG') {
      this.trackLCPImage(metric);
    }
    
    this.sendMetrics('lcp', metric);
  }
  
  trackImageLoadTimes() {
    const observer = new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        if (entry.initiatorType === 'img') {
          this.sendMetrics('image_load_time', {
            url: entry.name,
            loadTime: entry.responseEnd - entry.startTime,
            size: entry.transferSize
          });
        }
      }
    });
    
    observer.observe({ entryTypes: ['resource'] });
  }
  
  trackFallbackUsage() {
    document.addEventListener('error', (e) => {
      if (e.target.tagName === 'IMG') {
        this.sendMetrics('image_error', {
          src: e.target.src,
          alt: e.target.alt,
          timestamp: Date.now()
        });
      }
    }, true);
  }
  
  sendMetrics(type, data) {
    // Send to analytics service
    if (window.gtag) {
      gtag('event', type, {
        custom_parameter_1: data.value || data.loadTime,
        custom_parameter_2: data.url || data.src
      });
    }
    
    // Or send to custom analytics
    fetch('/api/metrics', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type, data, timestamp: Date.now() })
    });
  }
}

// Initialize monitoring
new ImagePerformanceMonitor();</code></pre>
