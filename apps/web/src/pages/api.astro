---
import DocsLayout from '../layouts/DocsLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';

const baseUrl = 'https://fallback.pics/api/v1';

const navItems = [
  { href: '#base-url', label: 'Base URL' },
  { href: '#routes', label: 'Routes' },
  { href: '#parameters', label: 'Parameters' },
  { href: '#examples', label: 'Code Examples' },
  { href: '#headers', label: 'Response Headers' },
  { href: '#limits', label: 'Usage Limits' },
];

const routes = [
  {
    title: 'Standard fallback',
    path: '/640x360',
    description: 'Create a deterministic SVG placeholder from dimensions alone.',
    image: `${baseUrl}/640x360`,
  },
  {
    title: 'Custom color and label',
    path: '/800x450/18181B/FFFFFF?text=Product+Image',
    description: 'Set visible fallback copy and brand-safe colors from the URL.',
    image: `${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image`,
  },
  {
    title: 'Avatar initials',
    path: '/avatar/160?text=JD',
    description: 'Generate compact initials for user, team, or organization avatars.',
    image: `${baseUrl}/avatar/160?text=JD`,
  },
  {
    title: 'Skeleton state',
    path: '/animated/skeleton/640x360',
    description: 'Reserve the final image box while asynchronous media loads.',
    image: `${baseUrl}/animated/skeleton/640x360`,
  },
];

const parameters = [
  { name: 'width', type: 'number', description: 'Image width in pixels. Standard routes support 1-5000px in the active worker.' },
  { name: 'height', type: 'number', description: 'Image height in pixels. Omit for square and avatar presets.' },
  { name: 'bg', type: 'hex', description: 'Optional background color. Path colors and query colors are both supported.' },
  { name: 'fg', type: 'hex', description: 'Optional foreground/text color.' },
  { name: 'text', type: 'query string', description: 'URL-encoded label rendered inside the generated SVG.' },
  { name: 'retina', type: 'number', description: 'Optional size multiplier for higher-density placeholders.' },
  { name: 'reducedMotion', type: 'boolean', description: 'Disables animated SVG effects where supported.' },
];

const headers = [
  { name: 'Content-Type', value: 'image/svg+xml', detail: 'The production worker currently returns SVG for generated images.' },
  { name: 'Cache-Control', value: 'public, max-age=31536000, immutable', detail: 'Deterministic URLs are designed for long-lived CDN caching.' },
  { name: 'Access-Control-Allow-Origin', value: '*', detail: 'Generated fallbacks can be used from browser, server, email, and native surfaces.' },
];

const htmlExample = `<img
  src="${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image"
  width="800"
  height="450"
  alt="Product image fallback"
/>`;

const cssExample = `.product-card::before {
  background-image: url("${baseUrl}/600x400/F4F4F5/52525B?text=Loading");
}`;

const jsExample = `export function fallbackImage(width, height, label) {
  const params = new URLSearchParams({ text: label });
  return "${baseUrl}/" + width + "x" + height + "?" + params;
}`;

const reactExample = `export function ProductImageFallback() {
  return (
    <img
      src="${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image"
      width={800}
      height={450}
      alt="Product image fallback"
    />
  );
}`;
---

<DocsLayout
  title="API Reference | fallback.pics"
  description="Production API reference for fallback.pics SVG fallback image infrastructure, including URL routes, parameters, headers, and framework examples."
>
  <div class="api-page">
    <section class="api-hero" id="base-url">
      <div>
        <p class="api-eyebrow">API Reference</p>
        <h1>Fallback images generated from predictable URLs.</h1>
        <p>
          Use one cacheable endpoint for product images, avatars, loading states, charts, and broken-image recovery. No SDK or authentication required for public routes.
        </p>
      </div>
      <div class="api-hero__panel">
        <span>Base URL</span>
        <code>{baseUrl}</code>
      </div>
    </section>

    <div class="api-grid">
      <aside class="api-sidebar" aria-label="API navigation">
        <span>Reference</span>
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </aside>

      <article class="api-content">
        <section id="routes" class="api-section">
          <div class="api-section__header">
            <p>Routes</p>
            <h2>Purpose-built endpoints for common image states.</h2>
          </div>
          <div class="api-route-grid">
            {routes.map((route) => (
              <a href={`${baseUrl}${route.path}`} target="_blank" rel="noreferrer" class="api-route-card">
                <div class="api-route-card__media">
                  <img src={route.image} alt={`${route.title} preview`} loading="lazy" />
                </div>
                <div>
                  <h3>{route.title}</h3>
                  <code>{route.path}</code>
                  <p>{route.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section id="parameters" class="api-section">
          <div class="api-section__header">
            <p>Parameters</p>
            <h2>Small surface area, explicit behavior.</h2>
          </div>
          <div class="api-table-wrap">
            <table class="api-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Type</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                {parameters.map((param) => (
                  <tr>
                    <td><code>{param.name}</code></td>
                    <td>{param.type}</td>
                    <td>{param.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="api-callout">
            <strong>Format note:</strong>
            The current edge implementation returns SVG responses. File extensions are parsed for route compatibility, but PNG, JPEG, WebP, AVIF, and GIF conversion should not be advertised until conversion is implemented in the worker.
          </div>
        </section>

        <section id="examples" class="api-section">
          <div class="api-section__header">
            <p>Code Examples</p>
            <h2>Use the API anywhere an image URL is accepted.</h2>
          </div>
          <div class="api-code-grid">
            <CodeBlock label="HTML" language="html" code={htmlExample} />
            <CodeBlock label="CSS" language="css" code={cssExample} />
            <CodeBlock label="JavaScript" language="ts" code={jsExample} />
            <CodeBlock label="React" language="tsx" code={reactExample} />
          </div>
        </section>

        <section id="headers" class="api-section">
          <div class="api-section__header">
            <p>Headers</p>
            <h2>Optimized for repeated production delivery.</h2>
          </div>
          <div class="api-header-grid">
            {headers.map((header) => (
              <div>
                <h3>{header.name}</h3>
                <code>{header.value}</code>
                <p>{header.detail}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="limits" class="api-section">
          <div class="api-final-cta">
            <div>
              <h2>Ready to ship image fallbacks?</h2>
              <p>Start with public URL routes. Higher-volume usage, custom domains, and SLA terms can be handled through an enterprise agreement.</p>
            </div>
            <a href="/docs">Read the Docs</a>
          </div>
        </section>
      </article>
    </div>
  </div>
</DocsLayout>

<style>
  .api-page {
    width: min(100% - 2rem, 80rem);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .api-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.48fr);
    gap: 2rem;
    align-items: end;
    border-bottom: 1px solid #e4e4e7;
    padding-bottom: 3rem;
  }

  .api-eyebrow,
  .api-section__header p,
  .api-sidebar span {
    margin: 0;
    color: #6d28d9;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .api-hero h1 {
    max-width: 56rem;
    margin: 1rem 0 0;
    color: #18181b;
    font-size: clamp(2.75rem, 6vw, 5.75rem);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .api-hero p:not(.api-eyebrow) {
    max-width: 45rem;
    margin: 1.25rem 0 0;
    color: #52525b;
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .api-hero__panel,
  .api-route-card,
  .api-table-wrap,
  .api-callout,
  .api-header-grid > div,
  .api-final-cta {
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #ffffff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }

  .api-hero__panel {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .api-hero__panel span {
    color: #71717a;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .api-hero__panel code,
  .api-header-grid code {
    display: block;
    overflow-wrap: anywhere;
    border-radius: 0.5rem;
    background: #18181b;
    color: #86efac;
    font-size: 0.9375rem;
    line-height: 1.6;
    padding: 1rem;
  }

  .api-grid {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    padding-top: 3rem;
  }

  .api-sidebar {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 0.25rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #ffffff;
    padding: 0.75rem;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }

  .api-sidebar span {
    padding: 0.5rem 0.75rem 0.625rem;
  }

  .api-sidebar a {
    border-radius: 0.5rem;
    color: #52525b;
    font-size: 0.875rem;
    font-weight: 650;
    padding: 0.625rem 0.75rem;
    text-decoration: none;
  }

  .api-sidebar a:hover {
    background: #f4f4f5;
    color: #18181b;
  }

  .api-content {
    display: grid;
    gap: 4rem;
    min-width: 0;
  }

  .api-section {
    scroll-margin-top: 6rem;
  }

  .api-section__header {
    margin-bottom: 1.5rem;
  }

  .api-section__header h2,
  .api-final-cta h2 {
    margin: 0.625rem 0 0;
    color: #18181b;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .api-route-grid,
  .api-code-grid,
  .api-header-grid {
    display: grid;
    gap: 1rem;
  }

  .api-route-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .api-code-grid,
  .api-header-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .api-route-card {
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .api-route-card:hover {
    border-color: #c4b5fd;
    transform: translateY(-1px);
  }

  .api-route-card__media {
    display: grid;
    min-height: 12rem;
    place-items: center;
    border-bottom: 1px solid #e4e4e7;
    background: #f4f4f5;
    padding: 1rem;
  }

  .api-route-card img {
    width: 100%;
    max-height: 11rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    object-fit: contain;
  }

  .api-route-card > div:last-child,
  .api-callout,
  .api-header-grid > div {
    padding: 1.25rem;
  }

  .api-route-card h3,
  .api-header-grid h3 {
    margin: 0;
    color: #18181b;
    font-size: 1rem;
    font-weight: 700;
  }

  .api-route-card p,
  .api-header-grid p,
  .api-callout,
  .api-final-cta p {
    color: #52525b;
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .api-route-card code {
    display: block;
    margin: 0.75rem 0;
    overflow-wrap: anywhere;
    color: #18181b;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .api-table-wrap {
    overflow-x: auto;
  }

  .api-table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
  }

  .api-table th,
  .api-table td {
    border-bottom: 1px solid #e4e4e7;
    padding: 1rem;
    text-align: left;
    vertical-align: top;
  }

  .api-table th {
    background: #f4f4f5;
    color: #52525b;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .api-table tr:last-child td {
    border-bottom: 0;
  }

  .api-table td {
    color: #52525b;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .api-table code {
    color: #18181b;
    font-weight: 700;
  }

  .api-callout {
    margin-top: 1rem;
    border-color: #c4b5fd;
    background: #f5f3ff;
  }

  .api-callout strong {
    color: #4c1d95;
  }

  .api-final-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem;
    background: #18181b;
  }

  .api-final-cta h2 {
    color: #ffffff;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .api-final-cta p {
    margin: 0.75rem 0 0;
    color: #a1a1aa;
  }

  .api-final-cta a {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: #ffffff;
    color: #18181b;
    font-size: 0.875rem;
    font-weight: 800;
    padding: 0 1rem;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .api-hero,
    .api-grid,
    .api-route-grid {
      grid-template-columns: 1fr;
    }

    .api-sidebar {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .api-page {
      padding: 2.5rem 0 4rem;
    }

    .api-hero h1 {
      font-size: 2.75rem;
    }

    .api-final-cta {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
