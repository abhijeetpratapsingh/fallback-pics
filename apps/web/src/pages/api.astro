---
import DocsLayout from '../layouts/DocsLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';

const baseUrl = 'https://fallback.pics/api/v1';

const navItems = [
  { href: '#base-url', label: 'Base URL' },
  { href: '#routes', label: 'Routes' },
  { href: '#parameters', label: 'Parameters' },
  { href: '#examples', label: 'Code Examples' },
  { href: '#headers', label: 'Response Headers' },
  { href: '#errors', label: 'Error Behavior' },
  { href: '#limits', label: 'Usage Limits' },
];

const routes = [
  {
    title: 'Blog thumbnail',
    path: '/api/v1/thumbnail/1200x630?text=How+to+Fix+Broken+Images&style=soft&label=Guide',
    description: 'Generate a featured-image style thumbnail from a title. Decorative elements stay outside the text safe zone.',
    image: `${baseUrl}/thumbnail/1200x630?text=How+to+Fix+Broken+Images&style=soft&label=Guide`,
  },
  {
    title: 'Standard fallback',
    path: '/api/v1/640x360',
    description: 'Create a deterministic placeholder from dimensions alone. SVG is the default output.',
    image: `${baseUrl}/640x360`,
  },
  {
    title: 'Custom color and label',
    path: '/api/v1/800x450/18181B/FFFFFF?text=Product+Image',
    description: 'Set visible fallback copy and brand-safe colors from the URL.',
    image: `${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image`,
  },
  {
    title: 'Avatar initials',
    path: '/api/v1/avatar/160?text=JD',
    description: 'Generate compact initials for user, team, or organization avatars.',
    image: `${baseUrl}/avatar/160?text=JD`,
  },
  {
    title: 'Skeleton state',
    path: '/api/v1/animated/skeleton/640x360',
    description: 'Reserve the final image box while asynchronous media loads.',
    image: `${baseUrl}/animated/skeleton/640x360`,
  },
];

const parameters = [
  { name: 'width', type: 'number', description: 'Image width in pixels. Standard routes support 1-5000px in the active worker.' },
  { name: 'height', type: 'number', description: 'Image height in pixels. Omit for square and avatar presets.' },
  { name: 'bgColor', type: 'path hex', description: 'Optional background color as a path segment after dimensions, without the # prefix.' },
  { name: 'textColor', type: 'path hex', description: 'Optional foreground/text color as the next path segment, without the # prefix.' },
  { name: 'text', type: 'query string', description: 'URL-encoded label rendered inside the generated image.' },
  { name: 'style', type: 'query string', description: 'Thumbnail style: soft, rings, lines, or pattern. Used by /thumbnail routes.' },
  { name: 'theme', type: 'query string', description: 'Thumbnail theme: purple, blue, green, orange, or dark. Used by /thumbnail routes.' },
  { name: 'label', type: 'query string', description: 'Short category pill for thumbnail routes, such as Blog Post, Guide, Tutorial, or Performance.' },
  { name: 'accent', type: 'query hex', description: 'Optional thumbnail accent color without the # prefix.' },
  { name: 'extension', type: 'path suffix', description: 'Optional route suffix: .svg, .png, .jpg, .jpeg, or .webp. SVG is the default when omitted.' },
];

const headers = [
  { name: 'Content-Type', value: 'image/svg+xml, image/png, image/jpeg, or image/webp', detail: 'The response MIME type matches the requested output suffix. Routes without a suffix return SVG.' },
  { name: 'Cache-Control', value: 'public, max-age=31536000, immutable', detail: 'Deterministic URLs are designed for long-lived CDN caching.' },
  { name: 'CDN-Cache-Control', value: 'max-age=31536000', detail: 'Cloudflare can cache deterministic image responses close to users.' },
  { name: 'Access-Control-Allow-Origin', value: '*', detail: 'Generated fallbacks can be used from browser, server, email, and native surfaces.' },
  { name: 'X-Content-Type-Options', value: 'nosniff', detail: 'The worker declares image content explicitly for generated image responses.' },
];

const errorRows = [
  { request: 'POST /api/v1/400x300', response: '405 Method not allowed', detail: 'The public image API is read-only and supports GET plus OPTIONS preflight.' },
  { request: 'GET /api/v1/not-a-size', response: '400 Invalid dimensions format', detail: 'Unknown API image paths return an API error, not homepage HTML.' },
  { request: 'GET /api/v1/0x300', response: '400 Invalid dimensions', detail: 'Dimensions must be positive and within the documented range.' },
];

const htmlExample = `<img
  src="${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image"
  width="800"
  height="450"
  alt="Product image fallback"
/>`;

const cssExample = `.product-card::before {
  background-image: url("${baseUrl}/600x400/F4F4F5/52525B?text=Loading");
}`;

const jsExample = `export function fallbackImage(width, height, label) {
  const params = new URLSearchParams({ text: label });
  return "${baseUrl}/" + width + "x" + height + "?" + params;
}`;

const reactExample = `export function ProductImageFallback() {
  return (
    <img
      src="${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image"
      width={800}
      height={450}
      alt="Product image fallback"
    />
  );
}`;

const thumbnailExample = `export function BlogFeaturedImage() {
  const src = "${baseUrl}/thumbnail/1200x630?text=How+to+Fix+Broken+Images&style=soft&theme=purple&label=Guide";

  return <img src={src} width={1200} height={630} alt="Blog featured image" />;
}`;
---

<DocsLayout
  title="API Reference | fallback.pics"
  description="Production API reference for fallback.pics fallback image infrastructure, including URL routes, output formats, parameters, headers, and framework examples."
>
  <div class="api-page">
    <section class="api-hero" id="base-url">
      <div>
        <p class="api-eyebrow">API Reference</p>
        <h1>Fallback images generated from predictable URLs.</h1>
        <p>
          Use one cacheable endpoint for product images, avatars, loading states, charts, and broken-image recovery. No SDK or authentication required for public routes.
        </p>
      </div>
      <div class="api-hero__panel">
        <span>Base URL</span>
        <code>{baseUrl}</code>
      </div>
    </section>

    <div class="api-grid">
      <aside class="api-sidebar" aria-label="API navigation">
        <span>Reference</span>
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </aside>

      <article class="api-content">
        <section id="routes" class="api-section">
          <div class="api-section__header">
            <p>Routes</p>
            <h2>Purpose-built endpoints for common image states.</h2>
          </div>
          <div class="api-route-grid">
            {routes.map((route) => (
              <a href={`${baseUrl}${route.path}`} target="_blank" rel="noreferrer" class="api-route-card">
                <div class="api-route-card__media">
                  <img src={route.image} alt={`${route.title} preview`} loading="lazy" />
                </div>
                <div>
                  <h3>{route.title}</h3>
                  <code>{route.path}</code>
                  <p>{route.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section id="parameters" class="api-section">
          <div class="api-section__header">
            <p>Parameters</p>
            <h2>Small surface area, explicit behavior.</h2>
          </div>
          <div class="api-table-wrap">
            <table class="api-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Type</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                {parameters.map((param) => (
                  <tr>
                    <td><code>{param.name}</code></td>
                    <td>{param.type}</td>
                    <td>{param.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="api-callout">
            <strong>Format note:</strong>
            Routes without a suffix return SVG. Add <code>.png</code>, <code>.jpg</code>, <code>.jpeg</code>, or <code>.webp</code> to receive raster output encoded by the Cloudflare Images binding.
          </div>
        </section>

        <section id="examples" class="api-section">
          <div class="api-section__header">
            <p>Code Examples</p>
            <h2>Use the API anywhere an image URL is accepted.</h2>
          </div>
          <div class="api-code-grid">
            <CodeBlock label="HTML" language="html" code={htmlExample} />
            <CodeBlock label="CSS" language="css" code={cssExample} />
            <CodeBlock label="JavaScript" language="ts" code={jsExample} />
            <CodeBlock label="React" language="tsx" code={reactExample} />
            <CodeBlock label="Thumbnail" language="tsx" code={thumbnailExample} />
          </div>
        </section>

        <section id="headers" class="api-section">
          <div class="api-section__header">
            <p>Headers</p>
            <h2>Optimized for repeated production delivery.</h2>
          </div>
          <div class="api-header-grid">
            {headers.map((header) => (
              <div>
                <h3>{header.name}</h3>
                <code>{header.value}</code>
                <p>{header.detail}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="errors" class="api-section">
          <div class="api-section__header">
            <p>Errors</p>
            <h2>Invalid API requests return API errors, not web pages.</h2>
          </div>
          <div class="api-table-wrap">
            <table class="api-table">
              <thead>
                <tr>
                  <th>Request</th>
                  <th>Response</th>
                  <th>Detail</th>
                </tr>
              </thead>
              <tbody>
                {errorRows.map((row) => (
                  <tr>
                    <td><code>{row.request}</code></td>
                    <td>{row.response}</td>
                    <td>{row.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="api-callout">
            <strong>Privacy note:</strong>
            Image delivery does not require cookies, authentication, or a client SDK. Avoid placing secrets, tokens, or regulated customer data in URL text parameters because URLs may appear in logs.
          </div>
        </section>

        <section id="limits" class="api-section">
          <div class="api-section__header">
            <p>Usage Limits</p>
            <h2>Bounded inputs for predictable edge rendering.</h2>
          </div>
          <div class="api-header-grid">
            <div>
              <h3>Dimensions</h3>
              <code>1px-5000px</code>
              <p>Requests outside the supported range return a 400 response instead of generating an oversized asset.</p>
            </div>
            <div>
              <h3>Output</h3>
              <code>SVG, PNG, JPEG, WebP</code>
              <p>The default response is SVG. Raster suffixes return the matching image MIME type for clients that require bitmap assets.</p>
            </div>
            <div>
              <h3>Cache policy</h3>
              <code>immutable</code>
              <p>Deterministic URLs are safe for long-lived CDN and browser caching across repeated product states.</p>
            </div>
          </div>
          <div class="api-final-cta">
            <div>
              <h2>Ready to ship image fallbacks?</h2>
              <p>Start with public URL routes. Higher-volume usage, custom domains, and SLA terms can be handled through a separate enterprise agreement.</p>
            </div>
            <a href="/docs/">Read the Docs</a>
          </div>
        </section>
      </article>
    </div>
  </div>
</DocsLayout>

<style>
  .api-page {
    width: min(100% - 2rem, 80rem);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .api-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.48fr);
    gap: 2rem;
    align-items: end;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 3rem;
  }

  .api-eyebrow,
  .api-section__header p,
  .api-sidebar span {
    margin: 0;
    color: var(--color-brand-hover);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .api-hero h1 {
    max-width: 56rem;
    margin: 1rem 0 0;
    color: var(--color-text);
    font-size: clamp(2.75rem, 6vw, 5.75rem);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .api-hero p:not(.api-eyebrow) {
    max-width: 45rem;
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .api-hero__panel,
  .api-route-card,
  .api-table-wrap,
  .api-callout,
  .api-header-grid > div,
  .api-final-cta {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-inverse-text);
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }

  .api-hero__panel {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .api-hero__panel span {
    color: var(--color-text-soft);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .api-hero__panel code,
  .api-header-grid code {
    display: block;
    overflow-wrap: anywhere;
    border-radius: 0.5rem;
    background: var(--color-text);
    color: var(--color-code-accent);
    font-size: 0.9375rem;
    line-height: 1.6;
    padding: 1rem;
  }

  .api-grid {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    padding-top: 3rem;
  }

  .api-sidebar {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-inverse-text);
    padding: 0.75rem;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }

  .api-sidebar span {
    padding: 0.5rem 0.75rem 0.625rem;
  }

  .api-sidebar a {
    border-radius: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 650;
    padding: 0.625rem 0.75rem;
    text-decoration: none;
  }

  .api-sidebar a:hover {
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  .api-content {
    display: grid;
    gap: 4rem;
    min-width: 0;
  }

  .api-section {
    scroll-margin-top: 6rem;
  }

  .api-section__header {
    margin-bottom: 1.5rem;
  }

  .api-section__header h2,
  .api-final-cta h2 {
    margin: 0.625rem 0 0;
    color: var(--color-text);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .api-route-grid,
  .api-code-grid,
  .api-header-grid {
    display: grid;
    gap: 1rem;
  }

  .api-route-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .api-code-grid,
  .api-header-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .api-route-card {
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .api-route-card:hover {
    border-color: #c4b5fd;
    transform: translateY(-1px);
  }

  .api-route-card__media {
    display: grid;
    min-height: 12rem;
    place-items: center;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-muted);
    padding: 1rem;
  }

  .api-route-card img {
    width: 100%;
    max-height: 11rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    object-fit: contain;
  }

  .api-route-card > div:last-child,
  .api-callout,
  .api-header-grid > div {
    padding: 1.25rem;
  }

  .api-route-card h3,
  .api-header-grid h3 {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 700;
  }

  .api-route-card p,
  .api-header-grid p,
  .api-callout,
  .api-final-cta p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .api-route-card code {
    display: block;
    margin: 0.75rem 0;
    overflow-wrap: anywhere;
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .api-table-wrap {
    overflow-x: auto;
  }

  .api-table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
  }

  .api-table th,
  .api-table td {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem;
    text-align: left;
    vertical-align: top;
  }

  .api-table th {
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .api-table tr:last-child td {
    border-bottom: 0;
  }

  .api-table td {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .api-table code {
    color: var(--color-text);
    font-weight: 700;
  }

  .api-callout {
    margin-top: 1rem;
    border-color: #c4b5fd;
    background: #f5f3ff;
  }

  .api-callout strong {
    color: var(--color-brand-text-strong);
  }

  .api-final-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem;
    background: var(--color-text);
  }

  .api-final-cta h2 {
    color: var(--color-inverse-text);
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .api-final-cta p {
    margin: 0.75rem 0 0;
    color: var(--color-text-disabled);
  }

  .api-final-cta a {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: var(--color-inverse-text);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 800;
    padding: 0 1rem;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .api-hero,
    .api-grid,
    .api-route-grid {
      grid-template-columns: 1fr;
    }

    .api-sidebar {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .api-page {
      padding: 2.5rem 0 4rem;
    }

    .api-hero h1 {
      font-size: 2.75rem;
    }

    .api-final-cta {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
