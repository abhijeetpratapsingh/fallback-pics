---
import DocsLayout from '../layouts/DocsLayout.astro';
---

<DocsLayout title="Documentation">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Hero Section -->
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold bg-gradient-to-r from-purple-600 to-blue-500 bg-clip-text text-transparent mb-4">
        Documentation
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Everything you need to know about using Fallback.pics in your projects
      </p>
    </div>

    <!-- Quick Navigation -->
    <div class="mb-12">
      <div class="bg-gradient-to-r from-purple-50 to-blue-50 rounded-2xl p-6 border border-purple-100">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Quick Navigation</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <a href="#getting-started" class="flex items-center space-x-2 text-purple-600 hover:text-purple-700 font-medium">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Getting Started</span>
          </a>
          <a href="#examples" class="flex items-center space-x-2 text-purple-600 hover:text-purple-700 font-medium">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Examples</span>
          </a>
          <a href="#ai" class="flex items-center space-x-2 text-purple-600 hover:text-purple-700 font-medium">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>AI Generation</span>
          </a>
          <a href="#charts" class="flex items-center space-x-2 text-purple-600 hover:text-purple-700 font-medium">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Charts</span>
          </a>
        </div>
      </div>
    </div>
    
    <div class="space-y-16">
      
      <!-- Getting Started Section -->
      <section id="getting-started" class="scroll-mt-8">
        <div class="flex items-center mb-6">
          <div class="bg-gradient-to-r from-purple-500 to-blue-500 text-white rounded-lg p-3 mr-4">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-gray-900">Getting Started</h2>
        </div>
        
        <div class="bg-white rounded-xl shadow-lg p-8 border border-gray-100">
          <p class="text-gray-600 mb-6">
            Fallback.pics is a lightning-fast placeholder image service that requires zero setup. 
            Simply use our URLs directly in your HTML, and we'll generate images on-demand.
          </p>
          
          <div class="bg-gradient-to-r from-gray-900 to-gray-800 rounded-xl p-6 mb-6">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-semibold text-green-400 uppercase tracking-wider">HTML</span>
              <button class="text-gray-400 hover:text-white transition-colors" title="Copy to clipboard">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
            </div>
            <code class="text-green-400 font-mono text-sm">
              &lt;img src="https://fallback.pics/api/v1/400x300" alt="Placeholder"&gt;
            </code>
          </div>
          
          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-sm font-semibold text-gray-700 mb-2">Result:</p>
            <img src="https://fallback.pics/api/v1/400x300" alt="Basic placeholder example" class="rounded-lg shadow-md" />
          </div>
        </div>
      </section>

      <!-- Basic Examples Section -->
      <section id="examples" class="scroll-mt-8">
        <div class="flex items-center mb-6">
          <div class="bg-gradient-to-r from-green-500 to-teal-500 text-white rounded-lg p-3 mr-4">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-gray-900">Basic Examples</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 p-4">
              <h3 class="font-semibold text-white">Basic Rectangle</h3>
            </div>
            <div class="p-6">
              <div class="bg-gray-900 rounded-lg p-3 mb-4">
                <code class="text-blue-400 font-mono text-xs">/600x400</code>
              </div>
              <img src="https://fallback.pics/api/v1/600x400" alt="Rectangle" class="rounded-lg shadow-sm w-full" />
            </div>
          </div>
          
          <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow">
            <div class="bg-gradient-to-r from-purple-500 to-purple-600 p-4">
              <h3 class="font-semibold text-white">Custom Colors</h3>
            </div>
            <div class="p-6">
              <div class="bg-gray-900 rounded-lg p-3 mb-4">
                <code class="text-purple-400 font-mono text-xs">/400x300/3B82F6/FFFFFF</code>
              </div>
              <img src="https://fallback.pics/api/v1/400x300/3B82F6/FFFFFF" alt="Custom colors" class="rounded-lg shadow-sm w-full" />
            </div>
          </div>
          
          <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow">
            <div class="bg-gradient-to-r from-green-500 to-green-600 p-4">
              <h3 class="font-semibold text-white">Custom Text</h3>
            </div>
            <div class="p-6">
              <div class="bg-gray-900 rounded-lg p-3 mb-4">
                <code class="text-green-400 font-mono text-xs">/400x300?text=Product+Image</code>
              </div>
              <img src="https://fallback.pics/api/v1/400x300?text=Product+Image" alt="Custom text" class="rounded-lg shadow-sm w-full" />
            </div>
          </div>
          
          <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-shadow">
            <div class="bg-gradient-to-r from-pink-500 to-pink-600 p-4">
              <h3 class="font-semibold text-white">Avatar</h3>
            </div>
            <div class="p-6">
              <div class="bg-gray-900 rounded-lg p-3 mb-4">
                <code class="text-pink-400 font-mono text-xs">/avatar/100?text=JD</code>
              </div>
              <div class="flex justify-center">
                <img src="https://fallback.pics/api/v1/avatar/100?text=JD" alt="Avatar" class="rounded-full shadow-lg" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Color Options Section -->
      <section id="color-options" class="scroll-mt-8">
        <div class="flex items-center mb-6">
          <div class="bg-gradient-to-r from-yellow-500 to-orange-500 text-white rounded-lg p-3 mr-4">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-gray-900">Color Options</h2>
        </div>
        
        <div class="bg-gradient-to-r from-blue-50 to-purple-50 border-l-4 border-purple-500 p-6 mb-8 rounded-r-xl">
          <div class="flex">
            <svg class="h-6 w-6 text-purple-500 mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            <div>
              <p class="text-purple-900 font-semibold mb-1">Pro Tip</p>
              <p class="text-purple-700">
                Colors can be customized using path segments or query parameters. Hex codes should be provided without the # symbol.
              </p>
            </div>
          </div>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-6">
            <h3 class="font-bold text-gray-900 mb-4 flex items-center">
              <span class="bg-purple-100 text-purple-600 rounded-lg p-2 mr-3">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
              </span>
              Path-based Colors
            </h3>
            <div class="bg-gray-900 rounded-lg p-3 mb-4">
              <code class="text-orange-400 font-mono text-xs">/400x300/FF6B6B/FFFFFF</code>
            </div>
            <img src="https://fallback.pics/api/v1/400x300/FF6B6B/FFFFFF" alt="Path colors" class="rounded-lg shadow-sm w-full mb-3" />
            <p class="text-sm text-gray-600 bg-gray-50 rounded-lg p-3">
              <strong>Format:</strong> /width×height/bgColor/textColor
            </p>
          </div>
          
          <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-6">
            <h3 class="font-bold text-gray-900 mb-4 flex items-center">
              <span class="bg-green-100 text-green-600 rounded-lg p-2 mr-3">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
                </svg>
              </span>
              Query Parameter Colors
            </h3>
            <div class="bg-gray-900 rounded-lg p-3 mb-4">
              <code class="text-teal-400 font-mono text-xs">/400x300?bg=4ECDC4&textcolor=000000</code>
            </div>
            <img src="https://fallback.pics/api/v1/400x300?bg=4ECDC4&textcolor=000000" alt="Query colors" class="rounded-lg shadow-sm w-full mb-3" />
            <p class="text-sm text-gray-600 bg-gray-50 rounded-lg p-3">
              <strong>Params:</strong> bg, bgcolor, textcolor, text_color
            </p>
          </div>
        </div>
      </section>

      <!-- AI-Powered Generation Section -->
      <section id="ai" class="scroll-mt-8">
        <div class="flex items-center mb-6">
          <div class="bg-gradient-to-r from-indigo-500 to-purple-500 text-white rounded-lg p-3 mr-4">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-gray-900">AI-Powered Generation</h2>
          <span class="ml-3 inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gradient-to-r from-indigo-500 to-purple-500 text-white">
            EXCLUSIVE
          </span>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            { context: 'e-commerce', mood: 'energetic', color: 'from-pink-500 to-rose-500' },
            { context: 'tech', mood: 'calm', color: 'from-blue-500 to-cyan-500' },
            { context: 'healthcare', mood: 'professional', color: 'from-green-500 to-emerald-500' },
            { context: 'fashion', mood: 'vibrant', color: 'from-purple-500 to-pink-500' },
            { context: 'finance', mood: 'corporate', color: 'from-gray-600 to-gray-800' },
            { context: 'food', mood: 'warm', color: 'from-orange-500 to-red-500' }
          ].map(item => (
            <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-all hover:-translate-y-1">
              <div class={`bg-gradient-to-r ${item.color} p-4`}>
                <h3 class="font-semibold text-white capitalize">{item.context}</h3>
                <span class="text-xs text-white/80">Mood: {item.mood}</span>
              </div>
              <div class="p-4">
                <div class="bg-gray-900 rounded-lg p-2 mb-3">
                  <code class="text-cyan-400 font-mono text-xs">
                    /ai/400x300?context={item.context}&mood={item.mood}
                  </code>
                </div>
                <img 
                  src={`https://fallback.pics/api/v1/ai/400x300?context=${item.context}&mood=${item.mood}`} 
                  alt={`${item.context} AI`} 
                  class="rounded-lg shadow-sm w-full" 
                />
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Animated Placeholders Section -->
      <section id="animations" class="scroll-mt-8">
        <div class="flex items-center mb-6">
          <div class="bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-lg p-3 mr-4">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-gray-900">Animated Placeholders</h2>
          <span class="ml-3 inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gradient-to-r from-purple-500 to-pink-500 text-white">
            CSS ONLY
          </span>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          {['skeleton', 'pulse', 'wave', 'shimmer', 'gradient', 'dots'].map((type, index) => (
            <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden group hover:shadow-xl transition-all">
              <div class="bg-gradient-to-r from-purple-500 to-pink-500 p-3">
                <h3 class="font-semibold text-white capitalize">{type}</h3>
              </div>
              <div class="p-4">
                <div class="bg-gray-900 rounded-lg p-2 mb-3">
                  <code class="text-pink-400 font-mono text-xs">
                    /animated/{type}/300x200
                  </code>
                </div>
                <div class="relative overflow-hidden rounded-lg">
                  <img 
                    src={`https://fallback.pics/api/v1/animated/${type}/300x200`} 
                    alt={type} 
                    class="w-full group-hover:scale-105 transition-transform duration-300" 
                  />
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Chart Mockups Section -->
      <section id="charts" class="scroll-mt-8">
        <div class="flex items-center mb-6">
          <div class="bg-gradient-to-r from-blue-500 to-indigo-500 text-white rounded-lg p-3 mr-4">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-gray-900">Chart Mockups</h2>
          <span class="ml-3 inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gradient-to-r from-blue-500 to-indigo-500 text-white">
            DATA VIZ
          </span>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {[
            { type: 'bar', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
            { type: 'pie', icon: 'M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z' },
            { type: 'line', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
            { type: 'area', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
            { type: 'donut', icon: 'M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z' },
            { type: 'scatter', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' }
          ].map(chart => (
            <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-xl transition-all">
              <div class="bg-gradient-to-r from-blue-500 to-indigo-500 p-4 flex items-center justify-between">
                <h3 class="font-semibold text-white capitalize">{chart.type} Chart</h3>
                <svg class="h-5 w-5 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={chart.icon} />
                </svg>
              </div>
              <div class="p-6">
                <div class="bg-gray-900 rounded-lg p-3 mb-4">
                  <code class="text-blue-400 font-mono text-xs">
                    /chart/{chart.type}/600x400
                  </code>
                </div>
                <img 
                  src={`https://fallback.pics/api/v1/chart/${chart.type}/600x400`} 
                  alt={`${chart.type} Chart`} 
                  class="rounded-lg shadow-sm w-full" 
                />
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- API Reference -->
      <section id="api-reference" class="scroll-mt-8">
        <div class="flex items-center mb-6">
          <div class="bg-gradient-to-r from-gray-700 to-gray-900 text-white rounded-lg p-3 mr-4">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-gray-900">API Reference</h2>
        </div>
        
        <div class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden">
          <div class="bg-gradient-to-r from-gray-700 to-gray-900 p-6">
            <h3 class="text-xl font-bold text-white mb-2">Base URL</h3>
            <code class="text-green-400 font-mono">https://fallback.pics/api/v1</code>
          </div>
          
          <div class="p-6 space-y-6">
            <div class="border-l-4 border-purple-500 pl-6">
              <h4 class="font-bold text-gray-900 mb-2">Basic Image</h4>
              <code class="text-sm text-gray-600 font-mono bg-gray-50 px-2 py-1 rounded">
                GET /&#123;width&#125;x&#123;height&#125;[.&#123;format&#125;]
