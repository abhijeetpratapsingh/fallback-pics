---
import DocsLayout from '../layouts/DocsLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';

const baseUrl = 'https://fallback.pics/api/v1';
const canonical = 'https://fallback.pics/docs/';

const sideNav = [
  { href: '#quickstart', label: 'Quickstart' },
  { href: '#how-it-works', label: 'How it works' },
  { href: '#url-anatomy', label: 'URL anatomy' },
  { href: '#parameters', label: 'Parameters' },
  { href: '#presets', label: 'Presets' },
  { href: '#use-cases', label: 'Use cases' },
  { href: '#frameworks', label: 'Framework examples' },
  { href: '#production', label: 'Production notes' },
  { href: '#guides', label: 'Guides' },
  { href: '#faq', label: 'FAQ' },
];

const workflowSteps = [
  {
    title: 'Pick a surface',
    body: 'Choose the image slot you need to stabilize: product card, avatar, docs thumbnail, loading state, or broken-image recovery.',
  },
  {
    title: 'Build the URL',
    body: 'Start with /api/v1, add dimensions or a preset route, then optional colors, labels, and thumbnail options.',
  },
  {
    title: 'Ship the fallback',
    body: 'Paste the URL into HTML, React, Next.js, CSS, CMS fields, or onerror handlers. Responses cache at the edge.',
  },
];

const endpointExamples = [
  {
    title: 'Blog thumbnail',
    path: '/api/v1/thumbnail/1200x630?text=How+to+Fix+Broken+Images&label=Guide',
    url: `${baseUrl}/thumbnail/1200x630?text=How+to+Fix+Broken+Images&label=Guide`,
    description: 'Featured-image style thumbnail with safe-zone background decoration.',
  },
  {
    title: 'Product fallback',
    path: '/api/v1/800x450/18181B/FFFFFF?text=Product+Image',
    url: `${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image`,
    description: 'Brand-safe colors and readable copy for catalog or card layouts.',
  },
  {
    title: 'Avatar initials',
    path: '/api/v1/avatar/160?text=AP',
    url: `${baseUrl}/avatar/160?text=AP`,
    description: 'Compact circular avatars for users, teams, and organizations.',
  },
  {
    title: 'Skeleton loader',
    path: '/api/v1/animated/skeleton/640x360',
    url: `${baseUrl}/animated/skeleton/640x360`,
    description: 'Motion placeholder that preserves layout while media loads.',
  },
  {
    title: 'Chart placeholder',
    path: '/api/v1/chart/line/800x500',
    url: `${baseUrl}/chart/line/800x500`,
    description: 'Deterministic chart art for dashboards, reports, and app previews.',
  },
  {
    title: 'Gradient placeholder',
    path: '/api/v1/gradient/800x450',
    url: `${baseUrl}/gradient/800x450`,
    description: 'Static brand gradient for image slots that need a polished fallback.',
  },
];

const urlPatterns = [
  { pattern: '/api/v1/{width}x{height}', example: '/api/v1/640x360', note: 'Default SVG placeholder' },
  { pattern: '/api/v1/{width}x{height}/{bg}/{fg}?text={label}', example: '/api/v1/800x450/18181B/FFFFFF?text=Product+Image', note: 'Branded fallback copy' },
  { pattern: '/api/v1/avatar/{size}?text={initials}', example: '/api/v1/avatar/128?text=JD', note: 'Profile and team avatars' },
  { pattern: '/api/v1/thumbnail/{w}x{h}?text=...&label=...', example: '/api/v1/thumbnail/1200x630?text=Article+Title&label=Guide', note: 'Blog and OG thumbnails' },
  { pattern: '/api/v1/animated/{type}/{w}x{h}', example: '/api/v1/animated/skeleton/640x360', note: 'Loading animations' },
  { pattern: '/api/v1/chart/{type}/{w}x{h}', example: '/api/v1/chart/bar/800x500', note: 'Dashboard chart placeholders' },
  { pattern: '/api/v1/gradient/{w}x{h}', example: '/api/v1/gradient/800x450', note: 'Static brand gradients' },
];

const parameters = [
  { name: 'width', type: 'path number', detail: 'Image width in pixels. Public routes support 10–4000px.' },
  { name: 'height', type: 'path number', detail: 'Image height in pixels. Avatar and square presets derive height from width.' },
  { name: 'bg / bgColor', type: 'path or query hex', detail: 'Background color without the # prefix.' },
  { name: 'fg / textColor', type: 'path or query hex', detail: 'Foreground or label color without the # prefix.' },
  { name: 'text', type: 'query string', detail: 'URL-encoded label shown inside supported presets.' },
  { name: 'style', type: 'query string', detail: 'Thumbnail decoration: soft, rings, lines, or pattern.' },
  { name: 'theme', type: 'query string', detail: 'Thumbnail palette: purple, blue, green, orange, or dark.' },
  { name: 'label', type: 'query string', detail: 'Short category pill on thumbnail routes, such as Guide or Blog Post.' },
  { name: 'type', type: 'path string', detail: 'Animation or chart variant, depending on route.' },
  { name: 'extension', type: 'path suffix', detail: 'Optional .svg, .png, .jpg, .jpeg, or .webp for raster output.' },
];

const presets = [
  { name: 'standard', route: '/api/v1/800x450?text=Product+Image', url: `${baseUrl}/800x450?text=Product+Image`, use: 'General placeholders, cards, and missing media states' },
  { name: 'thumbnail', route: '/api/v1/thumbnail/1200x630?text=Blog+Post+Title&style=soft&label=Guide', url: `${baseUrl}/thumbnail/1200x630?text=Blog+Post+Title&style=soft&label=Guide`, use: 'Blog featured images, CMS fallbacks, Open Graph thumbnails' },
  { name: 'avatar', route: '/api/v1/avatar/128?text=JD', url: `${baseUrl}/avatar/128?text=JD`, use: 'Initials for people, teams, and organizations' },
  { name: 'square', route: '/api/v1/square/400?text=Tile', url: `${baseUrl}/square/400?text=Tile`, use: 'Square catalog tiles and grid layouts' },
  { name: 'banner', route: '/api/v1/banner/1200x400?text=Campaign', url: `${baseUrl}/banner/1200x400?text=Campaign`, use: 'Hero banners, docs headers, and marketing previews' },
  { name: 'skeleton', route: '/api/v1/skeleton/640x360', url: `${baseUrl}/skeleton/640x360`, use: 'Static skeleton blocks that preserve dimensions' },
  { name: 'animated', route: '/api/v1/animated/skeleton/640x360', url: `${baseUrl}/animated/skeleton/640x360`, use: 'Shimmer, pulse, wave, and other loading motion' },
  { name: 'blur', route: '/api/v1/blur/800x450', url: `${baseUrl}/blur/800x450`, use: 'Soft blurred placeholders before real media arrives' },
  { name: 'chart', route: '/api/v1/chart/bar/800x500', url: `${baseUrl}/chart/bar/800x500`, use: 'Deterministic dashboard and report visualizations' },
  { name: 'gradient', route: '/api/v1/gradient/800x450', url: `${baseUrl}/gradient/800x450`, use: 'Static brand gradients for media and preview slots' },
  { name: 'pattern', route: '/api/v1/ai/800x450?context=saas&mood=minimal', url: `${baseUrl}/ai/800x450?context=saas&mood=minimal`, use: 'Deterministic decorative backgrounds with optional context' },
];

const useCases = [
  {
    title: 'Broken image recovery',
    body: 'Point onerror handlers to a deterministic fallback URL that matches slot dimensions and explains the missing state.',
    link: '/broken-image-fallback/',
    linkLabel: 'Broken image fallback guide',
  },
  {
    title: 'Ecommerce catalogs',
    body: 'Reserve product card space with square or dimensioned placeholders while vendor media is missing or delayed.',
    link: '/product-image-placeholder/',
    linkLabel: 'Product image placeholder',
  },
  {
    title: 'Docs and blogs',
    body: 'Generate readable featured images and OG-safe thumbnails from titles without maintaining a design asset pipeline.',
    link: '/blog/generate-blog-thumbnails-from-text/',
    linkLabel: 'Generate blog thumbnails from text',
  },
  {
    title: 'App loading states',
    body: 'Use skeleton and animated routes to keep dashboards and feeds stable while async images resolve.',
    link: '/skeleton-placeholder-generator/',
    linkLabel: 'Skeleton placeholder guide',
  },
];

const guides = [
  { href: '/guides/react-image-fallback/', label: 'React image fallback' },
  { href: '/guides/nextjs-image-fallback/', label: 'Next.js image fallback' },
  { href: '/guides/img-onerror-fallback/', label: 'HTML onerror fallback' },
  { href: '/blog/placeholder-image-api-url-syntax-guide/', label: 'URL syntax deep dive' },
  { href: '/api/', label: 'Full API reference' },
  { href: '/placeholder-image-generator/', label: 'Interactive generator' },
];

const faqs = [
  {
    question: 'Do I need to install a package?',
    answer: 'No. fallback.pics is URL-based. Any surface that accepts an image URL can use /api/v1 routes directly.',
  },
  {
    question: 'What should my first URL look like?',
    answer: 'Start with https://fallback.pics/api/v1/800x450?text=Product+Image, then adjust dimensions, colors, and preset routes to match your UI.',
  },
  {
    question: 'When should I use a preset instead of width x height?',
    answer: 'Use presets when the output shape is specialized: avatar for initials, thumbnail for blog art, skeleton for loaders, chart for report previews, gradient for branded media slots, or banner for wide hero slots.',
  },
  {
    question: 'Where is the difference between docs and API reference?',
    answer: 'This page explains how to adopt fallback.pics in products and frameworks. The API reference lists routes, headers, limits, and error behavior in full.',
  },
];

const curlExample = `curl -I "${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image"`;

const htmlExample = `<img
  src="${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image"
  width="800"
  height="450"
  alt="Product image fallback"
/>`;

const onErrorExample = `<img
  src="/media/product-4821.jpg"
  width="640"
  height="640"
  alt="Product image"
  onerror="this.onerror=null;this.src='${baseUrl}/640x640?text=Product+Image'"
/>`;

const reactExample = `export function ProductFallback() {
  const src = "${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image";

  return <img src={src} width={800} height={450} alt="Product image fallback" />;
}`;

const nextExample = `import Image from "next/image";

export function ProductFallback() {
  return (
    <Image
      src="${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image"
      width={800}
      height={450}
      alt="Product image fallback"
      unoptimized
    />
  );
}`;

const thumbnailExample = `<img
  src="${baseUrl}/thumbnail/1200x630?text=How+to+Fix+Broken+Images&style=soft&label=Guide"
  width="1200"
  height="630"
  alt="How to Fix Broken Images featured image"
/>`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'fallback.pics Documentation — Placeholder Image API Guide',
  description:
    'Learn how to add deterministic fallback images to production apps with fallback.pics URL routes, presets, framework examples, and operational guidance.',
  url: canonical,
  author: { '@type': 'Organization', name: 'fallback.pics' },
};
---

<DocsLayout
  title="Placeholder Image API Documentation | fallback.pics"
  description="Learn how to use fallback.pics in production: quickstart examples, URL anatomy, presets, framework snippets, caching guidance, and links to the full API reference."
  keywords="fallback image documentation, placeholder image api docs, image fallback guide, broken image fallback, react image fallback, nextjs placeholder image"
  canonical={canonical}
  ogImage={`${baseUrl}/thumbnail/1200x630?text=Documentation&style=soft&label=Guide`}
>
  <div class="docs-page">
    <section class="docs-hero" id="overview">
      <div>
        <p class="docs-eyebrow">Documentation</p>
        <h1>Ship reliable image fallbacks without an SDK.</h1>
        <p>
          fallback.pics is a URL-based placeholder image service for production applications. Generate deterministic SVG and raster fallbacks for product grids, avatars, docs thumbnails, loading states, and broken-image recovery—then cache them like static assets.
        </p>
        <div class="docs-hero__actions">
          <a class="docs-hero__cta" href="/placeholder-image-generator/">Open generator</a>
          <a class="docs-hero__link" href="/api/">API reference</a>
          <a class="docs-hero__link" href="/guides/react-image-fallback/">React guide</a>
        </div>
      </div>
      <div class="docs-hero__panel">
        <span>Base URL</span>
        <code>{baseUrl}</code>
        <p class="docs-hero__panel-note">All public routes use this prefix. No API key required.</p>
      </div>
    </section>

    <div class="docs-grid">
      <aside class="docs-sidebar" aria-label="Documentation navigation">
        <span>On this page</span>
        {sideNav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </aside>

      <article class="docs-content">
        <section id="quickstart" class="docs-section">
          <div class="docs-section__header">
            <p>Quickstart</p>
            <h2>Replace a missing image in one URL.</h2>
          </div>
          <p class="docs-lead">
            Paste a fallback.pics URL anywhere an image source is accepted. Verify the response with curl, then copy the same URL into your app or CMS.
          </p>
          <CodeBlock label="curl" language="bash" code={curlExample} />
          <CodeBlock label="HTML image tag" language="html" code={htmlExample} />
          <div class="docs-quick-grid">
            <a href={`${baseUrl}/800x450?text=Hello`} target="_blank" rel="noreferrer" class="docs-quick-card">
              <strong>Try a live image</strong>
              <code>/api/v1/800x450?text=Hello</code>
            </a>
            <a href="/placeholder-image-generator/" class="docs-quick-card">
              <strong>Build a custom URL</strong>
              <span>Interactive generator with all presets</span>
            </a>
            <a href="/api/" class="docs-quick-card">
              <strong>Full API reference</strong>
              <span>Routes, headers, limits, and errors</span>
            </a>
          </div>
          <div class="docs-preview-grid">
            {endpointExamples.map((example) => (
              <a href={example.url} target="_blank" rel="noreferrer" class="docs-example-card">
                <div class="docs-example-card__media">
                  <img src={example.url} alt={`${example.title} generated by fallback.pics`} loading="lazy" />
                </div>
                <div>
                  <h3>{example.title}</h3>
                  <code>{example.path}</code>
                  <p>{example.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section id="how-it-works" class="docs-section">
          <div class="docs-section__header">
            <p>How it works</p>
            <h2>Three steps from missing media to a stable UI.</h2>
          </div>
          <div class="docs-steps">
            {workflowSteps.map((step, index) => (
              <div class="docs-step-card">
                <span class="docs-step-card__index">{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="url-anatomy" class="docs-section">
          <div class="docs-section__header">
            <p>URL anatomy</p>
            <h2>Readable URLs you can review in PRs and logs.</h2>
          </div>
          <p class="docs-lead">
            Path segments define dimensions, preset type, and optional colors. Query parameters add labels and thumbnail options. Deterministic URLs are safe to cache for repeated UI states.
          </p>
          <CodeBlock
            label="Standard route"
            language="text"
            code={`${baseUrl}/[width]x[height]/[bgColor]/[textColor]?text=[label]`}
          />
          <CodeBlock
            label="Blog thumbnail route"
            language="text"
            code={`${baseUrl}/thumbnail/1200x630?text=[post-title]&style=soft&theme=purple&label=Guide`}
          />
          <div class="docs-table-wrap">
            <table class="docs-table">
              <thead>
                <tr>
                  <th>Pattern</th>
                  <th>Example</th>
                  <th>When to use</th>
                </tr>
              </thead>
              <tbody>
                {urlPatterns.map((row) => (
                  <tr>
                    <td><code>{row.pattern}</code></td>
                    <td><code>{row.example}</code></td>
                    <td>{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="docs-callout">
            <strong>Production tip:</strong>
            Match fallback dimensions to the final image slot and keep labels user-facing. Avoid putting secrets or regulated data in URL parameters.
          </div>
        </section>

        <section id="parameters" class="docs-section">
          <div class="docs-section__header">
            <p>Parameters</p>
            <h2>Small surface area, explicit behavior.</h2>
          </div>
          <div class="docs-table-wrap">
            <table class="docs-table">
              <thead>
                <tr>
                  <th>Parameter</th>
                  <th>Type</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                {parameters.map((param) => (
                  <tr>
                    <td><code>{param.name}</code></td>
                    <td>{param.type}</td>
                    <td>{param.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="presets" class="docs-section">
          <div class="docs-section__header">
            <p>Presets</p>
            <h2>Purpose-built routes for common product states.</h2>
          </div>
          <p class="docs-lead">
            Presets encode specialized layouts so you do not have to recreate avatar circles, thumbnail safe zones, or loader motion by hand.
          </p>
          <div class="docs-preset-grid">
            {presets.map((preset) => (
              <a href={preset.url} target="_blank" rel="noreferrer" class="docs-preset-card">
                <h3>{preset.name}</h3>
                <code>{preset.route}</code>
                <p>{preset.use}</p>
              </a>
            ))}
          </div>
        </section>

        <section id="use-cases" class="docs-section">
          <div class="docs-section__header">
            <p>Use cases</p>
            <h2>Where teams adopt fallback.pics first.</h2>
          </div>
          <div class="docs-use-grid">
            {useCases.map((item) => (
              <article class="docs-use-card">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <a href={item.link}>{item.linkLabel} →</a>
              </article>
            ))}
          </div>
        </section>

        <section id="frameworks" class="docs-section">
          <div class="docs-section__header">
            <p>Framework examples</p>
            <h2>Copy snippets into your stack.</h2>
          </div>
          <div class="docs-code-stack">
            <CodeBlock label="Broken image fallback" language="html" code={onErrorExample} />
            <CodeBlock label="React component" language="tsx" code={reactExample} />
            <CodeBlock label="Next.js Image" language="tsx" code={nextExample} />
            <CodeBlock label="Blog featured image" language="html" code={thumbnailExample} />
          </div>
        </section>

        <section id="production" class="docs-section">
          <div class="docs-section__header">
            <p>Production notes</p>
            <h2>Operational guidance for production teams.</h2>
          </div>
          <div class="docs-note-grid">
            <div>
              <h3>Caching</h3>
              <p>Prefer deterministic URLs and immutable cache headers for repeated UI states, product grids, emails, and preview surfaces.</p>
            </div>
            <div>
              <h3>Privacy</h3>
              <p>Image delivery does not require cookies, authentication, or a client SDK. Text parameters appear in URLs and logs, so do not place secrets, tokens, or regulated customer data in fallback image URLs.</p>
            </div>
            <div>
              <h3>Errors</h3>
              <p>Invalid dimensions and unknown image paths return explicit API errors—not homepage HTML—so monitoring can distinguish bad requests from site traffic.</p>
            </div>
            <div>
              <h3>Enterprise</h3>
              <p>Custom domains, support windows, and SLA commitments can be handled through an enterprise deployment agreement. <a href="mailto:support@fallback.pics?subject=Enterprise%20fallback.pics">Contact sales</a>.</p>
            </div>
          </div>
        </section>

        <section id="guides" class="docs-section">
          <div class="docs-section__header">
            <p>Guides</p>
            <h2>Go deeper by framework and workflow.</h2>
          </div>
          <div class="docs-guides-grid">
            {guides.map((guide) => (
              <a href={guide.href} class="docs-guide-link">{guide.label}</a>
            ))}
          </div>
        </section>

        <section id="faq" class="docs-section">
          <div class="docs-section__header">
            <p>FAQ</p>
            <h2>Common documentation questions.</h2>
          </div>
          <div class="docs-faq-list">
            {faqs.map((faq) => (
              <article class="docs-faq-item">
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </article>
            ))}
          </div>
        </section>

        <div class="docs-final-cta">
          <div>
            <h2>Ready to standardize image fallbacks?</h2>
            <p>Start with one URL in your highest-traffic image slot, then expand into presets, team conventions, and custom domains.</p>
          </div>
          <div class="docs-final-cta__actions">
            <a href="/placeholder-image-generator/">Open generator</a>
            <a href="/api/" class="docs-final-cta__secondary">View API reference</a>
          </div>
        </div>
      </article>
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</DocsLayout>

<style>
  .docs-page {
    width: min(100% - 2rem, 80rem);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .docs-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.48fr);
    gap: 2rem;
    align-items: end;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .docs-eyebrow,
  .docs-section__header p,
  .docs-sidebar span,
  .docs-step-card__index {
    margin: 0;
    color: var(--color-brand-hover);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .docs-hero h1 {
    max-width: 54rem;
    margin: 1rem 0 0;
    color: var(--color-text);
    font-size: clamp(2.35rem, 5vw, 4.25rem);
    font-weight: 650;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .docs-hero p:not(.docs-eyebrow):not(.docs-hero__panel-note) {
    max-width: 45rem;
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .docs-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .docs-hero__cta,
  .docs-final-cta a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: var(--color-brand);
    color: var(--color-inverse-text);
    font-size: 0.875rem;
    font-weight: 800;
    padding: 0 1rem;
    text-decoration: none;
  }

  .docs-hero__link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-inverse-text);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0 1rem;
    text-decoration: none;
  }

  .docs-hero__panel {
    display: grid;
    gap: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-inverse-text);
    padding: 1.25rem;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }

  .docs-hero__panel span {
    color: var(--color-text-soft);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .docs-hero__panel-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .docs-hero__panel code {
    display: block;
    overflow-wrap: anywhere;
    border-radius: 0.5rem;
    background: var(--color-text);
    color: var(--color-code-accent);
    font-size: 0.9375rem;
    line-height: 1.6;
    padding: 1rem;
  }

