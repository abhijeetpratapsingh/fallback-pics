---
import DocsLayout from '../layouts/DocsLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';

const baseUrl = 'https://fallback.pics/api/v1';

const sideNav = [
  { href: '#quickstart', label: 'Quickstart' },
  { href: '#url-anatomy', label: 'URL anatomy' },
  { href: '#parameters', label: 'Parameters' },
  { href: '#presets', label: 'Presets' },
  { href: '#frameworks', label: 'Framework examples' },
  { href: '#production', label: 'Production notes' },
  { href: '#trust', label: 'Trust signals' },
];

const endpointExamples = [
  {
    title: 'Basic fallback',
    path: '/640x360',
    description: 'Generate a deterministic image from dimensions alone.',
    image: `${baseUrl}/640x360`,
  },
  {
    title: 'Brand-safe media',
    path: '/800x450/18181B/FFFFFF?text=Product+Image',
    description: 'Control background, foreground, and visible label from the URL.',
    image: `${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image`,
  },
  {
    title: 'Avatar initials',
    path: '/avatar/160?text=AP',
    description: 'Use compact presets for user, team, and organization avatars.',
    image: `${baseUrl}/avatar/160?text=AP`,
  },
];

const parameters = [
  { name: 'width', type: 'number', detail: '1-5000px. Required for standard routes.' },
  { name: 'height', type: 'number', detail: '1-5000px. Omitted for avatar and square presets.' },
  { name: 'bgColor', type: 'path hex', detail: 'Optional path segment after dimensions, without the # prefix.' },
  { name: 'textColor', type: 'path hex', detail: 'Optional foreground path segment after background color, without the # prefix.' },
  { name: 'text', type: 'query', detail: 'Optional URL-encoded label rendered into the fallback.' },
];

const presets = [
  { name: 'avatar', route: '/avatar/128?text=JD', use: 'Initials, teams, people, organizations' },
  { name: 'banner', route: '/banner/1200x400?text=Campaign', use: 'Marketing cards, CMS hero images, social previews' },
  { name: 'skeleton', route: '/animated/skeleton/640x360', use: 'Loading states that preserve layout dimensions' },
  { name: 'blur', route: '/blur/640x360', use: 'Soft media placeholders before real images load' },
];

const htmlExample = `<img
  src="${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image"
  width="800"
  height="450"
  alt="Product image fallback"
/>`;

const reactExample = `export function ProductFallback() {
  const src = "${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image";

  return <img src={src} width={800} height={450} alt="Product image fallback" />;
}`;

const nextExample = `import Image from "next/image";

export function ProductFallback() {
  return (
    <Image
      src="${baseUrl}/800x450/18181B/FFFFFF?text=Product+Image"
      width={800}
      height={450}
      alt="Product image fallback"
      unoptimized
    />
  );
}`;
---

<DocsLayout
  title="Documentation | fallback.pics"
  description="Production documentation for fallback.pics, a URL-based fallback image infrastructure service for production applications."
>
  <div class="docs-page">
    <section class="docs-hero">
      <div>
        <p class="docs-eyebrow">Documentation</p>
        <h1>Fallback image infrastructure, one URL at a time.</h1>
        <p>
          Add deterministic, cacheable fallback images to production applications without an SDK, asset pipeline, or runtime image dependency.
        </p>
      </div>
      <div class="docs-hero__panel">
        <span>Base URL</span>
        <code>{baseUrl}</code>
      </div>
    </section>

    <div class="docs-grid">
      <aside class="docs-sidebar" aria-label="Documentation navigation">
        <span>Get started</span>
        {sideNav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </aside>

      <article class="docs-content">
        <section id="quickstart" class="docs-section">
          <div class="docs-section__header">
            <p>Quickstart</p>
            <h2>Replace a missing image with a generated fallback.</h2>
          </div>
          <CodeBlock label="HTML image tag" language="html" code={htmlExample} />
          <div class="docs-preview-grid">
            {endpointExamples.map((example) => (
              <div class="docs-example-card">
                <div class="docs-example-card__media">
                  <img src={example.image} alt={`${example.title} generated by fallback.pics`} loading="lazy" />
                </div>
                <div>
                  <h3>{example.title}</h3>
                  <code>{example.path}</code>
                  <p>{example.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section id="url-anatomy" class="docs-section">
          <div class="docs-section__header">
            <p>URL anatomy</p>
            <h2>Every fallback is readable, reviewable, and cacheable.</h2>
          </div>
          <CodeBlock
            label="Standard route"
            language="text"
            code={`${baseUrl}/[width]x[height]/[bgColor]/[textColor]?text=[label]`}
          />
          <div class="docs-callout">
            <strong>Production behavior:</strong>
            Deterministic URLs are designed for long-lived CDN caching. Use stable dimensions and labels in product surfaces where layout shift matters.
          </div>
        </section>

        <section id="parameters" class="docs-section">
          <div class="docs-section__header">
            <p>Parameters</p>
            <h2>Small surface area, explicit behavior.</h2>
          </div>
          <div class="docs-table-wrap">
            <table class="docs-table">
              <thead>
                <tr>
                  <th>Parameter</th>
                  <th>Type</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                {parameters.map((param) => (
                  <tr>
                    <td><code>{param.name}</code></td>
                    <td>{param.type}</td>
                    <td>{param.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="presets" class="docs-section">
          <div class="docs-section__header">
            <p>Presets</p>
            <h2>Purpose-built routes for common product states.</h2>
          </div>
          <div class="docs-preset-grid">
            {presets.map((preset) => (
              <div class="docs-preset-card">
                <h3>{preset.name}</h3>
                <code>{preset.route}</code>
                <p>{preset.use}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="frameworks" class="docs-section">
          <div class="docs-section__header">
            <p>Frameworks</p>
            <h2>Use it anywhere an image URL is accepted.</h2>
          </div>
          <div class="docs-code-stack">
            <CodeBlock label="React component" language="tsx" code={reactExample} />
            <CodeBlock label="Next.js Image" language="tsx" code={nextExample} />
          </div>
        </section>

        <section id="production" class="docs-section">
          <div class="docs-section__header">
            <p>Production notes</p>
            <h2>Operational guidance for production teams.</h2>
          </div>
          <div class="docs-note-grid">
            <div>
              <h3>Caching</h3>
              <p>Prefer deterministic URLs and immutable cache headers for repeated UI states, product grids, emails, and preview surfaces.</p>
            </div>
            <div>
              <h3>Privacy</h3>
              <p>Image delivery does not require cookies, authentication, or a client SDK. Text parameters appear in URLs and logs, so do not place secrets, tokens, or regulated customer data in fallback image URLs.</p>
            </div>
            <div>
              <h3>Enterprise</h3>
              <p>Custom domains, support windows, and SLA commitments can be handled through an enterprise deployment agreement.</p>
            </div>
          </div>
        </section>

        <section id="trust" class="docs-section">
          <div class="docs-section__header">
            <p>Trust signals</p>
            <h2>Response behavior you can verify before adoption.</h2>
          </div>
          <div class="docs-note-grid">
            <div>
              <h3>Headers</h3>
              <p>Valid image routes return <code>image/svg+xml</code>, immutable cache headers, CORS for browser use, and <code>X-Content-Type-Options: nosniff</code>.</p>
            </div>
            <div>
              <h3>API errors</h3>
              <p>Unsupported methods, invalid dimensions, and unknown image-like paths return explicit API errors rather than homepage HTML.</p>
            </div>
            <div>
              <h3>Useful links</h3>
              <p><a href="/api">API Reference</a>, <a href="/privacy">Privacy</a>, <a href="https://status.fallback.pics">Status</a>, and <a href="https://github.com/abhijeetpratapsingh/fallback-pics">GitHub</a> are the canonical trust surfaces.</p>
            </div>
          </div>
          <div class="docs-final-cta">
            <div>
              <h2>Ready to standardize image fallbacks?</h2>
              <p>Start with one URL, then expand into presets, custom domains, and team-wide conventions.</p>
            </div>
            <a href="/api">View API Reference</a>
          </div>
        </section>
      </article>
    </div>
  </div>
</DocsLayout>

<style>
  .docs-page {
    width: min(100% - 2rem, 80rem);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .docs-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.48fr);
    gap: 2rem;
    align-items: end;
    padding-bottom: 3rem;
    border-bottom: 1px solid #e4e4e7;
  }

  .docs-eyebrow,
  .docs-section__header p,
  .docs-sidebar span {
    margin: 0;
    color: #6d28d9;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .docs-hero h1 {
    max-width: 54rem;
    margin: 1rem 0 0;
    color: #18181b;
    font-size: clamp(2.35rem, 5vw, 5.4rem);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .docs-hero p:not(.docs-eyebrow) {
    max-width: 45rem;
    margin: 1.25rem 0 0;
    color: #52525b;
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .docs-hero__panel {
    display: grid;
    gap: 0.75rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #ffffff;
    padding: 1.25rem;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }

  .docs-hero__panel span {
    color: #71717a;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .docs-hero__panel code {
    display: block;
    overflow-wrap: anywhere;
    border-radius: 0.5rem;
    background: #18181b;
    color: #86efac;
    font-size: 0.9375rem;
    line-height: 1.6;
    padding: 1rem;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    padding-top: 3rem;
  }

  .docs-sidebar {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 0.25rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #ffffff;
    padding: 0.75rem;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }

  .docs-sidebar span {
    padding: 0.5rem 0.75rem 0.625rem;
  }

  .docs-sidebar a {
    border-radius: 0.5rem;
    color: #52525b;
    font-size: 0.875rem;
    font-weight: 650;
    padding: 0.625rem 0.75rem;
    text-decoration: none;
  }

  .docs-sidebar a:hover {
    background: #f4f4f5;
    color: #18181b;
  }

  .docs-content {
    display: grid;
    gap: 4rem;
    min-width: 0;
  }

  .docs-section {
    scroll-margin-top: 6rem;
  }

  .docs-section__header {
    margin-bottom: 1.5rem;
  }

  .docs-section__header h2,
  .docs-final-cta h2 {
    margin: 0.625rem 0 0;
    color: #18181b;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .docs-preview-grid,
  .docs-preset-grid,
  .docs-note-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .docs-preview-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .docs-example-card,
  .docs-preset-card,
  .docs-note-grid > div,
  .docs-final-cta,
  .docs-callout,
  .docs-table-wrap {
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #ffffff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }

  .docs-example-card {
    overflow: hidden;
  }

  .docs-example-card__media {
    display: grid;
    min-height: 11rem;
    place-items: center;
    border-bottom: 1px solid #e4e4e7;
    background: #f4f4f5;
    padding: 1rem;
  }

  .docs-example-card img {
    width: 100%;
    max-height: 10rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    object-fit: contain;
  }

  .docs-example-card > div:last-child,
  .docs-preset-card,
  .docs-note-grid > div,
  .docs-callout {
    padding: 1.25rem;
  }

  .docs-example-card h3,
  .docs-preset-card h3,
  .docs-note-grid h3 {
    margin: 0;
    color: #18181b;
    font-size: 1rem;
    font-weight: 700;
  }

  .docs-example-card p,
  .docs-preset-card p,
  .docs-note-grid p,
  .docs-final-cta p,
  .docs-callout {
    color: #52525b;
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .docs-example-card code,
  .docs-preset-card code {
    display: block;
    margin: 0.75rem 0;
    overflow-wrap: anywhere;
    color: #18181b;
    font-size: 0.8125rem;
  }

  .docs-callout {
    margin-top: 1rem;
    border-color: #c4b5fd;
    background: #f5f3ff;
  }

  .docs-callout strong {
    color: #4c1d95;
  }

  .docs-table-wrap {
    overflow-x: auto;
  }

  .docs-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 42rem;
  }

  .docs-table th,
  .docs-table td {
    border-bottom: 1px solid #e4e4e7;
    padding: 1rem;
    text-align: left;
    vertical-align: top;
  }

  .docs-table th {
    background: #f4f4f5;
    color: #52525b;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .docs-table tr:last-child td {
    border-bottom: 0;
  }

  .docs-table td {
    color: #52525b;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .docs-table code {
    color: #18181b;
    font-weight: 700;
  }

  .docs-preset-grid,
  .docs-note-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .docs-code-stack {
    display: grid;
    gap: 1rem;
  }

  .docs-final-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1rem;
    padding: 1.5rem;
    background: #18181b;
  }

  .docs-final-cta h2 {
    color: #ffffff;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .docs-final-cta p {
    margin: 0.75rem 0 0;
    color: #a1a1aa;
  }

  .docs-final-cta a {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: #ffffff;
    color: #18181b;
    font-size: 0.875rem;
    font-weight: 800;
    padding: 0 1rem;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .docs-hero,
    .docs-grid {
      grid-template-columns: 1fr;
    }

    .docs-sidebar {
      position: static;
    }

    .docs-preview-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .docs-page {
      padding: 2rem 0 4rem;
    }

    .docs-hero {
      gap: 1.25rem;
      padding-bottom: 1.5rem;
    }

    .docs-hero h1 {
      font-size: clamp(2rem, 10vw, 2.45rem);
      line-height: 1.04;
    }

    .docs-hero p:not(.docs-eyebrow) {
      margin-top: 1rem;
      font-size: 1rem;
      line-height: 1.65;
    }

    .docs-hero__panel {
      padding: 0.85rem;
    }

    .docs-preset-grid,
    .docs-note-grid {
      grid-template-columns: 1fr;
    }

    .docs-final-cta {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
