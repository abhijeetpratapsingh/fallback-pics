---
import ContentLayout from '../layouts/ContentLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import LiveDemoEnhanced from '../components/LiveDemoEnhanced.tsx';
import { seoPages } from '../data/seoPages';

const page = seoPages.find((entry) => entry.slug === 'placeholder-image-generator');

if (!page) {
  throw new Error('Missing placeholder-image-generator SEO page data');
}

const canonical = 'https://fallback.pics/placeholder-image-generator/';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.title,
  description: page.description,
  url: canonical,
  mainEntity: {
    '@type': 'SoftwareApplication',
    name: 'fallback.pics',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web Browser',
  },
  keywords: page.keywords,
};

function sectionId(heading: string) {
  return heading
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

function codeLanguage(code: string) {
  const trimmed = code.trim();
  if (trimmed.startsWith('<')) return 'html';
  if (trimmed.startsWith('http')) return 'text';
  return 'tsx';
}
---

<ContentLayout
  title={page.title}
  description={page.description}
  keywords={page.keywords.join(', ')}
  canonical={canonical}
  ogImage={`https://fallback.pics/api/v1/1200x630/7C3AED/FFFFFF?text=${encodeURIComponent(page.eyebrow)}`}
  eyebrow={page.eyebrow}
  heading={page.h1}
  intro={page.intro}
>
  <div slot="featured" id="generator">
    <LiveDemoEnhanced client:load embedded />
  </div>

  {page.sections.map((section) => (
    <section id={sectionId(section.heading)} class="content-section">
      <h2>{section.heading}</h2>
      {section.body.map((paragraph) => <p>{paragraph}</p>)}
      {section.bullets && (
        <ul class="content-bullet-grid">
          {section.bullets.map((item) => <li>{item}</li>)}
        </ul>
      )}
      {section.code && (
        <CodeBlock label={section.heading} language={codeLanguage(section.code)} code={section.code} />
      )}
    </section>
  ))}

  {page.examples?.length && (
    <section id="examples" class="content-section">
      <p class="content-section__eyebrow">Working examples</p>
      <h2>Copy-paste image URLs</h2>
      <div class="content-example-grid">
        {page.examples.map((example) => (
          <article class="content-example-card">
            <img src={example.url} alt={`${example.label} generated by fallback.pics`} loading="lazy" />
            <div>
              <h3>{example.label}</h3>
              <p>{example.description}</p>
              <code>{example.url}</code>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {page.faqs?.length && (
    <section id="faq" class="content-section">
      <p class="content-section__eyebrow">FAQ</p>
      <h2>Common questions</h2>
      <div class="content-faq-list">
        {page.faqs.map((faq) => (
          <article>
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <Fragment slot="sidebar">
    <div class="content-sidebar-card">
      <h2>Use this page for</h2>
      <ul>
        {page.keywords.map((keyword) => <li>{keyword}</li>)}
      </ul>
    </div>
    <div class="content-sidebar-card">
      <h2>Related pages</h2>
      <ul>
        {page.links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </Fragment>

  <Fragment slot="cta">
    <h2>{page.cta}</h2>
    <div class="content-cta__code">
      <code>{page.exampleUrl}</code>
    </div>
    <div class="content-cta__actions">
      <a class="content-cta__primary" href="#generator">Open generator</a>
      <a class="content-cta__secondary" href="/api/">View API reference</a>
    </div>
  </Fragment>

  <script is:inline slot="structured-data" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</ContentLayout>
