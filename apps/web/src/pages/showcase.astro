  item('Marketing', 'Blog cover placeholder', 'Blog Cover', '/1200x630/18181B/FFFFFF?text=Blog+Cover', '18181B', 'FFFFFF', 'wide'),
  item('Marketing', 'Blog thumbnail preset', 'Release Notes', '/thumbnail/1200x630?text=Release+Notes&style=soft&theme=purple', '7C3AED', 'FFFFFF', 'wide', true),
  item('Marketing', 'Open Graph image placeholder', 'Open Graph', '/1200x630/7C3AED/FFFFFF?text=Open+Graph', '7C3AED', 'FFFFFF', 'wide', true),
  item('Marketing', 'Case study cover', 'Case Study', '/1200x630/FFF7ED/C2410C?text=Case+Study', 'FFF7ED', 'C2410C', 'wide'),
  item('Marketing', 'Newsletter card visual', 'Newsletter', '/800x500/FDF2F8/BE185D?text=Newsletter', 'FDF2F8', 'BE185D', 'wide'),
  item('Marketing', 'Social share preview', 'Social Preview', '/1200x630/DBEAFE/1D4ED8?text=Social+Preview', 'DBEAFE', '1D4ED8', 'wide'),
  item('Marketing', 'Blur progressive reveal', 'Blur Preview', '/blur/800x450', 'F4F4F5', 'A1A1AA', 'wide'),

  item('Docs', 'Docs article thumbnail', 'Docs Preview', '/800x450/F5F3FF/6D28D9?text=Docs+Preview', 'F5F3FF', '6D28D9', 'wide'),
  item('Docs', 'Changelog card visual', 'Changelog', '/800x450/ECFDF5/047857?text=Changelog', 'ECFDF5', '047857', 'wide'),
  item('Docs', 'Tutorial preview image', 'Tutorial', '/800x450/EFF6FF/1D4ED8?text=Tutorial', 'EFF6FF', '1D4ED8', 'wide'),
  item('Docs', 'API docs preview image', 'API Docs', '/800x450/18181B/FFFFFF?text=API+Docs', '18181B', 'FFFFFF', 'wide'),
  item('Docs', 'Help center article image', 'Help Center', '/800x450/F4F4F5/52525B?text=Help+Center', 'F4F4F5', '52525B', 'wide'),

  item('Data', 'Dashboard report preview', 'Report Preview', '/800x500/18181B/FFFFFF?text=Report+Preview', '18181B', 'FFFFFF', 'wide', true),
