  item('Recovery', 'Upload failed placeholder', 'Upload Failed', '/800x500/FFF1F2/BE123C?text=Upload+Failed', 'FFF1F2', 'BE123C', 'wide'),
  item('Recovery', 'Broken image replacement', 'Image Unavailable', '/800x500/18181B/FFFFFF?text=Image+Unavailable', '18181B', 'FFFFFF', 'wide', true),
  item('Recovery', 'Offline media state', 'Offline', '/800x500/F4F4F5/52525B?text=Offline', 'F4F4F5', '52525B', 'wide'),
