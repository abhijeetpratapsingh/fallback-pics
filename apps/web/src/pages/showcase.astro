---
import Layout from '../layouts/Layout.astro';

const API_BASE = 'https://fallback.pics/api/v1';
const canonical = 'https://fallback.pics/showcase/';

type Category = 'Product' | 'People' | 'Loading' | 'Marketing' | 'Apps' | 'Docs' | 'Data' | 'Recovery';
type Aspect = 'wide' | 'square' | 'portrait' | 'banner' | 'avatar';

type ShowcaseItem = {
  title: string;
  label: string;
  category: Category;
  recipe: string;
  url: string;
  bg: string;
  fg: string;
  aspect: Aspect;
  featured?: boolean;
};

const categories: Category[] = ['Product', 'People', 'Loading', 'Marketing', 'Apps', 'Docs', 'Data', 'Recovery'];

const categoryMeta: Record<Category, { blurb: string }> = {
  Product: { blurb: 'Catalog cards, variants, carts, and campaign banners when vendor media is missing.' },
  People: { blurb: 'Initials avatars, org logos, and profile fallbacks for users and teams.' },
  Loading: { blurb: 'Skeleton and animated states that preserve layout while images resolve.' },
  Marketing: { blurb: 'Open Graph art, newsletters, case studies, and social share previews.' },
  Apps: { blurb: 'Attachments, video thumbs, PDF previews, and location media slots.' },
  Docs: { blurb: 'Article thumbnails, changelogs, tutorials, and help center visuals.' },
  Data: { blurb: 'Dashboard reports, chart placeholders, and analytics empty states.' },
  Recovery: { blurb: 'Upload failures, broken src replacement, and offline media states.' },
};

function item(
  category: Category,
  title: string,
  label: string,
  recipe: string,
  bg: string,
  fg = 'FFFFFF',
  aspect: Aspect = 'wide',
  featured = false,
): ShowcaseItem {
  return {
    category,
    title,
    label,
    recipe,
    bg,
    fg,
    aspect,
    featured,
    url: `${API_BASE}${recipe}`,
  };
}

function fallbackSvg(showcaseItem: ShowcaseItem) {
  const dimensions = showcaseItem.aspect === 'avatar'
    ? [320, 320]
    : showcaseItem.aspect === 'square'
      ? [640, 640]
      : showcaseItem.aspect === 'portrait'
        ? [540, 720]
        : showcaseItem.aspect === 'banner'
          ? [1200, 420]
          : [800, 500];
  const [width, height] = dimensions;
  const fontSize = Math.max(22, Math.min(width, height) * 0.085);
  const radius = showcaseItem.aspect === 'avatar' ? width / 2 : 28;
  const svg = `<svg width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" xmlns="http://www.w3.org/2000/svg"><rect width="${width}" height="${height}" rx="${radius}" fill="#${showcaseItem.bg}"/><text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="${fontSize}" font-weight="750" fill="#${showcaseItem.fg}">${showcaseItem.label}</text></svg>`;
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
}

function presetFromRecipe(recipe: string) {
  const segment = recipe.split('/').filter(Boolean)[0] ?? 'standard';
  if (segment.includes('x') || segment.match(/^\d/)) return 'standard';
  if (segment === 'ai') return 'pattern';
  if (segment === 'animated') return 'animated';
  return segment;
}

const showcaseItems: ShowcaseItem[] = [
