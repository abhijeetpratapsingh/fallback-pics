const featuredItems = showcaseItems.filter((entry) => entry.featured);

const presetSpotlight = [
  { name: 'Standard', url: `${API_BASE}/800x450?text=Product+Image`, route: '/api/v1/800x450?text=Product+Image' },
  { name: 'Thumbnail', url: `${API_BASE}/thumbnail/1200x630?text=Showcase&style=soft`, route: '/api/v1/thumbnail/1200x630?style=soft' },
  { name: 'Avatar', url: `${API_BASE}/avatar/128?text=JD`, route: '/api/v1/avatar/128?text=JD' },
  { name: 'Square', url: `${API_BASE}/square/400?text=Tile`, route: '/api/v1/square/400?text=Tile' },
  { name: 'Banner', url: `${API_BASE}/banner/1200x400?text=Campaign`, route: '/api/v1/banner/1200x400?text=Campaign' },
  { name: 'Skeleton', url: `${API_BASE}/skeleton/640x360`, route: '/api/v1/skeleton/640x360' },
  { name: 'Animated', url: `${API_BASE}/animated/skeleton/640x360`, route: '/api/v1/animated/skeleton/640x360' },
  { name: 'Blur', url: `${API_BASE}/blur/800x450`, route: '/api/v1/blur/800x450' },
  { name: 'Pattern', url: `${API_BASE}/ai/800x450?context=saas&mood=minimal`, route: '/api/v1/ai/800x450?context=saas&mood=minimal' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'fallback.pics Showcase',
  description: 'A visual gallery of generated fallback images, avatars, banners, skeleton states, and missing-media examples.',
  url: canonical,
  mainEntity: showcaseItems.map((showcaseItem) => ({
    '@type': 'ImageObject',
    name: showcaseItem.title,
    contentUrl: showcaseItem.url,
    caption: showcaseItem.label,
  })),
};
---

<Layout
  title="Showcase — Placeholder Image Gallery | fallback.pics"
  description="Browse {showcaseItems.length} live fallback.pics examples: product placeholders, avatars, blog thumbnails, skeleton loaders, and broken-image recovery states."
  keywords="fallback image showcase, placeholder image examples, avatar placeholder examples, skeleton placeholder examples, generated fallback images"
  canonical={canonical}
  ogImage={`${API_BASE}/thumbnail/1200x630?text=Showcase&style=soft`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main id="main-content" class="showcase-page">
    <section class="showcase-hero" aria-labelledby="showcase-heading">
      <div class="showcase-hero__copy">
        <p class="showcase-eyebrow">Showcase</p>
        <h1 id="showcase-heading">See what a single URL can replace.</h1>
        <p>
          {showcaseItems.length} live examples across {categories.length} product categories—every image generated from a readable fallback.pics route. Filter by surface, copy a URL, or open the generator to customize.
        </p>
        <div class="showcase-hero__actions">
          <a class="showcase-hero__cta" href="/placeholder-image-generator/">Open generator</a>
          <a class="showcase-hero__link" href="/features/">View features</a>
          <a class="showcase-hero__link" href="/api/">API reference</a>
        </div>
        <dl class="showcase-stats">
          <div>
            <dt>{showcaseItems.length}</dt>
            <dd>live examples</dd>
          </div>
          <div>
            <dt>{categories.length}</dt>
            <dd>categories</dd>
          </div>
          <div>
            <dt>{presetSpotlight.length}</dt>
            <dd>preset routes</dd>
          </div>
        </dl>
      </div>

      <div class="showcase-hero__panel" aria-label="Featured showcase preview">
        <span>Featured thumbnail</span>
        <img
          src={`${API_BASE}/thumbnail/1200x630?text=Never+Show+Broken+Images&style=soft&theme=purple`}
          alt="fallback.pics thumbnail showcase preview"
          width="1200"
          height="630"
        />
        <code>/api/v1/thumbnail/1200x630?style=soft&theme=purple</code>
      </div>
    </section>

    <section class="showcase-spotlight" aria-labelledby="showcase-spotlight-heading">
      <div class="showcase-spotlight__header">
        <div>
          <p class="showcase-eyebrow">Presets</p>
          <h2 id="showcase-spotlight-heading">Start from a route, not a blank canvas.</h2>
        </div>
        <p>Nine preset families cover the surfaces teams adopt first. Each card opens the live image.</p>
      </div>
      <div class="showcase-spotlight__grid">
        {presetSpotlight.map((preset) => (
          <a href={preset.url} target="_blank" rel="noreferrer" class="showcase-spotlight__card">
            <div class="showcase-spotlight__media">
              <img src={preset.url} alt={`${preset.name} preset example`} loading="lazy" />
            </div>
            <div>
              <strong>{preset.name}</strong>
              <code>{preset.route}</code>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="gallery" class="showcase-library" aria-labelledby="showcase-library-heading">
      <div class="showcase-library__intro">
        <div>
          <p class="showcase-eyebrow">Gallery</p>
          <h2 id="showcase-library-heading">Browse by product surface.</h2>
        </div>
        <p class="showcase-library__count" data-showcase-count>
          Showing {showcaseItems.length} of {showcaseItems.length} examples
        </p>
      </div>

      <div class="showcase-toolbar">
        <div class="showcase-filters" role="tablist" aria-label="Filter showcase by category">
          <button type="button" class="showcase-filter showcase-filter--active" data-showcase-filter="all" role="tab" aria-selected="true">All</button>
          {categories.map((category) => (
            <button type="button" class="showcase-filter" data-showcase-filter={category} role="tab" aria-selected="false">{category}</button>
          ))}
        </div>
        <a class="showcase-toolbar__link" href="/placeholder-image-generator/">Customize any example →</a>
      </div>

      <p class="showcase-category-blurb" data-showcase-blurb>
        Every example is a deterministic GET URL—click a card to open the image or copy the route into your app.
      </p>

      <div class="showcase-featured" aria-label="Featured examples">
        {featuredItems.map((entry) => (
          <a
            href={entry.url}
            target="_blank"
            rel="noreferrer"
            class="showcase-featured__card"
            data-showcase-featured
            data-category={entry.category}
          >
            <img src={entry.url} data-fallback-src={fallbackSvg(entry)} alt={`${entry.title} preview`} loading="lazy" />
            <span>{entry.category}</span>
            <strong>{entry.title}</strong>
          </a>
        ))}
      </div>

      <div class="showcase-grid" data-showcase-grid>
        {showcaseItems.map((entry) => (
          <article
            class:list={['showcase-card', `showcase-card--${entry.aspect}`]}
            data-showcase-card
            data-category={entry.category}
          >
            <a href={entry.url} target="_blank" rel="noreferrer" class="showcase-card__media" aria-label={`Open ${entry.title} live image`}>
              <img src={entry.url} data-fallback-src={fallbackSvg(entry)} alt={`${entry.title} preview`} loading="lazy" />
              <span class="showcase-card__open">Open live</span>
            </a>
            <div class="showcase-card__body">
              <div class="showcase-card__meta">
                <span class="showcase-card__category">{entry.category}</span>
                <span class="showcase-card__preset">{presetFromRecipe(entry.recipe)}</span>
              </div>
              <h3>{entry.title}</h3>
              <div class="showcase-card__route">
                <code>{entry.recipe}</code>
                <button type="button" class="showcase-card__copy" data-copy-url={`${API_BASE}${entry.recipe}`} aria-label={`Copy URL for ${entry.title}`}>
                  Copy
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="showcase-cta" aria-labelledby="showcase-cta-heading">
      <div>
        <p class="showcase-eyebrow">Next step</p>
        <h2 id="showcase-cta-heading">Turn your highest-traffic image slot into a designed state.</h2>
        <p>Pick an example above, paste the URL into HTML or your framework, then refine dimensions and labels in the generator.</p>
      </div>
      <div class="showcase-cta__actions">
        <a class="showcase-cta__primary" href="/placeholder-image-generator/">Open generator</a>
        <a class="showcase-cta__secondary" href="/docs/">Read docs</a>
      </div>
    </section>
  </main>

  <script define:vars={{ categoryMeta, showcaseItemsLength: showcaseItems.length }}>
    const blurbEl = document.querySelector('[data-showcase-blurb]');
    const countEl = document.querySelector('[data-showcase-count]');
    const fallbackImages = document.querySelectorAll('img[data-fallback-src]');
    fallbackImages.forEach((image) => {
      image.addEventListener('error', () => {
        const fallbackSrc = image.dataset.fallbackSrc;
        if (fallbackSrc && image.src !== fallbackSrc) image.src = fallbackSrc;
      });
    });

    function updateCount(visible) {
      if (countEl) {
        countEl.textContent = `Showing ${visible} of ${showcaseItemsLength} examples`;
      }
    }

    function updateBlurb(category) {
      if (!blurbEl) return;
      if (category === 'all') {
        blurbEl.textContent = 'Every example is a deterministic GET URL—click a card to open the image or copy the route into your app.';
        return;
      }
      blurbEl.textContent = categoryMeta[category]?.blurb ?? '';
    }

    const filterButtons = Array.from(document.querySelectorAll('[data-showcase-filter]'));
    const cards = Array.from(document.querySelectorAll('[data-showcase-card]'));
    const featuredCards = Array.from(document.querySelectorAll('[data-showcase-featured]'));

    function applyFilter(activeCategory) {
      let visible = 0;
      cards.forEach((card) => {
        const show = activeCategory === 'all' || card.dataset.category === activeCategory;
        card.hidden = !show;
        if (show) visible += 1;
      });
      featuredCards.forEach((card) => {
        card.hidden = activeCategory !== 'all' && card.dataset.category !== activeCategory;
      });
      updateCount(visible);
      updateBlurb(activeCategory);
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const activeCategory = button.dataset.showcaseFilter ?? 'all';
        filterButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('showcase-filter--active', active);
          item.setAttribute('aria-selected', String(active));
        });
        applyFilter(activeCategory);
      });
    });

    document.querySelectorAll('[data-copy-url]').forEach((button) => {
      button.addEventListener('click', async (event) => {
        event.preventDefault();
        event.stopPropagation();
        const url = button.dataset.copyUrl;
        if (!url) return;
        try {
          await navigator.clipboard.writeText(url);
          const original = button.textContent;
          button.textContent = 'Copied';
          window.setTimeout(() => {
            button.textContent = original;
          }, 1400);
        } catch {
          button.textContent = 'Failed';
        }
      });
    });
  </script>

  <style>
    .showcase-page {
      overflow-x: clip;
      background: var(--color-surface-subtle);
      color: var(--color-text);
    }

    .showcase-hero,
    .showcase-spotlight,
    .showcase-library,
    .showcase-cta {
      width: min(100% - 2rem, 80rem);
      margin: 0 auto;
    }

    .showcase-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.44fr);
      gap: 2rem;
      align-items: end;
      padding: 4rem 0 3rem;
      border-bottom: 1px solid var(--color-border);
    }

    .showcase-eyebrow {
      margin: 0;
      color: var(--color-brand-hover);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .showcase-hero h1 {
      max-width: 52rem;
      margin: 1rem 0 0;
      color: var(--color-text);
      font-size: clamp(2.35rem, 5vw, 4.25rem);
      font-weight: 650;
      line-height: 1.02;
      letter-spacing: 0;
    }

    .showcase-hero__copy > p:not(.showcase-eyebrow) {
      max-width: 44rem;
      margin: 1.25rem 0 0;
      color: var(--color-text-muted);
      font-size: 1.0625rem;
      line-height: 1.75;
    }

    .showcase-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .showcase-hero__cta,
    .showcase-cta__primary {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      justify-content: center;
      border-radius: 0.5rem;
      background: var(--color-brand);
      color: var(--color-inverse-text);
      font-size: 0.875rem;
      font-weight: 800;
      padding: 0 1rem;
      text-decoration: none;
    }

    .showcase-hero__link,
    .showcase-cta__secondary {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      border-radius: 0.5rem;
