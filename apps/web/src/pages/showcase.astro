  item('Apps', 'File attachment preview', 'Attachment', '/640x480/F4F4F5/52525B?text=Attachment', 'F4F4F5', '52525B', 'wide'),
  item('Apps', 'Video thumbnail placeholder', 'Video Preview', '/800x450/18181B/FFFFFF?text=Video+Preview', '18181B', 'FFFFFF', 'wide'),
  item('Apps', 'PDF preview placeholder', 'PDF Preview', '/640x800/FEF3C7/B45309?text=PDF+Preview', 'FEF3C7', 'B45309', 'portrait'),
  item('Apps', 'Map/location image fallback', 'Location', '/800x500/E0F2FE/0369A1?text=Location', 'E0F2FE', '0369A1', 'wide'),
