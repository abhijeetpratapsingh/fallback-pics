  item('Product', 'Ecommerce collection tile', 'New Collection', '/800x500/ECFDF5/047857?text=New+Collection', 'ECFDF5', '047857', 'wide'),
  item('Product', 'Marketplace listing placeholder', 'Listing Media', '/720x540/EFF6FF/1D4ED8?text=Listing+Media', 'EFF6FF', '1D4ED8', 'wide'),
  item('Product', 'Sale campaign product banner', 'Sale Preview', '/banner/1200x420?text=Sale+Preview', '7C3AED', 'FFFFFF', 'banner'),
  item('Product', 'Featured product hero image', 'Featured Product', '/1200x630/18181B/FFFFFF?text=Featured+Product', '18181B', 'FFFFFF', 'wide', true),
  item('Product', 'Cart item missing image', 'Cart Item', '/640x480/F4F4F5/52525B?text=Cart+Item', 'F4F4F5', '52525B', 'wide'),
  item('Product', 'Recommendation card fallback', 'Recommended', '/600x400/EEF2FF/4338CA?text=Recommended', 'EEF2FF', '4338CA', 'wide'),

  item('People', 'User initials avatar', 'JD', '/avatar/320?text=JD', '7C3AED', 'FFFFFF', 'avatar', true),
  item('People', 'Team member avatar', 'AP', '/avatar/320/18181B/FFFFFF?text=AP', '18181B', 'FFFFFF', 'avatar'),
  item('People', 'Organization logo placeholder', 'Acme', '/640x640/DBEAFE/1D4ED8?text=Acme', 'DBEAFE', '1D4ED8', 'square'),
  item('People', 'Comment author avatar', 'MS', '/avatar/320/ECFDF5/047857?text=MS', 'ECFDF5', '047857', 'avatar'),
  item('People', 'Customer profile photo fallback', 'Customer', '/640x640/FDF2F8/BE185D?text=Customer', 'FDF2F8', 'BE185D', 'square'),
  item('People', 'Admin user avatar', 'Admin', '/avatar/320/FEF3C7/B45309?text=Admin', 'FEF3C7', 'B45309', 'avatar'),
  item('People', 'Support agent avatar', 'Help', '/avatar/320/E0F2FE/0369A1?text=Help', 'E0F2FE', '0369A1', 'avatar'),
