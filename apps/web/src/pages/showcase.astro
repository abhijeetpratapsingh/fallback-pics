---
import Layout from '../layouts/Layout.astro';

const API_BASE = 'https://fallback.pics/api/v1';

type Category = 'Product' | 'People' | 'Loading' | 'Marketing' | 'Apps' | 'Docs' | 'Data' | 'Recovery';
type Aspect = 'wide' | 'square' | 'portrait' | 'banner' | 'avatar';

type ShowcaseItem = {
  title: string;
  label: string;
  category: Category;
  recipe: string;
  url: string;
  bg: string;
  fg: string;
  aspect: Aspect;
  featured?: boolean;
};

const categories: Category[] = ['Product', 'People', 'Loading', 'Marketing', 'Apps', 'Docs', 'Data', 'Recovery'];

function item(
  category: Category,
  title: string,
  label: string,
  recipe: string,
  bg: string,
  fg = 'FFFFFF',
  aspect: Aspect = 'wide',
  featured = false,
): ShowcaseItem {
  return {
    category,
    title,
    label,
    recipe,
    bg,
    fg,
    aspect,
    featured,
    url: `${API_BASE}${recipe}`,
  };
}

function fallbackSvg(item: ShowcaseItem) {
  const dimensions = item.aspect === 'avatar'
    ? [320, 320]
    : item.aspect === 'square'
      ? [640, 640]
      : item.aspect === 'portrait'
        ? [540, 720]
        : item.aspect === 'banner'
          ? [1200, 420]
          : [800, 500];
  const [width, height] = dimensions;
  const fontSize = Math.max(22, Math.min(width, height) * 0.085);
  const radius = item.aspect === 'avatar' ? width / 2 : 28;
  const svg = `<svg width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" xmlns="http://www.w3.org/2000/svg"><rect width="${width}" height="${height}" rx="${radius}" fill="#${item.bg}"/><text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="${fontSize}" font-weight="750" fill="#${item.fg}">${item.label}</text></svg>`;
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
}

const showcaseItems: ShowcaseItem[] = [
  item('Product', 'Product image fallback', 'Product Image', '/800x500/18181B/FFFFFF?text=Product+Image', '18181B', 'FFFFFF', 'wide', true),
  item('Product', 'Product unavailable dark card', 'Unavailable', '/640x640/18181B/FFFFFF?text=Unavailable', '18181B', 'FFFFFF', 'square'),
  item('Product', 'Product coming soon', 'Coming Soon', '/640x640/F5F3FF/6D28D9?text=Coming+Soon', 'F5F3FF', '6D28D9', 'square'),
  item('Product', 'Product variant missing', 'Variant Missing', '/640x640/FFF7ED/C2410C?text=Variant+Missing', 'FFF7ED', 'C2410C', 'square'),
  item('Product', 'Ecommerce collection tile', 'New Collection', '/800x500/ECFDF5/047857?text=New+Collection', 'ECFDF5', '047857', 'wide'),
  item('Product', 'Marketplace listing placeholder', 'Listing Media', '/720x540/EFF6FF/1D4ED8?text=Listing+Media', 'EFF6FF', '1D4ED8', 'wide'),
  item('Product', 'Sale campaign product banner', 'Sale Preview', '/banner/1200x420?text=Sale+Preview', '7C3AED', 'FFFFFF', 'banner'),
  item('Product', 'Featured product hero image', 'Featured Product', '/1200x630/18181B/FFFFFF?text=Featured+Product', '18181B', 'FFFFFF', 'wide', true),
  item('Product', 'Cart item missing image', 'Cart Item', '/640x480/F4F4F5/52525B?text=Cart+Item', 'F4F4F5', '52525B', 'wide'),
  item('Product', 'Recommendation card fallback', 'Recommended', '/600x400/EEF2FF/4338CA?text=Recommended', 'EEF2FF', '4338CA', 'wide'),

  item('People', 'User initials avatar', 'JD', '/avatar/320?text=JD', '7C3AED', 'FFFFFF', 'avatar', true),
  item('People', 'Team member avatar', 'AP', '/avatar/320/18181B/FFFFFF?text=AP', '18181B', 'FFFFFF', 'avatar'),
  item('People', 'Organization logo placeholder', 'Acme', '/640x640/DBEAFE/1D4ED8?text=Acme', 'DBEAFE', '1D4ED8', 'square'),
  item('People', 'Comment author avatar', 'MS', '/avatar/320/ECFDF5/047857?text=MS', 'ECFDF5', '047857', 'avatar'),
  item('People', 'Customer profile photo fallback', 'Customer', '/640x640/FDF2F8/BE185D?text=Customer', 'FDF2F8', 'BE185D', 'square'),
  item('People', 'Admin user avatar', 'Admin', '/avatar/320/FEF3C7/B45309?text=Admin', 'FEF3C7', 'B45309', 'avatar'),
  item('People', 'Support agent avatar', 'Help', '/avatar/320/E0F2FE/0369A1?text=Help', 'E0F2FE', '0369A1', 'avatar'),
  item('People', 'Anonymous user avatar', 'Guest', '/avatar/320/F4F4F5/52525B?text=Guest', 'F4F4F5', '52525B', 'avatar'),
  item('People', 'Round community avatar', 'Group', '/avatar/320/F5F3FF/6D28D9?text=Group', 'F5F3FF', '6D28D9', 'avatar'),
  item('People', 'Square workspace avatar', 'Workspace', '/640x640/18181B/FFFFFF?text=Workspace', '18181B', 'FFFFFF', 'square'),

  item('Loading', 'Skeleton product card', 'Loading', '/animated/skeleton/640x640', 'F4F4F5', 'A1A1AA', 'square', true),
  item('Loading', 'Skeleton hero image', 'Loading Hero', '/animated/skeleton/1200x630', 'F4F4F5', 'A1A1AA', 'wide'),
  item('Loading', 'Skeleton dashboard chart', 'Chart Loading', '/animated/skeleton/800x500', 'F4F4F5', 'A1A1AA', 'wide'),
  item('Loading', 'Skeleton profile card', 'Profile Loading', '/animated/skeleton/540x720', 'F4F4F5', 'A1A1AA', 'portrait'),
  item('Loading', 'Skeleton article thumbnail', 'Article Loading', '/animated/skeleton/640x360', 'F4F4F5', 'A1A1AA', 'wide'),
  item('Loading', 'Skeleton image grid', 'Grid Loading', '/animated/skeleton/900x600', 'F4F4F5', 'A1A1AA', 'wide'),
  item('Loading', 'Skeleton mobile feed item', 'Feed Loading', '/animated/skeleton/540x720', 'F4F4F5', 'A1A1AA', 'portrait'),
  item('Loading', 'Skeleton checkout media', 'Checkout', '/animated/skeleton/640x480', 'F4F4F5', 'A1A1AA', 'wide'),
  item('Loading', 'Skeleton CMS preview', 'CMS Loading', '/animated/skeleton/800x450', 'F4F4F5', 'A1A1AA', 'wide'),
  item('Loading', 'Skeleton app sidebar preview', 'Sidebar', '/animated/skeleton/360x720', 'F4F4F5', 'A1A1AA', 'portrait'),

  item('Marketing', 'Blog cover placeholder', 'Blog Cover', '/1200x630/18181B/FFFFFF?text=Blog+Cover', '18181B', 'FFFFFF', 'wide'),
  item('Docs', 'Docs article thumbnail', 'Docs Preview', '/800x450/F5F3FF/6D28D9?text=Docs+Preview', 'F5F3FF', '6D28D9', 'wide'),
  item('Marketing', 'Open Graph image placeholder', 'Open Graph', '/1200x630/7C3AED/FFFFFF?text=Open+Graph', '7C3AED', 'FFFFFF', 'wide', true),
  item('Docs', 'Changelog card visual', 'Changelog', '/800x450/ECFDF5/047857?text=Changelog', 'ECFDF5', '047857', 'wide'),
  item('Docs', 'Tutorial preview image', 'Tutorial', '/800x450/EFF6FF/1D4ED8?text=Tutorial', 'EFF6FF', '1D4ED8', 'wide'),
  item('Docs', 'API docs preview image', 'API Docs', '/800x450/18181B/FFFFFF?text=API+Docs', '18181B', 'FFFFFF', 'wide'),
  item('Marketing', 'Case study cover', 'Case Study', '/1200x630/FFF7ED/C2410C?text=Case+Study', 'FFF7ED', 'C2410C', 'wide'),
  item('Docs', 'Help center article image', 'Help Center', '/800x450/F4F4F5/52525B?text=Help+Center', 'F4F4F5', '52525B', 'wide'),
  item('Marketing', 'Newsletter card visual', 'Newsletter', '/800x500/FDF2F8/BE185D?text=Newsletter', 'FDF2F8', 'BE185D', 'wide'),
  item('Marketing', 'Social share preview', 'Social Preview', '/1200x630/DBEAFE/1D4ED8?text=Social+Preview', 'DBEAFE', '1D4ED8', 'wide'),

  item('Data', 'Dashboard report preview', 'Report Preview', '/800x500/18181B/FFFFFF?text=Report+Preview', '18181B', 'FFFFFF', 'wide', true),
  item('Data', 'Chart placeholder', 'Chart', '/800x500/ECFDF5/047857?text=Chart', 'ECFDF5', '047857', 'wide'),
  item('Data', 'Analytics card empty state', 'No Data Yet', '/640x480/F5F3FF/6D28D9?text=No+Data+Yet', 'F5F3FF', '6D28D9', 'wide'),
  item('Apps', 'File attachment preview', 'Attachment', '/640x480/F4F4F5/52525B?text=Attachment', 'F4F4F5', '52525B', 'wide'),
  item('Apps', 'Video thumbnail placeholder', 'Video Preview', '/800x450/18181B/FFFFFF?text=Video+Preview', '18181B', 'FFFFFF', 'wide'),
  item('Apps', 'PDF preview placeholder', 'PDF Preview', '/640x800/FEF3C7/B45309?text=PDF+Preview', 'FEF3C7', 'B45309', 'portrait'),
  item('Apps', 'Map/location image fallback', 'Location', '/800x500/E0F2FE/0369A1?text=Location', 'E0F2FE', '0369A1', 'wide'),
  item('Recovery', 'Upload failed placeholder', 'Upload Failed', '/800x500/FFF1F2/BE123C?text=Upload+Failed', 'FFF1F2', 'BE123C', 'wide'),
  item('Recovery', 'Broken image replacement', 'Image Unavailable', '/800x500/18181B/FFFFFF?text=Image+Unavailable', '18181B', 'FFFFFF', 'wide', true),
  item('Recovery', 'Offline media state', 'Offline', '/800x500/F4F4F5/52525B?text=Offline', 'F4F4F5', '52525B', 'wide'),
];

const featuredItems = showcaseItems.filter((item) => item.featured).slice(0, 8);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'fallback.pics Showcase',
  description: 'A visual gallery of generated fallback images, avatars, banners, skeleton states, and missing-media examples.',
  url: 'https://fallback.pics/showcase/',
  mainEntity: showcaseItems.map((showcaseItem) => ({
    '@type': 'ImageObject',
    name: showcaseItem.title,
    contentUrl: showcaseItem.url,
    caption: showcaseItem.label,
  })),
};
---

<Layout
  title="Showcase | fallback.pics"
  description="Explore 50 visual examples of fallback.pics generated placeholders, avatars, banners, skeleton states, product fallbacks, docs thumbnails, and recovery states."
  keywords="fallback image showcase, placeholder image examples, avatar placeholder examples, skeleton placeholder examples, generated fallback images"
  canonical="https://fallback.pics/showcase/"
  ogImage="https://fallback.pics/api/v1/1200x630/18181B/FFFFFF?text=fallback.pics+Showcase"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main id="main-content" class="showcase-page">
    <section class="showcase-hero" aria-labelledby="showcase-heading">
      <div class="showcase-hero__copy">
        <p class="showcase-eyebrow">Showcase</p>
        <h1 id="showcase-heading">Fallbacks worth shipping.</h1>
        <p>
          Fifty visual examples of product placeholders, avatars, banners, skeletons, previews,
          and recovery states generated from simple fallback.pics URLs.
        </p>
        <div class="showcase-hero__actions">
          <a href="/placeholder-image-generator/">Build your first fallback URL</a>
          <a href="/api/">View API</a>
        </div>
      </div>

      <div class="showcase-collage" aria-label="Featured generated fallback visuals">
        {featuredItems.map((item) => (
          <figure class:list={['showcase-collage__item', `showcase-collage__item--${item.aspect}`]} data-category={item.category}>
            <img src={item.url} data-fallback-src={fallbackSvg(item)} alt={`${item.title} preview`} loading="eager" />
            <figcaption>{item.label}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="showcase-library" aria-labelledby="showcase-library-heading">
      <div class="showcase-library__header">
        <div>
          <p class="showcase-eyebrow">Visual library</p>
          <h2 id="showcase-library-heading">50 ways to make missing media look intentional.</h2>
        </div>
        <p>{showcaseItems.length} generated image states across {categories.length} platform categories.</p>
      </div>

      <div class="showcase-filters" aria-label="Filter showcase visuals by category">
        <button type="button" class="showcase-filter showcase-filter--active" data-showcase-filter="all">All</button>
        {categories.map((category) => (
          <button type="button" class="showcase-filter" data-showcase-filter={category}>{category}</button>
        ))}
      </div>

      <div class="showcase-grid" data-showcase-grid>
        {showcaseItems.map((item) => (
          <article
            class:list={['showcase-card', `showcase-card--${item.aspect}`]}
            data-showcase-card
            data-category={item.category}
          >
            <div class="showcase-card__media">
              <img src={item.url} data-fallback-src={fallbackSvg(item)} alt={`${item.title} preview`} loading="lazy" />
            </div>
            <div class="showcase-card__body">
              <span>{item.category}</span>
              <h3>{item.title}</h3>
              <code>{item.recipe}</code>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="showcase-cta" aria-labelledby="showcase-cta-heading">
      <div>
        <p class="showcase-eyebrow">One URL</p>
        <h2 id="showcase-cta-heading">Turn every empty image slot into a designed state.</h2>
      </div>
      <div class="showcase-cta__actions">
        <a href="/placeholder-image-generator/">Build your first fallback URL</a>
        <a href="/docs/">Read docs</a>
      </div>
    </section>
  </main>

  <script>
    const fallbackImages = document.querySelectorAll<HTMLImageElement>('img[data-fallback-src]');
    fallbackImages.forEach((image) => {
      image.addEventListener('error', () => {
        const fallbackSrc = image.dataset.fallbackSrc;
        if (fallbackSrc && image.src !== fallbackSrc) image.src = fallbackSrc;
      });
    });

    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-showcase-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-showcase-card]'));

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const activeCategory = button.dataset.showcaseFilter ?? 'all';
        filterButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('showcase-filter--active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        cards.forEach((card) => {
          card.hidden = activeCategory !== 'all' && card.dataset.category !== activeCategory;
        });
      });
    });

    filterButtons[0]?.setAttribute('aria-pressed', 'true');
  </script>

  <style>
    .showcase-page {
      overflow-x: clip;
      background:
        linear-gradient(to bottom, rgba(124, 58, 237, 0.045), transparent 34rem),
        var(--color-surface-subtle);
      color: var(--color-text);
    }

    .showcase-hero,
    .showcase-library,
    .showcase-cta {
      width: min(100% - 2rem, 80rem);
      margin: 0 auto;
    }

    .showcase-hero {
      display: grid;
      grid-template-columns: minmax(0, 0.74fr) minmax(24rem, 1fr);
      gap: 2.5rem;
      align-items: center;
      min-height: calc(100vh - 4rem);
      padding: 5rem 0 4rem;
    }

    .showcase-eyebrow,
    .showcase-card__body span {
      margin: 0;
      color: var(--color-brand-hover);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .showcase-hero h1 {
      margin: 1rem 0 0;
      color: var(--color-text);
      font-size: clamp(3.25rem, 8vw, 7.5rem);
      font-weight: 650;
      line-height: 0.9;
      letter-spacing: 0;
    }

    .showcase-hero__copy > p:not(.showcase-eyebrow) {
      max-width: 43rem;
      margin: 1.5rem 0 0;
      color: var(--color-text-muted);
      font-size: 1.125rem;
      line-height: 1.75;
    }

    .showcase-hero__actions,
    .showcase-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.75rem;
    }

    .showcase-hero__actions a,
    .showcase-cta__actions a {
      display: inline-flex;
      min-height: 2.85rem;
      align-items: center;
      justify-content: center;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 800;
      padding: 0 1rem;
      text-decoration: none;
    }

    .showcase-hero__actions a:first-child,
    .showcase-cta__actions a:first-child {
      background: var(--color-brand-hover);
      color: var(--color-inverse-text);
    }

    .showcase-hero__actions a:last-child,
    .showcase-cta__actions a:last-child {
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text);
    }

    .showcase-collage {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: 5.35rem;
      gap: 0.75rem;
    }

    .showcase-collage__item,
    .showcase-card {
      overflow: hidden;
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      background: var(--color-surface);
      box-shadow: 0 18px 48px rgba(24, 24, 27, 0.08);
    }

    .showcase-collage__item {
      position: relative;
      margin: 0;
      background:
        radial-gradient(circle at 1px 1px, rgba(124, 58, 237, 0.16) 1px, transparent 0),
        linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(244, 244, 245, 0.9));
      background-size: 20px 20px, 100% 100%;
      padding: 0.72rem;
    }

    .showcase-collage__item:nth-child(1) {
      grid-column: span 4;
      grid-row: span 3;
    }

    .showcase-collage__item:nth-child(2) {
      grid-column: span 2;
      grid-row: span 2;
    }

    .showcase-collage__item:nth-child(3) {
      grid-column: span 2;
      grid-row: span 2;
    }

    .showcase-collage__item:nth-child(4),
    .showcase-collage__item:nth-child(5) {
      grid-column: span 3;
      grid-row: span 2;
    }

    .showcase-collage__item:nth-child(6),
    .showcase-collage__item:nth-child(7),
    .showcase-collage__item:nth-child(8) {
      grid-column: span 2;
      grid-row: span 2;
    }

    .showcase-collage img,
    .showcase-card img {
      display: block;
      width: 100%;
      height: 100%;
      border: 1px solid rgba(24, 24, 27, 0.08);
      border-radius: 0.45rem;
      background: var(--color-surface);
      box-shadow: 0 14px 28px rgba(24, 24, 27, 0.12);
      object-fit: contain;
    }

    .showcase-collage__item--avatar img,
    .showcase-card--avatar img {
      width: min(78%, 18rem);
      height: min(78%, 18rem);
      margin: auto;
      border-radius: 999px;
    }

    .showcase-collage figcaption {
      position: absolute;
      left: 0.75rem;
      bottom: 0.75rem;
      max-width: calc(100% - 1.5rem);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 0.5rem;
      background: rgba(24, 24, 27, 0.74);
      color: var(--color-inverse-text);
      font-size: 0.8125rem;
      font-weight: 800;
      line-height: 1.2;
      padding: 0.45rem 0.55rem;
      backdrop-filter: blur(10px);
    }

    .showcase-library {
      border-top: 1px solid var(--color-border);
      padding: 4rem 0 5rem;
    }

    .showcase-library__header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 24rem);
      gap: 1.5rem;
      align-items: end;
      margin-bottom: 1.5rem;
    }

    .showcase-library h2,
    .showcase-cta h2 {
      max-width: 48rem;
      margin: 0.75rem 0 0;
      color: var(--color-text);
      font-size: clamp(2rem, 4vw, 4.6rem);
      font-weight: 650;
      line-height: 1;
      letter-spacing: 0;
    }

    .showcase-library__header > p {
      color: var(--color-text-muted);
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.65;
    }

    .showcase-filters {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding: 0 0 1rem;
    }

    .showcase-filter {
      flex: 0 0 auto;
      min-height: 2.35rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: var(--color-surface);
      color: var(--color-text-muted);
      cursor: pointer;
      font-size: 0.8125rem;
      font-weight: 800;
      padding: 0 0.95rem;
    }

    .showcase-filter--active,
    .showcase-filter:hover {
      border-color: var(--color-brand-soft);
      background: var(--color-brand-soft);
      color: var(--color-brand-strong);
    }

    .showcase-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }

    .showcase-card[hidden] {
      display: none;
    }

    .showcase-card {
      display: grid;
      min-height: 100%;
      box-shadow: 0 1px 2px rgba(24, 24, 27, 0.06);
      transition: border-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
    }

    .showcase-card:hover {
      border-color: var(--color-brand-soft);
      box-shadow: 0 18px 40px rgba(24, 24, 27, 0.08);
      transform: translateY(-2px);
    }

    .showcase-card__media {
      position: relative;
      display: grid;
      place-items: center;
      aspect-ratio: 16 / 10;
      min-height: 12rem;
      overflow: hidden;
      background:
        radial-gradient(circle at 1px 1px, rgba(124, 58, 237, 0.13) 1px, transparent 0),
        linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(244, 244, 245, 0.92));
      background-size: 18px 18px, 100% 100%;
      padding: 0.85rem;
    }

    .showcase-card--square .showcase-card__media,
    .showcase-card--avatar .showcase-card__media {
      aspect-ratio: 1;
    }

    .showcase-card--portrait .showcase-card__media {
      aspect-ratio: 3 / 4;
    }

    .showcase-card--banner .showcase-card__media {
      aspect-ratio: 21 / 8;
      min-height: 9.5rem;
    }

    .showcase-card[data-category='Loading'] .showcase-card__media::before {
      content: '';
      position: absolute;
      inset: 1.15rem;
      border-radius: 0.5rem;
      background:
        linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,0.74), rgba(255,255,255,0)) -100% 0 / 50% 100% no-repeat,
        linear-gradient(#e4e4e7, #e4e4e7) 1rem 1rem / 42% 0.8rem no-repeat,
        linear-gradient(#e4e4e7, #e4e4e7) 1rem 2.45rem / 64% 0.65rem no-repeat,
        linear-gradient(#e4e4e7, #e4e4e7) 1rem calc(100% - 2rem) / 48% 0.65rem no-repeat,
        rgba(250, 250, 250, 0.78);
      box-shadow: inset 0 0 0 1px rgba(24, 24, 27, 0.06);
      animation: showcase-shimmer 1.8s linear infinite;
      pointer-events: none;
    }

    .showcase-card[data-category='Loading'] .showcase-card__media img {
      opacity: 0.22;
      box-shadow: none;
    }

    @keyframes showcase-shimmer {
      to {
        background-position:
          200% 0,
          1rem 1rem,
          1rem 2.45rem,
          1rem calc(100% - 2rem),
