  item('Loading', 'Skeleton product card', 'Loading', '/animated/skeleton/640x640', 'F4F4F5', 'A1A1AA', 'square', true),
  item('Loading', 'Skeleton hero image', 'Loading Hero', '/animated/skeleton/1200x630', 'F4F4F5', 'A1A1AA', 'wide'),
  item('Loading', 'Skeleton dashboard chart', 'Chart Loading', '/animated/skeleton/800x500', 'F4F4F5', 'A1A1AA', 'wide'),
  item('Loading', 'Skeleton profile card', 'Profile Loading', '/animated/skeleton/540x720', 'F4F4F5', 'A1A1AA', 'portrait'),
