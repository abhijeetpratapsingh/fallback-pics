---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Terms | fallback.pics"
  description="Terms information for fallback.pics fallback image infrastructure."
  keywords="fallback.pics terms, placeholder image service terms, fallback image infrastructure"
>
  <main id="main-content" class="bg-white px-5 py-20 text-zinc-950 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-4xl font-semibold tracking-normal">Terms</h1>
      <p class="mt-6 text-lg leading-8 text-zinc-600">
        fallback.pics provides URL-based fallback image generation for development, documentation, testing, and production fallback states. Use the service responsibly and avoid abusive traffic, misleading content, or sensitive data in URLs.
      </p>
      <div class="mt-10 space-y-6 text-sm leading-7 text-zinc-600">
        <p>
          Enterprise plans, SLA terms, support commitments, and custom domain arrangements are defined by the applicable customer agreement.
        </p>
        <p>
          For terms, acceptable-use, or enterprise agreement questions, contact <a href="mailto:support@fallback.pics" class="font-semibold text-violet-700">support@fallback.pics</a>.
        </p>
      </div>
    </div>
  </main>
</Layout>
