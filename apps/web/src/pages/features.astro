---
import DocsLayout from '../layouts/DocsLayout.astro';

const baseUrl = 'https://fallback.pics/api/v1';

const navItems = [
  { href: '#platform', label: 'Platform' },
  { href: '#capabilities', label: 'Capabilities' },
  { href: '#comparison', label: 'Comparison' },
  { href: '#use-cases', label: 'Use cases' },
  { href: '#enterprise', label: 'Enterprise' },
];

const capabilities = [
  {
    title: 'URL-based image API',
    detail: 'Every fallback is encoded as a readable URL, so it works in HTML, CSS, React, CMS content, emails, and native clients.',
    example: '/api/v1/800x450/18181B/FFFFFF?text=Product+Image',
  },
  {
    title: 'Deterministic image output',
    detail: 'Generated images are small, cacheable, inspectable by URL, and available as default SVG or raster PNG, JPEG, and WebP.',
    example: 'Content-Type: image/webp',
  },
  {
    title: 'Presets for product states',
    detail: 'Use avatar, banner, skeleton, blur, animated, contextual, and chart routes for common placeholder surfaces.',
    example: '/api/v1/avatar/160?text=JD',
  },
  {
    title: 'Brand-safe customization',
    detail: 'Control dimensions, path-based background and foreground colors, label copy, and selected route behavior from the URL.',
    example: '/api/v1/800x450/18181B/FFFFFF?text=Fallback',
  },
  {
    title: 'Edge-first delivery',
    detail: 'The active worker returns cache-friendly responses with CORS enabled and immutable cache headers for repeated delivery.',
    example: 'Cache-Control: public, max-age=31536000',
  },
  {
    title: 'Privacy-conscious integration',
    detail: 'No client SDK or source image upload is required. Avoid placing secrets or regulated data in public URL labels.',
    example: 'GET-only public routes',
  },
];

const comparisonRows = [
  { feature: 'No SDK required', fallback: 'Yes', generic: 'Usually' },
  { feature: 'Deterministic URL surface', fallback: 'Yes', generic: 'Varies' },
  { feature: 'SVG plus raster formats', fallback: 'Yes', generic: 'Varies' },
  { feature: 'Avatar and state presets', fallback: 'Yes', generic: 'Partial' },
  { feature: 'Long-lived CDN caching', fallback: 'Yes', generic: 'Varies' },
  { feature: 'Enterprise custom domains', fallback: 'Available by agreement', generic: 'Rare' },
];

const useCases = [
  { title: 'E-commerce', detail: 'Protect product grids, collections, recommendations, and transactional email previews from missing media.' },
  { title: 'SaaS dashboards', detail: 'Keep analytics cards, profile surfaces, org logos, and chart skeletons visually stable.' },
  { title: 'Marketplaces', detail: 'Standardize seller inventory images, avatars, listings, and pending moderation states.' },
  { title: 'Mobile apps', detail: 'Use URL fallbacks in native views without shipping a separate placeholder asset bundle.' },
];
---

<DocsLayout
  title="Features | fallback.pics"
  description="Explore fallback.pics infrastructure capabilities: URL-based image fallbacks, SVG and raster output, presets, edge delivery, caching, privacy-conscious integration, and enterprise options."
>
  <div class="features-page">
    <section class="features-hero">
      <div>
        <p class="features-eyebrow">Features</p>
        <h1>Image fallback primitives for production interfaces.</h1>
        <p>
          Replace fragile placeholder assets with URL-addressable infrastructure that keeps product surfaces stable when source images fail, arrive late, or do not exist yet.
        </p>
      </div>
      <div class="features-hero__panel">
        <span>Live route</span>
        <img src={`${baseUrl}/800x450/18181B/FFFFFF?text=Fallback+Image`} alt="Generated fallback image preview" />
        <code>/api/v1/800x450/18181B/FFFFFF?text=Fallback+Image</code>
      </div>
    </section>

    <div class="features-grid">
      <aside class="features-sidebar" aria-label="Features navigation">
        <span>Explore</span>
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </aside>

      <article class="features-content">
        <section id="platform" class="features-section">
          <div class="features-section__header">
            <p>Platform</p>
            <h2>Built for teams that cannot afford broken image states.</h2>
          </div>
          <div class="features-metric-grid">
            <div>
              <strong>4</strong>
              <span>supported output formats</span>
            </div>
            <div>
              <strong>GET</strong>
              <span>simple public route surface</span>
            </div>
            <div>
              <strong>1 year</strong>
              <span>immutable cache policy</span>
            </div>
          </div>
        </section>

        <section id="capabilities" class="features-section">
          <div class="features-section__header">
            <p>Capabilities</p>
            <h2>Focused primitives, not a template feature list.</h2>
          </div>
          <div class="features-card-grid">
            {capabilities.map((feature) => (
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.detail}</p>
                <code>{feature.example}</code>
              </div>
            ))}
          </div>
        </section>

        <section id="comparison" class="features-section">
          <div class="features-section__header">
            <p>Comparison</p>
            <h2>Designed as infrastructure, not a design-time placeholder toy.</h2>
          </div>
          <div class="features-table-wrap">
            <table class="features-table">
              <thead>
                <tr>
                  <th>Capability</th>
                  <th>fallback.pics</th>
                  <th>Generic placeholders</th>
                </tr>
              </thead>
              <tbody>
                {comparisonRows.map((row) => (
                  <tr>
                    <td>{row.feature}</td>
                    <td>{row.fallback}</td>
                    <td>{row.generic}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="use-cases" class="features-section">
          <div class="features-section__header">
            <p>Use cases</p>
            <h2>Where fallback infrastructure shows up.</h2>
          </div>
          <div class="features-usecase-grid">
            {useCases.map((item) => (
              <div>
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="enterprise" class="features-section">
          <div class="features-final-cta">
            <div>
              <h2>Standardize image fallbacks across your product.</h2>
              <p>For enterprise deployments, use fallback.pics with custom domains, volume terms, support windows, and SLA commitments defined by agreement.</p>
            </div>
            <a href="/#enterprise">View Enterprise</a>
          </div>
        </section>
      </article>
    </div>
  </div>
</DocsLayout>

<style>
  .features-page {
    width: min(100% - 2rem, 80rem);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .features-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.46fr);
    gap: 2rem;
    align-items: end;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 3rem;
  }

  .features-eyebrow,
  .features-section__header p,
  .features-sidebar span {
    margin: 0;
    color: var(--color-brand-hover);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .features-hero h1 {
    max-width: 58rem;
    margin: 1rem 0 0;
    color: var(--color-text);
    font-size: clamp(2.75rem, 6vw, 5.75rem);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .features-hero p:not(.features-eyebrow) {
    max-width: 45rem;
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .features-hero__panel,
  .features-metric-grid > div,
  .features-card-grid > div,
  .features-table-wrap,
  .features-usecase-grid > div,
  .features-final-cta {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-inverse-text);
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }

  .features-hero__panel {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .features-hero__panel span {
    color: var(--color-text-soft);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .features-hero__panel img {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface-muted);
  }

  .features-hero__panel code,
  .features-card-grid code {
    display: block;
    overflow-wrap: anywhere;
    border-radius: 0.5rem;
    background: var(--color-text);
    color: var(--color-code-accent);
    font-size: 0.8125rem;
    line-height: 1.6;
    padding: 0.875rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    padding-top: 3rem;
  }

  .features-sidebar {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-inverse-text);
    padding: 0.75rem;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }

  .features-sidebar span {
    padding: 0.5rem 0.75rem 0.625rem;
  }

  .features-sidebar a {
    border-radius: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 650;
    padding: 0.625rem 0.75rem;
    text-decoration: none;
  }

  .features-sidebar a:hover {
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  .features-content {
    display: grid;
    gap: 4rem;
    min-width: 0;
  }

  .features-section {
    scroll-margin-top: 6rem;
  }

  .features-section__header {
    margin-bottom: 1.5rem;
  }

  .features-section__header h2,
  .features-final-cta h2 {
    margin: 0.625rem 0 0;
    color: var(--color-text);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .features-metric-grid,
  .features-card-grid,
  .features-usecase-grid {
    display: grid;
    gap: 1rem;
  }

  .features-metric-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .features-card-grid,
  .features-usecase-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .features-metric-grid > div,
  .features-card-grid > div,
  .features-usecase-grid > div {
    padding: 1.25rem;
  }

  .features-metric-grid strong {
    display: block;
    color: var(--color-text);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1;
  }

  .features-metric-grid span,
  .features-card-grid p,
  .features-usecase-grid p,
  .features-final-cta p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .features-card-grid h3,
  .features-usecase-grid h3 {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 700;
  }

  .features-table-wrap {
    overflow-x: auto;
  }

  .features-table {
    width: 100%;
    min-width: 42rem;
    border-collapse: collapse;
  }

  .features-table th,
  .features-table td {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem;
    text-align: left;
    vertical-align: top;
  }

  .features-table th {
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .features-table tr:last-child td {
    border-bottom: 0;
  }

  .features-table td {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .features-table td:first-child,
  .features-table td:nth-child(2) {
    color: var(--color-text);
    font-weight: 700;
  }

  .features-final-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem;
    background: var(--color-text);
  }

  .features-final-cta h2 {
    color: var(--color-inverse-text);
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .features-final-cta p {
    margin: 0.75rem 0 0;
    color: var(--color-text-disabled);
  }

  .features-final-cta a {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: var(--color-inverse-text);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 800;
    padding: 0 1rem;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .features-hero,
    .features-grid,
    .features-metric-grid,
    .features-card-grid,
    .features-usecase-grid {
      grid-template-columns: 1fr;
    }

    .features-sidebar {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .features-page {
      padding: 2.5rem 0 4rem;
    }

    .features-hero h1 {
      font-size: 2.75rem;
    }

    .features-final-cta {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
