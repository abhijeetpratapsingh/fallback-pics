---
import DocsLayout from '../layouts/DocsLayout.astro';

const baseUrl = 'https://fallback.pics/api/v1';
const canonical = 'https://fallback.pics/features/';

const navItems = [
  { href: '#platform', label: 'Platform' },
  { href: '#presets', label: 'Presets' },
  { href: '#capabilities', label: 'Capabilities' },
  { href: '#performance', label: 'Performance' },
  { href: '#comparison', label: 'Comparison' },
  { href: '#use-cases', label: 'Use cases' },
  { href: '#integrations', label: 'Integrations' },
  { href: '#faq', label: 'FAQ' },
  { href: '#enterprise', label: 'Enterprise' },
];

const platformMetrics = [
  { value: 'No key', label: 'public GET routes' },
  { value: 'SVG + raster', label: 'PNG, JPEG, WebP' },
  { value: '10–5000px', label: 'bounded dimensions' },
  { value: 'Immutable', label: '1 year cache policy' },
  { value: 'Edge', label: 'Cloudflare delivery' },
  { value: 'CORS', label: 'browser-safe responses' },
];

const presets = [
  {
    name: 'Standard',
    category: 'Core',
    route: '/api/v1/800x450?text=Product+Image',
    url: `${baseUrl}/800x450?text=Product+Image`,
    detail: 'Dimensioned placeholders for cards, grids, and missing product media.',
  },
  {
    name: 'Thumbnail',
    featured: true,
    category: 'Content',
    route: '/api/v1/thumbnail/1200x630?text=Blog+Post+Title&style=soft',
    url: `${baseUrl}/thumbnail/1200x630?text=Blog+Post+Title&style=soft`,
    detail: 'Featured-image style art with safe-zone decoration, themes, and category pills.',
  },
  {
    name: 'Avatar',
    category: 'People',
    route: '/api/v1/avatar/128?text=JD',
    url: `${baseUrl}/avatar/128?text=JD`,
    detail: 'Circular initials for users, teams, org logos, and comment authors.',
  },
  {
    name: 'Square',
    category: 'Catalog',
    route: '/api/v1/square/400?text=Tile',
    url: `${baseUrl}/square/400?text=Tile`,
    detail: 'Square tiles for ecommerce grids, collections, and inventory slots.',
  },
  {
    name: 'Banner',
    category: 'Marketing',
    route: '/api/v1/banner/1200x400?text=Campaign',
    url: `${baseUrl}/banner/1200x400?text=Campaign`,
    detail: 'Wide hero banners for campaigns, docs headers, and landing previews.',
  },
  {
    name: 'Skeleton',
    category: 'Loading',
    route: '/api/v1/skeleton/640x360',
    url: `${baseUrl}/skeleton/640x360`,
    detail: 'Static skeleton blocks that preserve layout while async media resolves.',
  },
  {
    name: 'Animated',
    featured: true,
    category: 'Loading',
    route: '/api/v1/animated/skeleton/640x360',
    url: `${baseUrl}/animated/skeleton/640x360`,
    detail: 'Shimmer, pulse, wave, gradient, and dot motion for loading states.',
  },
  {
    name: 'Chart',
    featured: true,
    category: 'Data',
    route: '/api/v1/chart/line/800x500',
    url: `${baseUrl}/chart/line/800x500`,
    detail: 'Dashboard-ready chart art for reports, metrics cards, and analytics previews.',
  },
  {
    name: 'Gradient',
    featured: true,
    category: 'Brand',
    route: '/api/v1/gradient/800x450',
    url: `${baseUrl}/gradient/800x450`,
    detail: 'Static brand gradients for polished empty media, cards, and hero slots.',
  },
  {
    name: 'Blur',
    category: 'Progressive',
    route: '/api/v1/blur/800x450',
    url: `${baseUrl}/blur/800x450`,
    detail: 'Soft blurred placeholders before high-resolution media arrives.',
  },
  {
    name: 'Pattern',
    category: 'Decorative',
    route: '/api/v1/ai/800x450?context=saas&mood=minimal',
    url: `${baseUrl}/ai/800x450?context=saas&mood=minimal`,
    detail: 'Deterministic decorative backgrounds with optional context and mood.',
  },
];

const pillars = [
  {
    title: 'URL-native API',
    detail: 'Every fallback is a readable GET URL. No SDK, upload pipeline, or auth handshake for public routes.',
    snippet: '/api/v1/800x450?text=Product',
    tone: 'violet',
  },
  {
    title: 'Deterministic output',
    detail: 'Same URL always returns the same image. Safe to cache at the CDN, embed in emails, and review in PRs.',
    snippet: 'Cache-Control: immutable',
    tone: 'blue',
  },
  {
    title: 'Brand-safe controls',
    detail: 'Path colors, labels, thumbnail themes, and preset behavior stay visible and versionable in your codebase.',
    snippet: '/api/v1/800x450/18181B/FFFFFF?text=Acme',
    tone: 'green',
  },
  {
    title: 'Broken-image recovery',
    detail: 'Swap failed src values with dimension-matched fallbacks via onerror handlers or framework error boundaries.',
    snippet: 'onerror → fallback.pics URL',
    tone: 'orange',
  },
];

const capabilities = [
  {
    title: 'Multi-format delivery',
    detail: 'Default SVG for crisp UI. Append .png, .jpg, .jpeg, or .webp when raster output is required.',
    example: '/api/v1/800x450.png?text=Raster',
    url: `${baseUrl}/800x450.png?text=Raster`,
    visual: 'image',
  },
  {
    title: 'Blog thumbnail engine',
    detail: 'Generate OG-safe featured images from post titles with style, theme, and deterministic seed options.',
    example: '/api/v1/thumbnail/1200x630?style=rings&theme=blue',
    url: `${baseUrl}/thumbnail/1200x630?style=rings&theme=blue&text=Release+Notes`,
    visual: 'image',
  },
  {
    title: 'Chart placeholders',
    detail: 'Reserve analytics card space with bar, line, pie, area, donut, scatter, radar, and heatmap skeletons.',
    example: '/api/v1/chart/bar/800x400',
    url: `${baseUrl}/chart/bar/800x400`,
    visual: 'image',
  },
  {
    title: 'Gradient placeholders',
    detail: 'Use deterministic purple-to-blue gradients when a visual surface needs polish without custom assets.',
    example: '/api/v1/gradient/800x450',
    url: `${baseUrl}/gradient/800x450`,
    visual: 'image',
  },
  {
    title: 'CORS-enabled responses',
    detail: 'Use fallbacks in canvas previews, design tools, and cross-origin dashboards without proxy workarounds.',
    example: 'Access-Control-Allow-Origin: *',
    url: `${baseUrl}/640x360?text=Preview`,
    visual: 'protocol',
  },
  {
    title: 'Explicit API errors',
    detail: 'Invalid dimensions and unknown paths return structured API errors—not homepage HTML—so monitoring stays clean.',
    example: '400 Invalid dimensions',
    url: `${baseUrl}/800x450?text=Valid`,
    visual: 'status',
  },
];

const heroPreviews = [
  {
    title: 'Product',
    route: '/api/v1/640x420?text=Product+Image',
    url: `${baseUrl}/640x420?text=Product+Image`,
  },
  {
    title: 'Chart',
    route: '/api/v1/chart/line/800x500',
    url: `${baseUrl}/chart/line/800x500`,
  },
  {
    title: 'Thumbnail',
    route: '/api/v1/thumbnail/1200x630?text=Launch+Notes&style=rings&theme=blue',
    url: `${baseUrl}/thumbnail/1200x630?text=Launch+Notes&style=rings&theme=blue`,
  },
  {
    title: 'Avatar',
    route: '/api/v1/avatar/160?text=AP',
    url: `${baseUrl}/avatar/160?text=AP`,
  },
  {
    title: 'Gradient',
    route: '/api/v1/gradient/800x450',
    url: `${baseUrl}/gradient/800x450`,
  },
  {
    title: 'Skeleton',
    route: '/api/v1/skeleton/640x360',
    url: `${baseUrl}/skeleton/640x360`,
  },
];

const performanceItems = [
  {
    title: 'Edge-first generation',
    body: 'Images are generated at the Cloudflare edge. Repeat requests behave like static assets, not application round-trips.',
  },
  {
    title: 'SVG-first defaults',
    body: 'Vector output stays tiny and sharp at any zoom. Raster formats are available when your pipeline requires bytes.',
  },
  {
    title: 'Long-lived caching',
    body: 'Deterministic URLs ship with immutable cache headers so product grids, emails, and CMS previews stay fast globally.',
  },
  {
    title: 'Privacy by design',
    body: 'No cookies, client SDK, or image uploads. Keep labels user-facing—avoid secrets or regulated data in URL text.',
  },
];

const comparisonRows = [
  { feature: 'No SDK or npm package', fallback: 'Yes', generic: 'Often required' },
  { feature: 'Readable, deterministic URLs', fallback: 'Yes', generic: 'Varies' },
  { feature: 'SVG plus PNG, JPEG, WebP', fallback: 'Yes', generic: 'Partial' },
  { feature: 'Avatar, banner, skeleton, chart, gradient presets', fallback: 'Yes', generic: 'Limited' },
  { feature: 'Blog and chart placeholder generation', fallback: 'Yes', generic: 'Rare' },
  { feature: 'Broken-image onerror patterns', fallback: 'Documented', generic: 'Ad hoc' },
  { feature: 'Immutable CDN caching', fallback: 'Yes', generic: 'Varies' },
  { feature: 'Enterprise custom domains', fallback: 'By agreement', generic: 'Rare' },
];

const useCases = [
  {
    title: 'E-commerce catalogs',
    detail: 'Protect product grids, variant tiles, recommendations, and transactional email previews from missing vendor media.',
    link: '/product-image-placeholder/',
    linkLabel: 'Product placeholder guide',
  },
  {
    title: 'SaaS dashboards',
    detail: 'Stabilize analytics cards, org logos, chart skeletons, and profile surfaces while async data loads.',
    link: '/skeleton-placeholder-generator/',
    linkLabel: 'Skeleton placeholder guide',
  },
  {
    title: 'Docs and blogs',
    detail: 'Generate readable featured images and Open Graph thumbnails from titles without a design asset pipeline.',
    link: '/blog/generate-blog-thumbnails-from-text/',
    linkLabel: 'Blog thumbnail guide',
  },
  {
    title: 'Broken image recovery',
    detail: 'Swap failed image src values with dimension-matched fallbacks that explain the missing state to users.',
    link: '/broken-image-fallback/',
    linkLabel: 'Broken image fallback guide',
  },
  {
    title: 'Marketplaces',
    detail: 'Standardize seller inventory images, avatars, listings, and pending moderation states across listings.',
    link: '/showcase/',
    linkLabel: 'Browse showcase examples',
  },
  {
    title: 'Mobile and native apps',
    detail: 'Use URL fallbacks in WebViews and native image loaders without shipping a separate placeholder asset bundle.',
    link: '/api/',
    linkLabel: 'API reference',
  },
];

const integrations = [
  { href: '/placeholder-image-generator/', label: 'Interactive generator' },
  { href: '/docs/', label: 'Documentation' },
  { href: '/api/', label: 'API reference' },
  { href: '/showcase/', label: 'Live showcase gallery' },
  { href: '/guides/react-image-fallback/', label: 'React image fallback' },
  { href: '/guides/nextjs-image-fallback/', label: 'Next.js image fallback' },
  { href: '/guides/img-onerror-fallback/', label: 'HTML onerror fallback' },
  { href: '/blog/placeholder-image-api-url-syntax-guide/', label: 'URL syntax deep dive' },
];

const faqs = [
  {
    question: 'What makes fallback.pics different from placeholder.com-style services?',
    answer: 'fallback.pics is built as production infrastructure: preset routes for real product states, blog thumbnails, immutable caching, explicit API errors, and guides for broken-image recovery—not just dimension labels.',
  },
  {
    question: 'Do I need an API key?',
    answer: 'No. Public GET routes under /api/v1 work without authentication. Enterprise deployments can add custom domains and support terms by agreement.',
  },
  {
    question: 'Which preset should I start with?',
    answer: 'Use standard width×height for general slots, avatar for people, thumbnail for blog/OG art, chart for dashboard previews, gradient for branded media slots, skeleton or animated for loaders, and blur for progressive image reveals.',
  },
  {
    question: 'Can I use fallbacks in production emails and CMS fields?',
    answer: 'Yes. Deterministic URLs cache globally and work anywhere an image URL is accepted—HTML, React, CSS background-image, Markdown, and rich text editors.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'fallback.pics Features — Placeholder Image Infrastructure',
  description:
    'Explore fallback.pics features: URL-based image API, preset routes, chart and gradient placeholders, SVG and raster formats, edge caching, and production-ready broken-image recovery.',
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'fallback.pics', url: 'https://fallback.pics/' },
};
---

<DocsLayout
  title="Features — Placeholder Image API | fallback.pics"
  description="Explore fallback.pics features: preset image routes, chart and gradient placeholders, SVG and raster formats, blog thumbnails, skeleton loaders, edge caching, and production-ready broken-image recovery."
  keywords="placeholder image features, fallback image api, image placeholder service, chart placeholder, gradient placeholder, broken image fallback, blog thumbnail generator, skeleton placeholder"
  canonical={canonical}
  ogImage={`${baseUrl}/thumbnail/1200x630?text=Features&style=soft`}
>
  <div class="features-page">
    <section class="features-hero">
      <div>
        <p class="features-eyebrow">Features</p>
        <h1>Production image fallbacks, not placeholder clip art.</h1>
        <p>
          fallback.pics gives teams URL-addressable infrastructure for every missing-image state: product cards, charts, avatars, gradients, blog thumbnails, skeleton loaders, blur previews, and broken-src recovery—cached at the edge like static assets.
        </p>
        <div class="features-hero__actions">
          <a class="features-hero__cta" href="/placeholder-image-generator/">Open generator</a>
          <a class="features-hero__link" href="/docs/">Read docs</a>
          <a class="features-hero__link" href="/showcase/">View showcase</a>
        </div>
      </div>
      <div class="features-hero__panel">
        <div class="features-hero__panel-header">
          <span>Live generated surfaces</span>
          <code>/api/v1/*</code>
        </div>
        <div class="features-hero__preview-grid">
          {heroPreviews.map((preview) => (
            <a href={preview.url} target="_blank" rel="noreferrer" class={`features-hero__preview features-hero__preview--${preview.title.toLowerCase()}`}>
              <span>{preview.title}</span>
              <img src={preview.url} alt={`${preview.title} fallback generated by fallback.pics`} loading="lazy" />
              <code>{preview.route}</code>
            </a>
          ))}
        </div>
      </div>
    </section>

    <div class="features-grid">
      <aside class="features-sidebar" aria-label="Features navigation">
        <span>On this page</span>
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </aside>

      <article class="features-content">
        <section id="platform" class="features-section">
          <div class="features-section__header">
            <p>Platform</p>
            <h2>Built for teams that cannot afford broken image states.</h2>
          </div>
          <p class="features-lead">
            One URL replaces fragile placeholder assets across web, mobile, email, and CMS surfaces. Generate once, cache globally, and standardize fallback behavior in design systems and code review.
          </p>
          <div class="features-metric-grid">
            {platformMetrics.map((metric) => (
              <div>
                <strong>{metric.value}</strong>
                <span>{metric.label}</span>
              </div>
            ))}
          </div>
          <div class="features-pillar-grid">
            {pillars.map((pillar) => (
              <div class={`features-pillar features-pillar--${pillar.tone}`}>
                <h3>{pillar.title}</h3>
                <p>{pillar.detail}</p>
                <code>{pillar.snippet}</code>
              </div>
            ))}
          </div>
        </section>

        <section id="presets" class="features-section">
          <div class="features-section__header">
            <p>Presets</p>
            <h2>Preset routes for real product surfaces.</h2>
          </div>
          <p class="features-lead">
            Each preset encodes layout, motion, data art, or decoration so you do not rebuild avatars, chart previews, thumbnail safe zones, or loader shimmer by hand. Click any card to open the live image.
          </p>
          <div class="features-preset-grid">
            {presets.map((preset) => (
              <a href={preset.url} target="_blank" rel="noreferrer" class={`features-preset-card ${preset.featured ? 'features-preset-card--featured' : ''}`}>
                <div class="features-preset-card__media">
                  <span class="features-preset-card__category">{preset.category}</span>
                  <img src={preset.url} alt={`${preset.name} preset generated by fallback.pics`} loading="lazy" />
                </div>
                <div class="features-preset-card__body">
                  <h3>{preset.name}</h3>
                  <code>{preset.route}</code>
                  <p>{preset.detail}</p>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section id="capabilities" class="features-section">
          <div class="features-section__header">
            <p>Capabilities</p>
            <h2>Everything you need beyond width × height.</h2>
          </div>
          <div class="features-capability-grid">
            {capabilities.map((feature) => (
              <article class={`features-capability-card features-capability-card--${feature.visual}`}>
                {feature.visual === 'image' ? (
                  <a
                    href={feature.url}
                    target="_blank"
                    rel="noreferrer"
                    class="features-capability-card__preview"
                    aria-label={`Open live ${feature.title} preview`}
                  >
                    <img src={feature.url} alt={`${feature.title} preview`} loading="lazy" />
                  </a>
                ) : (
                  <div class="features-capability-card__status" aria-hidden="true">
                    {feature.visual === 'protocol' ? (
                      <>
                        <span>HTTP/2 200</span>
                        <code>access-control-allow-origin: *</code>
                        <code>cache-control: immutable</code>
                      </>
                    ) : (
                      <>
                        <span>API response</span>
                        <code>400 Invalid dimensions</code>
                        <code>not homepage HTML</code>
                      </>
                    )}
                  </div>
                )}
                <div>
                  <h3>{feature.title}</h3>
                  <p>{feature.detail}</p>
                  <code>{feature.example}</code>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="performance" class="features-section">
          <div class="features-section__header">
            <p>Performance</p>
            <h2>Fast enough to feel invisible in the UI.</h2>
          </div>
          <div class="features-perf-grid">
            {performanceItems.map((item) => (
              <div class="features-perf-card">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))}
          </div>
          <div class="features-callout">
            <strong>Operational tip:</strong>
            Match fallback dimensions to the final image slot, keep URLs deterministic for repeated states, and prefer SVG unless your pipeline requires raster bytes.
          </div>
        </section>

        <section id="comparison" class="features-section">
          <div class="features-section__header">
            <p>Comparison</p>
            <h2>Infrastructure-minded, not a design-time toy.</h2>
          </div>
          <div class="features-table-wrap">
            <table class="features-table">
              <thead>
                <tr>
                  <th>Capability</th>
                  <th>fallback.pics</th>
                  <th>Generic placeholders</th>
                </tr>
              </thead>
              <tbody>
                {comparisonRows.map((row) => (
                  <tr>
                    <td>{row.feature}</td>
                    <td>{row.fallback}</td>
                    <td>{row.generic}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="use-cases" class="features-section">
          <div class="features-section__header">
            <p>Use cases</p>
            <h2>Where fallback infrastructure shows up first.</h2>
          </div>
          <div class="features-usecase-grid">
            {useCases.map((item) => (
              <article class="features-use-card">
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
                <a href={item.link}>{item.linkLabel} →</a>
              </article>
            ))}
          </div>
        </section>

        <section id="integrations" class="features-section">
          <div class="features-section__header">
            <p>Integrations</p>
            <h2>Start building in your stack.</h2>
          </div>
          <div class="features-links-grid">
            {integrations.map((link) => (
              <a href={link.href} class="features-link-card">{link.label}</a>
            ))}
          </div>
        </section>

        <section id="faq" class="features-section">
          <div class="features-section__header">
            <p>FAQ</p>
            <h2>Common feature questions.</h2>
          </div>
          <div class="features-faq-list">
            {faqs.map((faq) => (
              <article class="features-faq-item">
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="enterprise" class="features-section">
          <div class="features-final-cta">
            <div>
              <h2>Standardize image fallbacks across your product.</h2>
              <p>
                Start with one high-traffic image slot, then expand into team conventions, showcase-approved URLs, and enterprise custom domains with support windows and SLA commitments by agreement.
              </p>
            </div>
            <div class="features-final-cta__actions">
              <a href="/placeholder-image-generator/">Open generator</a>
              <a href="mailto:support@fallback.pics?subject=Enterprise%20fallback.pics" class="features-final-cta__secondary">Contact sales</a>
            </div>
          </div>
        </section>
      </article>
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</DocsLayout>

<style>
  .features-page {
    width: min(100% - 2rem, 80rem);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .features-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(28rem, 1.1fr);
    gap: 2.5rem;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 3rem;
  }

  .features-eyebrow,
  .features-section__header p,
  .features-sidebar span {
    margin: 0;
    color: var(--color-brand-strong);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .features-hero h1 {
    max-width: 54rem;
    margin: 1rem 0 0;
    color: var(--color-text);
    font-size: clamp(2.35rem, 5vw, 4.25rem);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.02;
  }

  .features-hero p:not(.features-eyebrow) {
    max-width: 45rem;
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .features-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .features-hero__cta,
  .features-final-cta a:first-child {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: var(--color-brand);
    color: var(--color-inverse-text);
    font-size: 0.875rem;
    font-weight: 800;
    padding: 0 1rem;
    text-decoration: none;
  }

  .features-hero__link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-inverse-text);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0 1rem;
    text-decoration: none;
  }

  .features-hero__panel {
    display: grid;
    gap: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-inverse-text);
    padding: 1.25rem;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }

  .features-hero__panel span {
    color: var(--color-text-soft);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .features-hero__panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .features-hero__panel-header code {
    border-radius: 999px;
    background: var(--color-brand-soft);
