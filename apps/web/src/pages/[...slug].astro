---
import Layout from '../layouts/Layout.astro';
import { seoPages, type SeoPage } from '../data/seoPages';

export function getStaticPaths() {
  return seoPages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

interface Props {
  page: SeoPage;
}

const { page } = Astro.props;
const canonical = `https://fallback.pics/${page.slug}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.title,
  description: page.description,
  url: canonical,
  mainEntity: {
    '@type': 'SoftwareApplication',
    name: 'fallback.pics',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web Browser'
  },
  keywords: page.keywords
};
---

<Layout
  title={page.title}
  description={page.description}
  keywords={page.keywords.join(', ')}
  canonical={canonical}
  ogImage={`https://fallback.pics/api/v1/1200x630/7C3AED/FFFFFF?text=${encodeURIComponent(page.eyebrow)}`}
>
  <main id="main-content" class="min-h-screen bg-white">
    <header class="border-b border-gray-200 bg-white">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary">
        <a href="/" class="flex items-center gap-2 text-purple-700">
          <img src="/favicon.svg" alt="fallback.pics" class="h-8 w-8" />
          <span class="text-lg font-bold">fallback.pics</span>
        </a>
        <div class="flex items-center gap-5 text-sm font-medium text-gray-600">
          <a href="/docs" class="hover:text-purple-700">Docs</a>
          <a href="/api" class="hover:text-purple-700">API</a>
          <a href="/blog" class="hover:text-purple-700">Blog</a>
        </div>
      </nav>
    </header>

    <section class="bg-gradient-to-br from-gray-950 via-purple-950 to-blue-900 px-4 py-16 text-white sm:px-6 sm:py-24 lg:px-8">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <p class="mb-4 inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-white/90 ring-1 ring-white/20">
            {page.eyebrow}
          </p>
          <h1 class="max-w-4xl text-4xl font-black leading-tight sm:text-5xl lg:text-6xl">
            {page.h1}
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-white/85">
            {page.intro}
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#example" class="rounded-lg bg-white px-5 py-3 text-center font-bold text-purple-700 shadow-lg hover:bg-gray-100">
              Copy Example URL
            </a>
            <a href="/docs" class="rounded-lg border border-white/30 bg-white/10 px-5 py-3 text-center font-bold text-white hover:bg-white/20">
              Read Docs
            </a>
          </div>
        </div>

        <div id="example" class="rounded-2xl border border-white/15 bg-white/10 p-4 shadow-2xl backdrop-blur">
          <div class="rounded-xl bg-gray-950 p-4">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-emerald-300">Example URL</p>
            <code class="block break-all font-mono text-sm text-emerald-200">{page.exampleUrl}</code>
          </div>
          <img src={page.exampleUrl} alt={`${page.eyebrow} example generated by fallback.pics`} class="mt-4 w-full rounded-xl bg-white shadow-xl" loading="eager" />
        </div>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[minmax(0,1fr)_320px]">
        <div class="space-y-8">
          {page.sections.map((section) => (
            <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
              <h2 class="text-2xl font-bold text-gray-950">{section.heading}</h2>
              <div class="mt-4 space-y-4 text-base leading-7 text-gray-700">
                {section.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              {section.bullets && (
                <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                  {section.bullets.map((item) => (
                    <li class="rounded-lg bg-gray-50 px-4 py-3 text-sm font-medium text-gray-700">{item}</li>
                  ))}
                </ul>
              )}
              {section.code && (
                <pre class="mt-5 overflow-x-auto rounded-lg bg-gray-950 p-4 text-sm text-emerald-200"><code>{section.code}</code></pre>
              )}
            </section>
          ))}
        </div>

        <aside class="lg:sticky lg:top-8 lg:self-start">
          <div class="rounded-xl border border-purple-100 bg-purple-50 p-6">
            <h2 class="text-lg font-bold text-gray-950">Use this page for</h2>
            <ul class="mt-4 space-y-2 text-sm text-gray-700">
              {page.keywords.map((keyword) => <li>{keyword}</li>)}
            </ul>
          </div>
          <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-gray-950">Related guides</h2>
            <ul class="mt-4 space-y-3 text-sm font-medium">
              {page.links.map((link) => (
                <li><a href={link.href} class="text-purple-700 hover:text-purple-900">{link.label}</a></li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <section class="bg-gray-950 px-4 py-16 text-white sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl font-black sm:text-4xl">{page.cta}</h2>
        <div class="mt-8 rounded-xl bg-white/10 p-4">
          <code class="break-all font-mono text-sm text-emerald-200">{page.exampleUrl}</code>
        </div>
        <a href="/api" class="mt-8 inline-flex rounded-lg bg-white px-6 py-3 font-bold text-purple-700 hover:bg-gray-100">
          View API Reference
        </a>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Layout>
