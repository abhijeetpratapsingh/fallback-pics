---
import Layout from '../layouts/Layout.astro';
import { seoPages, type SeoPage } from '../data/seoPages';

export function getStaticPaths() {
  return seoPages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

interface Props {
  page: SeoPage;
}

const { page } = Astro.props;
const canonical = `https://fallback.pics/${page.slug}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.title,
  description: page.description,
  url: canonical,
  mainEntity: {
    '@type': 'SoftwareApplication',
    name: 'fallback.pics',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web Browser'
  },
  keywords: page.keywords
};
---

<Layout
  title={page.title}
  description={page.description}
  keywords={page.keywords.join(', ')}
  canonical={canonical}
  ogImage={`https://fallback.pics/api/v1/1200x630/7C3AED/FFFFFF?text=${encodeURIComponent(page.eyebrow)}`}
>
  <main id="main-content" class="seo-page min-h-screen bg-gray-50 text-gray-950">
    <section class="border-b border-gray-200 bg-white px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <p class="mb-4 inline-flex rounded-full border border-purple-200 bg-purple-50 px-3 py-1 text-xs font-semibold uppercase text-purple-700">
            {page.eyebrow}
          </p>
          <h1 class="max-w-4xl text-4xl font-bold leading-tight text-gray-950 sm:text-5xl lg:text-6xl">
            {page.h1}
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-gray-600">
            {page.intro}
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#example" class="rounded-lg bg-gray-950 px-5 py-3 text-center font-semibold text-white hover:bg-purple-700">
              Copy Example URL
            </a>
            <a href="/docs" class="rounded-lg border border-gray-300 bg-white px-5 py-3 text-center font-semibold text-gray-800 hover:border-purple-300 hover:text-purple-700">
              Read Docs
            </a>
          </div>
        </div>

        <div id="example" class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="rounded-lg bg-gray-950 p-4">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-emerald-300">Example URL</p>
            <code class="block break-all font-mono text-sm text-emerald-200">{page.exampleUrl}</code>
          </div>
          <img src={page.exampleUrl} alt={`${page.eyebrow} example generated by fallback.pics`} class="mt-4 w-full rounded-lg border border-gray-200 bg-white" loading="eager" />
        </div>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[minmax(0,1fr)_320px]">
        <div class="space-y-8">
          {page.sections.map((section) => (
            <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
              <h2 class="text-2xl font-bold text-gray-950">{section.heading}</h2>
              <div class="mt-4 space-y-4 text-base leading-7 text-gray-700">
                {section.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              {section.bullets && (
                <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                  {section.bullets.map((item) => (
                    <li class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm font-medium text-gray-700">{item}</li>
                  ))}
                </ul>
              )}
              {section.code && (
                <pre class="mt-5 overflow-x-auto rounded-lg bg-gray-950 p-4 text-sm text-emerald-200"><code>{section.code}</code></pre>
              )}
            </section>
          ))}
        </div>

        <aside class="lg:sticky lg:top-8 lg:self-start">
          <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-gray-950">Use this page for</h2>
            <ul class="mt-4 space-y-2 text-sm text-gray-700">
              {page.keywords.map((keyword) => <li>{keyword}</li>)}
            </ul>
          </div>
          <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-gray-950">Related guides</h2>
            <ul class="mt-4 space-y-3 text-sm font-medium">
              {page.links.map((link) => (
                <li><a href={link.href} class="text-purple-700 hover:text-purple-900">{link.label}</a></li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <section class="border-t border-gray-200 bg-gray-950 px-4 py-16 text-white sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl font-bold sm:text-4xl">{page.cta}</h2>
        <div class="mt-8 rounded-xl border border-white/10 bg-white/10 p-4">
          <code class="break-all font-mono text-sm text-emerald-200">{page.exampleUrl}</code>
        </div>
        <a href="/api" class="mt-8 inline-flex rounded-lg bg-white px-6 py-3 font-semibold text-gray-950 hover:bg-gray-100">
          View API Reference
        </a>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Layout>

<style>
  .seo-page {
    font-feature-settings: "kern";
    overflow-x: clip;
  }

  .seo-page pre {
    max-width: 100%;
    overflow-x: auto;
  }

  .seo-page :where(.grid, .space-y-8, section, aside, pre, code) {
    min-width: 0;
    max-width: 100%;
  }

  @media (max-width: 640px) {
    .seo-page h1 {
      font-size: 2.25rem;
    }

    .seo-page section {
      overflow-wrap: anywhere;
    }

    .seo-page code {
      overflow-wrap: anywhere;
    }
  }
</style>
