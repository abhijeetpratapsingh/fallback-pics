---
import Layout from '../layouts/Layout.astro';
import EnterpriseLanding from '../components/EnterpriseLanding';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'fallback.pics',
  description:
    'Placeholder image API and fallback image service for production applications. Generate cacheable placeholder images, avatars, banners, and skeleton states from simple URLs.',
  url: 'https://fallback.pics',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web Browser',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  creator: {
    '@type': 'Organization',
    name: 'fallback.pics',
  },
  keywords: [
    'fallback image infrastructure',
    'placeholder image api',
    'placeholder image generator',
    'placeholder image',
    'broken image fallback',
    'image placeholder service',
    'production fallback images',
    'Cloudflare Workers image API',
  ],
};
---

<Layout
  title="Placeholder Image API and Fallback Image Generator | fallback.pics"
  description="Generate placeholder images and fallback images from simple URLs. fallback.pics is a placeholder image API and generator for stable product, docs, and mockup media."
  keywords="placeholder image API, placeholder image generator, placeholder image, image placeholder, fallback image, broken image fallback, SVG placeholder image"
  ogImage="https://fallback.pics/api/v1/1200x630/18181B/FFFFFF?text=Placeholder+Image+API"
>
  <EnterpriseLanding client:load />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
</Layout>
