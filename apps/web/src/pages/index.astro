---
import Layout from '../layouts/Layout.astro';
import LiveDemoEnhanced from '../components/LiveDemoEnhanced';
import CodeExamplesEnhanced from '../components/CodeExamplesEnhanced';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "fallback.pics",
  "description": "SVG-first placeholder image API for developers. Generate stable placeholder images and broken image fallbacks from simple URLs.",
  "url": "https://fallback.pics",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Web Browser",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  },
  "creator": {
    "@type": "Organization",
    "name": "ABHIJEET PRATAP SINGH"
  },
  "keywords": ["placeholder image api", "broken image fallback", "dummy image generator", "developer tools", "web development", "SVG"],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "1"
  }
};

const seoLandingLinks = [
  { href: '/placeholder-image-api', title: 'Placeholder Image API', description: 'Generate SVG placeholders from readable URLs for apps, docs, CMS content, and product UI.' },
  { href: '/broken-image-fallback', title: 'Broken Image Fallback', description: 'Replace failed product, avatar, and CMS images with controlled fallback states.' },
  { href: '/dummy-image-generator', title: 'Dummy Image Generator', description: 'Create predictable dummy images for mockups, seed data, docs, and staging.' },
  { href: '/product-image-placeholder', title: 'Product Image Placeholder', description: 'Keep ecommerce grids and product cards clean when catalog media is missing.' },
  { href: '/avatar-placeholder-generator', title: 'Avatar Placeholder Generator', description: 'Generate initials-based SVG avatar placeholders for profiles, teams, and dashboards.' },
  { href: '/skeleton-placeholder-generator', title: 'Skeleton Placeholder Generator', description: 'Use SVG skeleton placeholders for loading media, demos, and design-system examples.' },
  { href: '/guides/react-image-fallback', title: 'React Image Fallback', description: 'Handle failed image loads in React with a reusable fallback pattern.' },
  { href: '/guides/nextjs-image-fallback', title: 'Next.js Image Fallback', description: 'Use stable fallback URLs for missing images in Next.js apps.' },
  { href: '/alternatives/placehold-co-alternative', title: 'Placehold.co Alternative', description: 'Compare fallback.pics with Placehold.co for production fallback use cases.' },
  { href: '/alternatives/dummyimage-alternative', title: 'DummyImage Alternative', description: 'Compare fallback.pics with DummyImage for modern frontend workflows.' }
];

const heroGridBackground =
  "background-image: url('data:image/svg+xml,%3Csvg width%3D%2260%22 height%3D%2260%22 xmlns%3D%22http://www.w3.org/2000/svg%22%3E%3Cdefs%3E%3Cpattern id%3D%22grid%22 width%3D%2260%22 height%3D%2260%22 patternUnits%3D%22userSpaceOnUse%22%3E%3Cpath d%3D%22M 60 0 L 0 0 0 60%22 fill%3D%22none%22 stroke%3D%22white%22 stroke-width%3D%221%22 opacity%3D%220.3%22/%3E%3C/pattern%3E%3C/defs%3E%3Crect width%3D%22100%25%22 height%3D%22100%25%22 fill%3D%22url(%23grid)%22/%3E%3C/svg%3E');";
---

<Layout
  title="Placeholder Image API for Broken Image Fallbacks | fallback.pics"
  description="Generate fast SVG placeholder images with simple URLs. Use fallback.pics for product images, avatars, skeletons, dummy images, and broken image fallback states."
  keywords="placeholder image api, image placeholder api, broken image fallback, fallback image service, dummy image generator, product image placeholder, avatar placeholder generator, skeleton placeholder generator"
  ogImage="https://fallback.pics/api/v1/1200x630/7C3AED/FFFFFF?text=Placeholder+Image+API"
>
  <!-- Import modern styles -->
  <link rel="stylesheet" href="/src/styles/modern-ui.css" />
  <link rel="stylesheet" href="/src/styles/accessibility.css" />
  <!-- Hero Section with Animated Background -->
  <main id="main-content">
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-purple-900 via-purple-700 to-blue-600 py-12 sm:py-0" role="banner" aria-labelledby="hero-heading">
    <!-- Animated Background Pattern -->
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0" style={heroGridBackground}></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 text-center">
      <!-- Logo/Brand -->
      <div class="mb-6 sm:mb-8 inline-flex items-center justify-center">
        <div class="relative">
          <div class="absolute inset-0 bg-white/20 blur-2xl sm:blur-3xl rounded-full" aria-hidden="true"></div>
          <img src="/favicon.svg" alt="fallback.pics logo" class="relative w-20 h-20 sm:w-24 sm:h-24 md:w-32 md:h-32" />
        </div>
      </div>

      <!-- Main Heading with Enhanced Animation -->
      <h1 id="hero-heading" class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-white mb-4 sm:mb-6 animate-fade-in leading-tight" style="letter-spacing: -0.05em; line-height: 0.95;">
        Placeholder Image API<br />
        <span class="bg-gradient-to-r from-yellow-400 to-orange-500 bg-clip-text text-transparent">for Broken Image</span><br />
        Fallbacks
      </h1>

      <!-- Subheading -->
      <p class="text-base sm:text-xl md:text-2xl text-white/90 mb-6 sm:mb-12 max-w-3xl mx-auto leading-relaxed">
        Generate SVG placeholders, product fallbacks, avatars, and skeleton states from simple URLs.<br class="sm:hidden" />
        <span class="font-semibold">No SDK</span>, <span class="font-semibold">stable dimensions</span>, <span class="font-semibold">developer-friendly API</span>.
      </p>

      <!-- CTA Buttons with Enhanced Animations -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center mb-8 sm:mb-12">
        <a href="#playground" class="btn-magnetic group relative px-6 sm:px-8 py-3.5 sm:py-4 bg-white text-purple-700 font-bold rounded-xl shadow-xl hover:shadow-2xl transform transition-all duration-200 text-base sm:text-base focus:outline-none focus:ring-4 focus:ring-purple-400" aria-label="Try the interactive playground">
          <span class="relative z-10">Try It Now →</span>
        </a>
        <a href="/docs" class="px-6 sm:px-8 py-3.5 sm:py-4 bg-white/20 backdrop-blur-md text-white font-bold rounded-xl border border-white/40 hover:bg-white/30 transition-all duration-200 text-base sm:text-base focus:outline-none focus:ring-4 focus:ring-white/70" aria-label="View complete documentation">
          View Documentation
        </a>
        <a href="https://github.com/abhijeetpratapsingh/fallback-pics" target="_blank" rel="noopener noreferrer" class="px-6 sm:px-8 py-3.5 sm:py-4 bg-black/30 backdrop-blur-md text-white font-bold rounded-xl border border-white/20 hover:bg-black/40 transition-all duration-200 flex items-center justify-center gap-2 text-base sm:text-base focus:outline-none focus:ring-4 focus:ring-white/70" aria-label="View project on GitHub (opens in new tab)">
          <svg class="w-4 sm:w-5 h-4 sm:h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          <span class="hidden sm:inline">Star on GitHub</span>
          <span class="sm:hidden">GitHub</span>
        </a>
      </div>

      <!-- Live Example with Float Animation -->
      <div class="glass-card bg-white/10 backdrop-blur-xl rounded-xl p-3 sm:p-6 md:p-8 max-w-4xl mx-auto border border-white/20 shadow-2xl float-animation" role="region" aria-label="Live code example">
        <div class="text-left mb-2 sm:mb-4">
          <span class="text-white/90 text-xs font-mono">// Just use our URL directly</span>
        </div>
        <div class="bg-black/40 rounded-lg p-2 sm:p-4 mb-3 sm:mb-6 overflow-x-auto">
          <code class="text-green-400 font-mono text-[10px] sm:text-sm md:text-base block">
            &lt;img src="https://fallback.pics/api/v1/800x400" alt="Hero"&gt;
          </code>
        </div>
        <img src="https://fallback.pics/api/v1/800x400/7C3AED/FFFFFF?text=Your+Image+Here" alt="Example placeholder image showing 'Your Image Here' text on purple background" class="w-full rounded-lg shadow-xl" loading="lazy" />
      </div>

      <!-- Stats with Counter Animation -->
      <div class="mt-12 sm:mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 fade-in-scroll">
        <div class="text-center">
          <div class="text-2xl sm:text-4xl md:text-5xl font-bold text-white mb-1 sm:mb-2">SVG</div>
          <div class="text-white/90 text-xs sm:text-sm font-medium">First Output</div>
        </div>
        <div class="text-center">
          <div class="text-2xl sm:text-4xl md:text-5xl font-bold text-white mb-1 sm:mb-2">URL</div>
          <div class="text-white/90 text-xs sm:text-sm font-medium">Based API</div>
        </div>
        <div class="text-center">
          <div class="text-2xl sm:text-4xl md:text-5xl font-bold text-white mb-1 sm:mb-2">OSS</div>
          <div class="text-white/90 text-xs sm:text-sm font-medium">Self-Hostable</div>
        </div>
        <div class="text-center">
          <div class="text-2xl sm:text-4xl md:text-5xl font-bold text-white mb-1 sm:mb-2">$0</div>
          <div class="text-white/90 text-xs sm:text-sm font-medium">Starter URL</div>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce hidden sm:block" aria-hidden="true">
      <svg class="w-6 h-6 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-label="Scroll down indicator">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- Quick Start Examples -->
  <section class="py-16 sm:py-24 px-4 bg-gradient-to-b from-white via-purple-50/30 to-white" role="region" aria-labelledby="examples-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 id="examples-heading" class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Quick Start <span class="bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent">Examples</span>
        </h2>
        <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto">
          Copy any URL below and start using it immediately. No signup required.
        </p>
      </div>

      <!-- Examples Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Basic Placeholder -->
        <div class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-blue-500 to-cyan-500 p-4">
            <h3 class="text-white font-semibold text-lg">Basic Placeholder</h3>
          </div>
          <div class="p-6">
            <div class="mb-4 relative">
              <img 
                src="https://fallback.pics/api/v1/400x250" 
                alt="Basic placeholder example" 
                class="w-full rounded-lg shadow-sm"
                loading="lazy"
              />
              <div class="absolute top-2 right-2 bg-black/70 text-white text-xs px-2 py-1 rounded">
                400×250
              </div>
            </div>
            <div class="bg-gray-900 rounded-lg p-3 relative group/code">
              <code class="text-xs text-green-400 font-mono block overflow-x-auto">
                https://fallback.pics/api/v1/400x250
              </code>
              <button 
                onclick="navigator.clipboard.writeText('https://fallback.pics/api/v1/400x250'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 2000)"
                class="absolute top-2 right-2 bg-green-500 hover:bg-green-600 text-white text-xs px-2 py-1 rounded opacity-0 group-hover/code:opacity-100 transition-opacity"
              >
                Copy
              </button>
            </div>
          </div>
        </div>

        <!-- Custom Colors -->
        <div class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-purple-500 to-pink-500 p-4">
            <h3 class="text-white font-semibold text-lg">Custom Colors</h3>
          </div>
          <div class="p-6">
            <div class="mb-4 relative">
              <img 
                src="https://fallback.pics/api/v1/400x250/FF6B6B/FFFFFF" 
                alt="Custom colors example" 
                class="w-full rounded-lg shadow-sm"
                loading="lazy"
              />
              <div class="absolute top-2 right-2 bg-black/70 text-white text-xs px-2 py-1 rounded">
                Custom BG/Text
              </div>
            </div>
            <div class="bg-gray-900 rounded-lg p-3 relative group/code">
              <code class="text-xs text-purple-400 font-mono block overflow-x-auto">
                https://fallback.pics/api/v1/400x250/FF6B6B/FFFFFF
              </code>
              <button 
                onclick="navigator.clipboard.writeText('https://fallback.pics/api/v1/400x250/FF6B6B/FFFFFF'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 2000)"
                class="absolute top-2 right-2 bg-purple-500 hover:bg-purple-600 text-white text-xs px-2 py-1 rounded opacity-0 group-hover/code:opacity-100 transition-opacity"
              >
                Copy
              </button>
            </div>
          </div>
        </div>

        <!-- Custom Text -->
        <div class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-green-500 to-emerald-500 p-4">
            <h3 class="text-white font-semibold text-lg">Custom Text</h3>
          </div>
          <div class="p-6">
            <div class="mb-4 relative">
              <img 
                src="https://fallback.pics/api/v1/400x250?text=Product+Image" 
                alt="Custom text example" 
                class="w-full rounded-lg shadow-sm"
                loading="lazy"
              />
              <div class="absolute top-2 right-2 bg-black/70 text-white text-xs px-2 py-1 rounded">
                With Text
              </div>
            </div>
            <div class="bg-gray-900 rounded-lg p-3 relative group/code">
              <code class="text-xs text-green-400 font-mono block overflow-x-auto">
                https://fallback.pics/api/v1/400x250?text=Product+Image
              </code>
              <button 
                onclick="navigator.clipboard.writeText('https://fallback.pics/api/v1/400x250?text=Product+Image'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 2000)"
                class="absolute top-2 right-2 bg-green-500 hover:bg-green-600 text-white text-xs px-2 py-1 rounded opacity-0 group-hover/code:opacity-100 transition-opacity"
              >
                Copy
              </button>
            </div>
          </div>
        </div>

        <!-- Avatar -->
        <div class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-indigo-500 to-purple-500 p-4">
            <h3 class="text-white font-semibold text-lg">Avatar Placeholder</h3>
          </div>
          <div class="p-6">
            <div class="mb-4 relative flex justify-center">
              <img 
                src="https://fallback.pics/api/v1/avatar/150?text=JD" 
                alt="Avatar example" 
                class="rounded-full shadow-lg"
                loading="lazy"
                style="width: 150px; height: 150px;"
              />
              <div class="absolute top-2 right-2 bg-black/70 text-white text-xs px-2 py-1 rounded">
                Avatar
              </div>
            </div>
            <div class="bg-gray-900 rounded-lg p-3 relative group/code">
              <code class="text-xs text-indigo-400 font-mono block overflow-x-auto">
                https://fallback.pics/api/v1/avatar/150?text=JD
              </code>
              <button 
                onclick="navigator.clipboard.writeText('https://fallback.pics/api/v1/avatar/150?text=JD'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 2000)"
                class="absolute top-2 right-2 bg-indigo-500 hover:bg-indigo-600 text-white text-xs px-2 py-1 rounded opacity-0 group-hover/code:opacity-100 transition-opacity"
              >
                Copy
              </button>
            </div>
          </div>
        </div>

        <!-- Animated Skeleton -->
        <div class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-orange-500 to-red-500 p-4">
            <h3 class="text-white font-semibold text-lg">Animated Loading</h3>
            <span class="text-xs bg-white/20 px-2 py-0.5 rounded text-white">CSS Only</span>
          </div>
          <div class="p-6">
            <div class="mb-4 relative">
              <img 
                src="https://fallback.pics/api/v1/animated/skeleton/400x250" 
                alt="Skeleton loader example" 
                class="w-full rounded-lg shadow-sm"
                loading="lazy"
              />
              <div class="absolute top-2 right-2 bg-black/70 text-white text-xs px-2 py-1 rounded">
                Animated
              </div>
            </div>
            <div class="bg-gray-900 rounded-lg p-3 relative group/code">
              <code class="text-xs text-orange-400 font-mono block overflow-x-auto">
                https://fallback.pics/api/v1/animated/skeleton/400x250
              </code>
              <button 
                onclick="navigator.clipboard.writeText('https://fallback.pics/api/v1/animated/skeleton/400x250'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 2000)"
                class="absolute top-2 right-2 bg-orange-500 hover:bg-orange-600 text-white text-xs px-2 py-1 rounded opacity-0 group-hover/code:opacity-100 transition-opacity"
              >
                Copy
              </button>
            </div>
          </div>
        </div>

        <!-- Chart Mockup -->
        <div class="group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-cyan-500 to-blue-500 p-4">
            <h3 class="text-white font-semibold text-lg">Chart Mockup</h3>
            <span class="text-xs bg-white/20 px-2 py-0.5 rounded text-white">Data Viz</span>
          </div>
          <div class="p-6">
            <div class="mb-4 relative">
              <img 
                src="https://fallback.pics/api/v1/chart/bar/400x250" 
                alt="Bar chart example" 
                class="w-full rounded-lg shadow-sm"
                loading="lazy"
              />
              <div class="absolute top-2 right-2 bg-black/70 text-white text-xs px-2 py-1 rounded">
                Bar Chart
              </div>
            </div>
            <div class="bg-gray-900 rounded-lg p-3 relative group/code">
              <code class="text-xs text-cyan-400 font-mono block overflow-x-auto">
                https://fallback.pics/api/v1/chart/bar/400x250
              </code>
              <button 
                onclick="navigator.clipboard.writeText('https://fallback.pics/api/v1/chart/bar/400x250'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 2000)"
                class="absolute top-2 right-2 bg-cyan-500 hover:bg-cyan-600 text-white text-xs px-2 py-1 rounded opacity-0 group-hover/code:opacity-100 transition-opacity"
              >
                Copy
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- CTA -->
      <div class="text-center mt-12">
        <a 
          href="/docs" 
          class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-600 text-white font-semibold rounded-xl hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200"
        >
          View All Options
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-12 sm:py-20 px-4 bg-white" role="region" aria-labelledby="features-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-8 sm:mb-16">
        <h2 id="features-heading" class="text-2xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-3 sm:mb-4">
          Everything You Need, <span class="text-purple-600">Nothing You Don't</span>
        </h2>
        <p class="text-base sm:text-xl text-gray-600 max-w-3xl mx-auto">
          Built for developers who value simplicity, speed, and privacy.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-8">
        <!-- Feature Cards with Enhanced Effects -->
        <div class="group relative glass-card bg-gradient-to-br from-purple-50 to-blue-50 p-6 sm:p-8 rounded-2xl hover:shadow-2xl transition-all duration-300 sm:hover:-translate-y-2 slide-up-scroll">
          <div class="absolute top-0 right-0 -mt-2 -mr-2 sm:-mt-4 sm:-mr-4 bg-purple-500 text-white text-xs font-bold px-2 sm:px-3 py-1 rounded-full">NEW</div>
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2 sm:mb-3">Contextual SVG Patterns</h3>
          <p class="text-sm sm:text-base text-gray-600 mb-3 sm:mb-4">Context-aware patterns for any industry. E-commerce, tech, healthcare, and more.</p>
          <a href="/docs#ai" class="text-purple-600 font-semibold hover:text-purple-700 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-purple-400 focus:ring-offset-2 rounded" aria-label="Learn more about contextual SVG patterns">Learn more →</a>
        </div>

        <div class="group relative glass-card bg-gradient-to-br from-green-50 to-teal-50 p-6 sm:p-8 rounded-2xl hover:shadow-2xl transition-all duration-300 sm:hover:-translate-y-2 slide-up-scroll" style="animation-delay: 0.1s;">
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2 sm:mb-3">Animated Placeholders</h3>
          <p class="text-sm sm:text-base text-gray-600 mb-3 sm:mb-4">6 CSS-only animations: skeleton, pulse, wave, shimmer, gradient, dots.</p>
          <a href="/docs#animations" class="text-green-600 font-semibold hover:text-green-700 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-green-400 focus:ring-offset-2 rounded" aria-label="See available animations">See animations →</a>
        </div>

        <div class="group relative glass-card bg-gradient-to-br from-blue-50 to-indigo-50 p-6 sm:p-8 rounded-2xl hover:shadow-2xl transition-all duration-300 sm:hover:-translate-y-2 slide-up-scroll" style="animation-delay: 0.2s;">
