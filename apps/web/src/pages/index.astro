---
import Layout from '../layouts/Layout.astro';
import EnterpriseLanding from '../components/EnterpriseLanding';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'fallback.pics',
  description:
    'Global fallback image infrastructure for production applications. Generate cacheable placeholder images, avatars, banners, and skeleton states from simple URLs.',
  url: 'https://fallback.pics',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web Browser',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  creator: {
    '@type': 'Organization',
    name: 'fallback.pics',
  },
  keywords: [
    'fallback image infrastructure',
    'placeholder image api',
    'broken image fallback',
    'image placeholder service',
    'production fallback images',
    'Cloudflare Workers image API',
  ],
};
---

<Layout
  title="Fallback Image Infrastructure for Production Apps | fallback.pics"
  description="Global fallback image infrastructure for production-grade applications. Generate reliable, cacheable, brand-safe fallback images from simple URLs."
  keywords="fallback image infrastructure, placeholder image api, broken image fallback, production image fallback, image placeholder service, fallback images, Cloudflare Workers"
  ogImage="https://fallback.pics/api/v1/1200x630/18181B/FFFFFF?text=Fallback+Image+Infrastructure"
  header="landing"
>
  <EnterpriseLanding client:load />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
</Layout>
