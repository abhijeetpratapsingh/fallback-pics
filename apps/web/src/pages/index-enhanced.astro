---
import Layout from '../layouts/Layout.astro';
import LiveDemo from '../components/LiveDemo';
import CodeExamples from '../components/CodeExamples';
import InteractivePlayground from '../components/InteractivePlayground';
import config from '../config';

// Meta tags for SEO
const metaTags = {
  title: 'Fallback.pics - Lightning-Fast Placeholder Images API',
  description: 'Generate instant placeholder images with our simple API. AI-powered, fully customizable, no tracking. Perfect for developers who value speed and privacy.',
  keywords: 'placeholder images, fallback images, developer API, image placeholder service, dummy images, mockup images',
  ogImage: 'https://fallback.pics/api/v1/1200x630?text=Fallback.pics',
};
---

<Layout 
  title={metaTags.title}
  description={metaTags.description}
  keywords={metaTags.keywords}
  ogImage={metaTags.ogImage}
>
  <!-- Skip to main content for accessibility -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue-600 text-white px-4 py-2 rounded-md z-50">
    Skip to main content
  </a>

  <!-- Hero Section with Live Demo -->
  <section class="relative min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 overflow-hidden" role="banner">
    <!-- Animated background pattern -->
    <div class="absolute inset-0 bg-grid-white/[0.05] bg-[size:50px_50px]" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/50 to-transparent" aria-hidden="true"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-32">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Text Content -->
        <div class="text-center lg:text-left">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
            Never Show
            <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent"> Broken Images</span>
            <br />Ever Again
          </h1>
          
          <p class="text-xl text-gray-300 mb-8 leading-relaxed">
            Lightning-fast placeholder images that work instantly. No signup, no API key, just add our URL to your img src.
          </p>
          
          <!-- Key Features -->
          <div class="grid grid-cols-2 gap-4 mb-8">
            <div class="flex items-center space-x-2 text-gray-300">
              <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>&lt;50ms Response</span>
            </div>
            <div class="flex items-center space-x-2 text-gray-300">
              <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>AI-Powered</span>
            </div>
            <div class="flex items-center space-x-2 text-gray-300">
              <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Zero Tracking</span>
            </div>
            <div class="flex items-center space-x-2 text-gray-300">
              <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Free Forever</span>
            </div>
          </div>
          
          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a 
              href="#quick-start" 
              class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-gradient-to-r from-blue-600 to-cyan-600 rounded-xl hover:from-blue-700 hover:to-cyan-700 transform hover:scale-105 transition-all duration-200 focus:outline-none focus:ring-4 focus:ring-blue-500 focus:ring-opacity-50"
              aria-label="Get started with Fallback.pics"
            >
              Generate Your First Image
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
            <a 
              href="/docs" 
              class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-gray-300 border-2 border-gray-600 rounded-xl hover:bg-gray-800 hover:border-gray-500 transition-all duration-200 focus:outline-none focus:ring-4 focus:ring-gray-500 focus:ring-opacity-50"
              aria-label="View API documentation"
            >
              View API Docs
            </a>
          </div>
        </div>
        
        <!-- Right: Live Demo -->
        <div class="relative">
          <div class="bg-slate-800/50 backdrop-blur-sm rounded-2xl p-6 border border-slate-700">
            <h2 class="text-lg font-semibold text-gray-300 mb-4">Live Example</h2>
            
            <!-- Code snippet with syntax highlighting -->
            <div class="bg-slate-900 rounded-lg p-4 mb-4 relative group">
              <pre class="text-sm overflow-x-auto"><code class="language-html text-gray-300"><span class="text-blue-400">&lt;img</span> <span class="text-green-400">src</span>=<span class="text-yellow-400">"https://fallback.pics/api/v1/600x400"</span>
     <span class="text-green-400">alt</span>=<span class="text-yellow-400">"Product placeholder"</span> <span class="text-blue-400">/&gt;</span></code></pre>
              <button 
                onclick="navigator.clipboard.writeText('https://fallback.pics/api/v1/600x400'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 2000)"
                class="absolute top-2 right-2 bg-blue-600 hover:bg-blue-700 text-white text-xs px-3 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity focus:outline-none focus:ring-2 focus:ring-blue-500"
                aria-label="Copy URL to clipboard"
              >
                Copy
              </button>
            </div>
            
            <!-- Live preview -->
            <div class="rounded-lg overflow-hidden">
              <img 
                src="https://fallback.pics/api/v1/600x400?text=Live+Demo" 
                alt="Live demo showing a 600x400 placeholder image"
                class="w-full h-auto"
                loading="eager"
              />
            </div>
            
            <p class="text-sm text-gray-400 mt-4 text-center">
              This image loads in &lt;50ms from 200+ global locations
            </p>
          </div>
        </div>
      </div>
      
      <!-- Stats -->
      <div class="mt-20 grid grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-4xl lg:text-5xl font-bold text-white mb-2">&lt;50ms</div>
          <div class="text-gray-400">Response Time</div>
        </div>
        <div class="text-center">
          <div class="text-4xl lg:text-5xl font-bold text-white mb-2">200+</div>
          <div class="text-gray-400">CDN Locations</div>
        </div>
        <div class="text-center">
          <div class="text-4xl lg:text-5xl font-bold text-white mb-2">∞</div>
          <div class="text-gray-400">Images/Month</div>
        </div>
        <div class="text-center">
          <div class="text-4xl lg:text-5xl font-bold text-white mb-2">$0</div>
          <div class="text-gray-400">Forever Free</div>
        </div>
      </div>
    </div>
  </section>

  <main id="main-content">
    <!-- Quick Start Section with Visual Examples -->
    <section id="quick-start" class="py-20 bg-gradient-to-b from-white to-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
            Quick Start Examples
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Copy any example below and use it immediately. Each example shows a live preview of the generated image.
          </p>
        </div>
        
        <!-- Interactive Examples Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Example cards with live previews -->
          ${['basic', 'colors', 'text', 'avatar', 'animated', 'chart'].map((type, i) => {
            const examples = {
              basic: {
                title: 'Basic Placeholder',
                url: 'https://fallback.pics/api/v1/400x250',
                description: 'Simple placeholder with default colors',
                gradient: 'from-blue-500 to-cyan-500',
              },
              colors: {
                title: 'Custom Colors',
                url: 'https://fallback.pics/api/v1/400x250/FF6B6B/FFFFFF',
                description: 'Background and text color customization',
                gradient: 'from-purple-500 to-pink-500',
              },
              text: {
                title: 'Custom Text',
                url: 'https://fallback.pics/api/v1/400x250?text=Product+Image',
                description: 'Add custom text to your placeholders',
                gradient: 'from-green-500 to-emerald-500',
              },
              avatar: {
                title: 'Avatar',
                url: 'https://fallback.pics/api/v1/avatar/150?text=JD',
                description: 'Perfect for user profile placeholders',
                gradient: 'from-indigo-500 to-purple-500',
              },
              animated: {
                title: 'Animated Loading',
                url: 'https://fallback.pics/api/v1/animated/skeleton/400x250',
                description: 'CSS-only animated loading states',
                gradient: 'from-orange-500 to-red-500',
              },
              chart: {
                title: 'Chart Mockup',
                url: 'https://fallback.pics/api/v1/chart/bar/400x250',
                description: 'Data visualization placeholders',
                gradient: 'from-cyan-500 to-blue-500',
              },
            };
            
            const example = examples[type];
            return `
              <article class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden group">
                <div class="bg-gradient-to-r ${example.gradient} p-4">
                  <h3 class="text-white font-semibold text-lg">${example.title}</h3>
                </div>
                <div class="p-6">
                  <!-- Live Preview -->
                  <div class="mb-4 rounded-lg overflow-hidden bg-gray-50 ${type === 'avatar' ? 'flex justify-center p-4' : ''}">
                    <img 
                      src="${example.url}" 
                      alt="${example.description}"
                      class="${type === 'avatar' ? 'rounded-full' : 'w-full h-auto'}"
                      ${type === 'avatar' ? 'style="width: 150px; height: 150px;"' : ''}
                      loading="lazy"
                    />
                  </div>
                  
                  <!-- Description -->
                  <p class="text-sm text-gray-600 mb-4">${example.description}</p>
                  
                  <!-- Code with Copy -->
                  <div class="bg-gray-900 rounded-lg p-3 relative group/code">
                    <code class="text-xs text-green-400 font-mono block overflow-x-auto">
                      ${example.url}
                    </code>
                    <button 
                      onclick="navigator.clipboard.writeText('${example.url}'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 2000)"
                      class="absolute top-1 right-1 bg-green-600 hover:bg-green-700 text-white text-xs px-2 py-1 rounded opacity-0 group-hover/code:opacity-100 transition-opacity focus:outline-none focus:ring-2 focus:ring-green-500"
                      aria-label="Copy ${example.title} URL"
                    >
                      Copy
                    </button>
                  </div>
                </div>
              </article>
            `;
          }).join('')}
        </div>
        
        <!-- CTA -->
        <div class="text-center mt-12">
          <a 
            href="#playground" 
            class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-cyan-600 text-white font-semibold rounded-xl hover:shadow-lg transform hover:scale-105 transition-all duration-200 focus:outline-none focus:ring-4 focus:ring-blue-500 focus:ring-opacity-50"
            aria-label="Try the interactive playground"
          >
            Try Interactive Playground
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Interactive Playground -->
    <section id="playground" class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
            Interactive Playground
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Customize parameters and see real-time previews. Copy the generated URL when you're happy with the result.
          </p>
        </div>
        
        <InteractivePlayground client:load />
      </div>
    </section>

    <!-- Features Section with Icons -->
    <section class="py-20 bg-gradient-to-b from-gray-50 to-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
            Why Developers Love Fallback.pics
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Built for modern web development with performance, privacy, and simplicity in mind.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Feature cards with proper icons -->
          ${[
            {
              title: 'Lightning Fast',
              description: 'Edge computing with <50ms response time from 200+ CDN locations worldwide.',
              icon: 'M13 10V3L4 14h7v7l9-11h-7z',
              color: 'text-yellow-500',
              bg: 'bg-yellow-50',
            },
            {
              title: 'AI-Powered',
              description: 'Context-aware patterns for e-commerce, tech, healthcare, and more industries.',
              icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
              color: 'text-purple-500',
              bg: 'bg-purple-50',
            },
            {
              title: 'Privacy First',
              description: 'Zero tracking, zero cookies, GDPR compliant. Your data stays private.',
              icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
              color: 'text-green-500',
              bg: 'bg-green-50',
            },
            {
              title: 'Fully Customizable',
              description: 'Colors, text, fonts, formats. Support for SVG, PNG, JPEG, WebP, and more.',
              icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
              color: 'text-blue-500',
              bg: 'bg-blue-50',
            },
            {
              title: 'Animated Placeholders',
              description: '6 CSS-only animations including skeleton, pulse, wave, and shimmer effects.',
              icon: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
              color: 'text-pink-500',
              bg: 'bg-pink-50',
            },
            {
              title: 'Chart Mockups',
              description: '8 chart types for dashboard prototypes including bar, pie, line, and area charts.',
              icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
              color: 'text-indigo-500',
              bg: 'bg-indigo-50',
            },
          ].map(feature => `
            <article class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 group hover:-translate-y-1">
              <div class="${feature.bg} ${feature.color} rounded-lg p-3 inline-block mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${feature.icon}" />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-3">${feature.title}</h3>
              <p class="text-gray-600">${feature.description}</p>
            </article>
          `).join('')}
        </div>
      </div>
    </section>

    <!-- API Documentation -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
            API Reference
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Complete documentation for all parameters and options.
          </p>
        </div>
        
        <!-- API Table -->
        <div class="bg-gray-50 rounded-2xl p-8 overflow-x-auto">
          <table class="w-full min-w-[600px]">
            <thead>
              <tr class="border-b-2 border-gray-200">
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Parameter</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Type</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Description</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Example</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr class="hover:bg-white transition-colors">
                <td class="py-3 px-4"><code class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">width</code></td>
                <td class="py-3 px-4 text-gray-600">number</td>
                <td class="py-3 px-4 text-gray-600">Image width (10-4000px)</td>
                <td class="py-3 px-4"><code class="text-sm bg-gray-100 px-2 py-1 rounded">400</code></td>
              </tr>
              <tr class="hover:bg-white transition-colors">
                <td class="py-3 px-4"><code class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">height</code></td>
                <td class="py-3 px-4 text-gray-600">number</td>
                <td class="py-3 px-4 text-gray-600">Image height (10-4000px)</td>
                <td class="py-3 px-4"><code class="text-sm bg-gray-100 px-2 py-1 rounded">300</code></td>
              </tr>
              <tr class="hover:bg-white transition-colors">
                <td class="py-3 px-4"><code class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">text</code></td>
                <td class="py-3 px-4 text-gray-600">string</td>
                <td class="py-3 px-4 text-gray-600">Custom text to display</td>
                <td class="py-3 px-4"><code class="text-sm bg-gray-100 px-2 py-1 rounded">?text=Hello+World</code></td>
              </tr>
              <tr class="hover:bg-white transition-colors">
                <td class="py-3 px-4"><code class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">bg</code></td>
                <td class="py-3 px-4 text-gray-600">hex</td>
                <td class="py-3 px-4 text-gray-600">Background color (without #)</td>
                <td class="py-3 px-4"><code class="text-sm bg-gray-100 px-2 py-1 rounded">?bg=FF0000</code></td>
              </tr>
              <tr class="hover:bg-white transition-colors">
                <td class="py-3 px-4"><code class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">fg</code></td>
                <td class="py-3 px-4 text-gray-600">hex</td>
                <td class="py-3 px-4 text-gray-600">Text color (without #)</td>
                <td class="py-3 px-4"><code class="text-sm bg-gray-100 px-2 py-1 rounded">?fg=FFFFFF</code></td>
              </tr>
              <tr class="hover:bg-white transition-colors">
                <td class="py-3 px-4"><code class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">context</code></td>
                <td class="py-3 px-4 text-gray-600">string</td>
                <td class="py-3 px-4 text-gray-600">AI context (e-commerce, tech, blog, etc.)</td>
                <td class="py-3 px-4"><code class="text-sm bg-gray-100 px-2 py-1 rounded">?context=blog</code></td>
              </tr>
              <tr class="hover:bg-white transition-colors">
                <td class="py-3 px-4"><code class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">mood</code></td>
                <td class="py-3 px-4 text-gray-600">string</td>
                <td class="py-3 px-4 text-gray-600">AI mood (minimal, professional, vibrant)</td>
                <td class="py-3 px-4"><code class="text-sm bg-gray-100 px-2 py-1 rounded">?mood=minimal</code></td>
              </tr>
            </tbody>
          </table>
        </div>
        
        <!-- View Full Docs CTA -->
        <div class="text-center mt-8">
          <a 
            href="/docs" 
            class="inline-flex items-center text-blue-600 hover:text-blue-700 font-semibold focus:outline-none focus:underline"
            aria-label="View complete API documentation"
          >
            View Complete Documentation
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-gradient-to-b from-gray-50 to-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
            Frequently Asked Questions
          </h2>
          <p class="text-xl text-gray-600">
            Everything you need to know about Fallback.pics
          </p>
        </div>
        
        <div class="space-y-6">
          ${[
            {
              q: 'Are there any rate limits?',
              a: 'No! Fallback.pics has no rate limits. Generate unlimited images, forever free.',
            },
            {
              q: 'How does AI generation work?',
