---
import Layout from '../layouts/Layout.astro';
import { blogPosts } from '../data/blogPosts';

const featuredPost = blogPosts[0];
const secondaryPosts = blogPosts.slice(1);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "fallback.pics Blog",
  "description": "Expert guides on image optimization, placeholders, and web performance from the fallback.pics team.",
  "url": "https://fallback.pics/blog",
  "publisher": {
    "@type": "Organization",
    "name": "fallback.pics",
    "logo": {
    "@type": "ImageObject",
      "url": "https://fallback.pics/favicon.svg"
    }
  },
  "blogPost": blogPosts.map(post => ({
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.description,
    "url": `https://fallback.pics/blog/${post.slug}`,
    "datePublished": post.date,
    "image": post.image,
    "author": {
      "@type": "Organization",
      "name": "fallback.pics Team"
    }
  }))
};
---

<Layout 
  title="Blog - Web Performance & Image Optimization Guides | fallback.pics" 
  description="Expert guides on image optimization, placeholders, lazy loading, and web performance. Learn from real case studies and best practices."
  keywords="web performance blog, image optimization guides, lazy loading tutorials, placeholder best practices, core web vitals, web development"
  ogImage="https://fallback.pics/api/v1/1200x630/7C3AED/FFFFFF?text=fallback.pics+Blog"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main id="main-content" class="blog-index">
    <section class="blog-index__hero">
      <p>Engineering notes</p>
      <h1>Practical writing for reliable image surfaces.</h1>
      <span>
        Guides on placeholder strategy, fallback image systems, loading states, and production UX for teams building resilient interfaces.
      </span>
    </section>

    <section class="blog-index__feature">
      <a href={`/blog/${featuredPost.slug}`} class="featured-card">
        <img src={featuredPost.image} alt="" loading="eager" />
        <div>
          <span>{featuredPost.category}</span>
          <h2>{featuredPost.title}</h2>
          <p>{featuredPost.description}</p>
          <div>
            <time datetime={featuredPost.date}>
              {new Date(featuredPost.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span>{featuredPost.readTime}</span>
          </div>
        </div>
      </a>
    </section>

    <section class="blog-index__grid" aria-label="Latest articles">
      <div class="blog-index__section-heading">
        <p>Latest</p>
        <h2>Guides for production teams</h2>
      </div>
      <div class="post-grid">
        {secondaryPosts.map((post) => (
          <a href={`/blog/${post.slug}`}>
            <img src={post.image} alt="" loading="lazy" />
            <div>
              <span>{post.category}</span>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <div class="post-grid__meta">
                <time datetime={post.date}>
                  {new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                <span>{post.readTime}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

<style>
  .blog-index {
    overflow-x: clip;
    background: #fafafa;
    color: #18181b;
  }

  .blog-index__hero,
  .blog-index__feature,
  .blog-index__grid {
    width: min(100% - 2rem, 80rem);
    margin: 0 auto;
  }

  .blog-index__hero {
    border-bottom: 1px solid #e4e4e7;
    padding: 5rem 0 3rem;
  }

  .blog-index__hero p,
  .blog-index__section-heading p,
  .featured-card span,
  .post-grid span {
    margin: 0;
    color: #6d28d9;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .blog-index__hero h1 {
    max-width: 58rem;
    margin: 1rem 0 0;
    color: #18181b;
    font-size: clamp(2.75rem, 6vw, 5.75rem);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .blog-index__hero > span {
    display: block;
    max-width: 45rem;
    margin-top: 1.5rem;
    color: #52525b;
    font-size: 1.1875rem;
    line-height: 1.75;
  }

  .blog-index__feature {
    padding: 3rem 0;
  }

  .featured-card {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #ffffff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .featured-card:hover,
  .post-grid a:hover {
    border-color: #c4b5fd;
    transform: translateY(-1px);
  }

  .featured-card img,
  .post-grid img {
    width: 100%;
    height: 100%;
    min-height: 18rem;
    object-fit: cover;
    background: #18181b;
  }

  .featured-card > div {
    padding: 2rem;
  }

  .featured-card h2,
  .blog-index__section-heading h2 {
    margin: 0.75rem 0 0;
    color: #18181b;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 650;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .featured-card p,
  .post-grid p {
    color: #52525b;
    font-size: 1rem;
    line-height: 1.75;
  }

  .featured-card div div,
  .post-grid__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: #71717a;
    font-size: 0.875rem;
    font-weight: 650;
  }

  .blog-index__grid {
    border-top: 1px solid #e4e4e7;
    padding: 3rem 0 6rem;
  }

  .blog-index__section-heading {
    margin-bottom: 1.5rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .post-grid a {
    display: grid;
    overflow: hidden;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    background: #ffffff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .post-grid img {
    min-height: 13rem;
    max-height: 15rem;
  }

  .post-grid a > div {
    padding: 1.25rem;
  }

  .post-grid h3 {
    margin: 0.75rem 0 0;
    color: #18181b;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
  }

  @media (max-width: 760px) {
    .featured-card,
    .post-grid {
      grid-template-columns: 1fr;
    }

    .blog-index__hero {
      padding-top: 3rem;
    }
  }
</style>
</Layout>
