---
import Layout from '../layouts/Layout.astro';
import { blogPosts } from '../data/blogPosts';

const sortedPosts = [...blogPosts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const latestPost = sortedPosts[0];
const editorPicks = sortedPosts.slice(1, 5);
const categories = Array.from(new Set(sortedPosts.map((post) => post.category))).sort();

const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'fallback.pics Blog',
  description:
    'Expert guides on image optimization, placeholders, and web performance from the fallback.pics team.',
  url: 'https://fallback.pics/blog/',
  publisher: {
    '@type': 'Organization',
    name: 'fallback.pics',
    logo: {
      '@type': 'ImageObject',
      url: 'https://fallback.pics/favicon.svg',
    },
  },
  blogPost: sortedPosts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    url: `https://fallback.pics/blog/${post.slug}/`,
    datePublished: post.date,
    image: post.image,
    author: {
      '@type': 'Organization',
      name: 'fallback.pics Team',
    },
  })),
};
---

<Layout
  title="Blog - Web Performance & Image Optimization Guides | fallback.pics"
  description="Expert guides on image optimization, placeholders, lazy loading, and web performance. Learn from real case studies and best practices."
  keywords="web performance blog, image optimization guides, lazy loading tutorials, placeholder best practices, core web vitals, web development"
  ogImage="https://fallback.pics/api/v1/1200x630/7C3AED/FFFFFF?text=fallback.pics+Blog"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main id="main-content" class="blog-index">
    <section class="blog-hero" aria-labelledby="blog-heading">
      <div class="blog-hero__copy">
        <p class="blog-eyebrow">fallback.pics Blog</p>
        <h1 id="blog-heading">Practical guides for resilient image surfaces.</h1>
        <p>
          Implementation notes, comparisons, and production patterns for placeholder images,
          fallback URLs, loading states, and media-heavy interfaces.
        </p>
      </div>
      <div class="blog-hero__meta" aria-label="Blog summary">
        <span>{sortedPosts.length} articles</span>
        <span>{categories.length} categories</span>
        <span>Updated {formatDate(sortedPosts[0]?.date ?? new Date().toISOString())}</span>
      </div>
    </section>

    <section class="blog-featured" aria-label="Featured blog posts">
      <article class="latest-post">
        <a href={`/blog/${latestPost.slug}/`} aria-label={`Read ${latestPost.title}`}>
          <img src={latestPost.image} alt="" loading="eager" />
          <div class="latest-post__content">
            <p class="blog-eyebrow">Latest post</p>
            <h2>{latestPost.title}</h2>
            <p>{latestPost.description}</p>
            <div class="post-meta">
              <span>{latestPost.category}</span>
              <time datetime={latestPost.date}>{formatDate(latestPost.date)}</time>
              <span>{latestPost.readTime}</span>
            </div>
          </div>
        </a>
      </article>

      <aside class="editor-picks" aria-labelledby="editor-picks-heading">
        <p class="blog-eyebrow">Editor's picks</p>
        <h2 id="editor-picks-heading">Start here</h2>
        <div class="editor-picks__list">
          {editorPicks.map((post) => (
            <a href={`/blog/${post.slug}/`} class="editor-pick">
              <img src={post.image} alt="" loading="lazy" />
              <div>
                <span>{post.category}</span>
                <h3>{post.title}</h3>
                <p>{post.readTime} · {formatDate(post.date)}</p>
              </div>
            </a>
          ))}
        </div>
      </aside>
    </section>

    <section class="blog-library" aria-labelledby="library-heading">
      <div class="blog-library__toolbar">
        <div>
          <p class="blog-eyebrow">All articles</p>
          <h2 id="library-heading">Browse every guide</h2>
        </div>
        <label class="blog-search">
          <span>Search articles</span>
          <input type="search" placeholder="Search" data-blog-search />
        </label>
      </div>

      <div class="blog-filters" aria-label="Filter by category">
        <button type="button" class="blog-filter blog-filter--active" data-blog-filter="all">All</button>
        {categories.map((category) => (
          <button type="button" class="blog-filter" data-blog-filter={category}>{category}</button>
        ))}
      </div>

      <div class="blog-card-grid" data-blog-grid>
        {sortedPosts.map((post) => (
          <article
            class="blog-card"
            data-blog-card
            data-category={post.category}
            data-search={`${post.title} ${post.description} ${post.category} ${post.tags.join(' ')}`.toLowerCase()}
          >
            <a href={`/blog/${post.slug}/`} aria-label={`Read ${post.title}`}>
              <img src={post.image} alt="" loading="lazy" />
              <div class="blog-card__body">
                <span>{post.category}</span>
                <h3>{post.title}</h3>
                <p>{post.description}</p>
                <div class="post-meta">
                  <time datetime={post.date}>{formatDate(post.date)}</time>
                  <span>{post.readTime}</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <p class="blog-empty" data-blog-empty hidden>No articles match that filter.</p>
    </section>
  </main>

  <script>
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-blog-filter]'));
    const searchInput = document.querySelector<HTMLInputElement>('[data-blog-search]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-blog-card]'));
    const empty = document.querySelector<HTMLElement>('[data-blog-empty]');
    let activeCategory = 'all';

    function updateCards() {
      const query = searchInput?.value.trim().toLowerCase() ?? '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
        const searchMatch = !query || (card.dataset.search ?? '').includes(query);
        const visible = categoryMatch && searchMatch;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (empty) empty.hidden = visibleCount > 0;
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.blogFilter ?? 'all';
        filterButtons.forEach((item) => {
          item.classList.toggle('blog-filter--active', item === button);
          item.setAttribute('aria-pressed', String(item === button));
        });
        updateCards();
      });
    });

    searchInput?.addEventListener('input', updateCards);
    filterButtons[0]?.setAttribute('aria-pressed', 'true');
  </script>

  <style>
    .blog-index {
      overflow-x: clip;
      background: var(--color-surface-subtle);
      color: var(--color-text);
    }

    .blog-hero,
    .blog-featured,
    .blog-library {
      width: min(100% - 2rem, 80rem);
      margin: 0 auto;
    }

    .blog-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2rem;
      align-items: end;
      border-bottom: 1px solid var(--color-border);
      padding: 5rem 0 2.75rem;
    }

    .blog-hero__copy {
      max-width: 58rem;
    }

    .blog-eyebrow,
    .blog-card__body > span,
    .editor-pick span {
      margin: 0;
      color: var(--color-brand-hover);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .blog-hero h1 {
      margin: 1rem 0 0;
      color: var(--color-text);
      font-size: clamp(2.6rem, 5.8vw, 5.8rem);
      font-weight: 650;
      line-height: 0.98;
      letter-spacing: 0;
    }

    .blog-hero__copy > p:last-child {
      max-width: 46rem;
      margin: 1.5rem 0 0;
      color: var(--color-text-muted);
      font-size: 1.125rem;
      line-height: 1.75;
    }

    .blog-hero__meta {
      display: grid;
      gap: 0.5rem;
      min-width: 13rem;
      color: var(--color-text-muted);
      font-size: 0.875rem;
      font-weight: 700;
    }

    .blog-hero__meta span {
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      background: var(--color-surface);
      padding: 0.75rem 0.9rem;
    }

    .blog-featured {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.85fr);
      gap: 2rem;
      padding: 3rem 0 4rem;
    }

    .latest-post a,
    .blog-card a {
      display: grid;
      height: 100%;
      overflow: hidden;
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      background: var(--color-surface);
      color: inherit;
      text-decoration: none;
      box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
      transition: border-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
    }

    .latest-post a:hover,
    .blog-card a:hover,
    .editor-pick:hover {
      border-color: var(--color-brand-soft);
      box-shadow: 0 18px 40px rgb(15 23 42 / 0.08);
      transform: translateY(-2px);
    }

    .latest-post img {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      background: var(--color-text);
    }

    .latest-post__content {
      padding: 1.5rem;
    }

    .latest-post h2,
    .blog-library__toolbar h2 {
      margin: 0.75rem 0 0;
      color: var(--color-text);
      font-size: clamp(2rem, 4vw, 3.65rem);
      font-weight: 650;
      line-height: 1.02;
      letter-spacing: 0;
    }

    .latest-post__content > p:not(.blog-eyebrow),
    .blog-card p {
      color: var(--color-text-muted);
      line-height: 1.7;
    }

    .post-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      color: var(--color-text-soft);
      font-size: 0.8125rem;
      font-weight: 700;
    }

    .editor-picks {
      min-width: 0;
    }

    .editor-picks h2 {
      margin: 0.5rem 0 1rem;
      color: var(--color-text);
      font-size: 1.5rem;
      line-height: 1.15;
    }

    .editor-picks__list {
      display: grid;
      gap: 0.75rem;
    }

    .editor-pick {
      display: grid;
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 0.9rem;
      align-items: center;
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      background: var(--color-surface);
      color: inherit;
      padding: 0.75rem;
      text-decoration: none;
      transition: border-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
    }

    .editor-pick img {
      width: 100%;
      aspect-ratio: 4 / 3;
      border-radius: 0.375rem;
      object-fit: cover;
      background: var(--color-text);
    }

    .editor-pick h3 {
      margin: 0.35rem 0 0;
      color: var(--color-text);
      font-size: 1rem;
      line-height: 1.18;
    }

    .editor-pick p {
      margin: 0.45rem 0 0;
      color: var(--color-text-soft);
      font-size: 0.8125rem;
      font-weight: 700;
    }

    .blog-library {
      border-top: 1px solid var(--color-border);
      padding: 3rem 0 6rem;
    }

    .blog-library__toolbar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
      gap: 1.5rem;
      align-items: end;
      margin-bottom: 1.5rem;
    }

    .blog-search {
      display: grid;
      gap: 0.45rem;
      color: var(--color-text-muted);
      font-size: 0.8125rem;
      font-weight: 800;
    }

    .blog-search input {
      min-height: 2.85rem;
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      background: var(--color-surface);
      color: var(--color-text);
      font: inherit;
      padding: 0 0.9rem;
    }

    .blog-search input:focus {
      border-color: var(--color-brand);
      outline: 2px solid color-mix(in srgb, var(--color-brand) 20%, transparent);
      outline-offset: 2px;
    }

    .blog-filters {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding-bottom: 0.75rem;
    }

    .blog-filter {
      flex: 0 0 auto;
      min-height: 2.4rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: var(--color-surface);
      color: var(--color-text-muted);
      cursor: pointer;
      font-size: 0.8125rem;
      font-weight: 800;
      padding: 0 0.95rem;
    }

    .blog-filter--active,
    .blog-filter:hover {
      border-color: var(--color-brand-soft);
      background: var(--color-brand-soft);
      color: var(--color-brand-strong);
    }

    .blog-card-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .blog-card[hidden] {
      display: none;
    }

    .blog-card img {
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      background: var(--color-text);
    }

    .blog-card__body {
      display: grid;
      gap: 0.85rem;
      padding: 1.1rem;
    }

    .blog-card h3 {
      margin: 0;
      color: var(--color-text);
      font-size: 1.2rem;
      font-weight: 750;
      line-height: 1.18;
    }

    .blog-card p {
      display: -webkit-box;
      min-height: 5.1rem;
      margin: 0;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .blog-empty {
      border: 1px dashed var(--color-border-strong);
      border-radius: 0.5rem;
      background: var(--color-surface);
      color: var(--color-text-muted);
      font-weight: 700;
      margin-top: 1rem;
      padding: 1rem;
      text-align: center;
    }

    @media (max-width: 980px) {
      .blog-hero,
      .blog-featured,
      .blog-library__toolbar {
        grid-template-columns: 1fr;
      }

      .blog-hero__meta {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .blog-card-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .blog-hero {
        padding-top: 3rem;
      }

      .blog-hero__meta,
      .blog-card-grid,
      .editor-pick {
        grid-template-columns: 1fr;
      }

      .editor-pick img {
        aspect-ratio: 16 / 9;
      }
    }
  </style>
</Layout>
