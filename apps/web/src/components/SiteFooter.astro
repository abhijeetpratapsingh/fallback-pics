---
import SiteBrand from './SiteBrand.astro';
import { footerSections } from '../navigation';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__intro">
      <a
        href="/"
        class="site-footer__brand"
        aria-label="fallback.pics home"
        data-analytics-event="footer_click"
        data-analytics-category="navigation"
        data-analytics-label="Footer brand home"
      >
        <SiteBrand />
      </a>
      <p>
        Global fallback image infrastructure for production applications, design systems, storefronts, and developer workflows.
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer navigation">
      {footerSections.map((section) => (
        <div>
          <h2>{section.heading}</h2>
          <ul>
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-analytics-event="footer_click"
                  data-analytics-category="navigation"
                  data-analytics-label={`${section.heading}: ${link.label}`}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="site-footer__bottom">
    <span>&copy; 2026 fallback.pics. Built for stable layouts and reliable fallbacks.</span>
    <span>No cookies required for image delivery.</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-code-surface-border);
    background: var(--color-text);
    color: var(--color-inverse-text);
  }

  .site-footer__inner,
  .site-footer__bottom {
    width: min(100% - 2rem, 80rem);
    margin: 0 auto;
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 3rem;
    padding: 3.5rem 0;
  }

  .site-footer__brand {
    display: inline-flex;
    color: var(--color-inverse-text);
    text-decoration: none;
  }

  .site-footer__intro p {
    max-width: 23rem;
    margin: 1.25rem 0 0;
    color: var(--color-text-disabled);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  .site-footer h2 {
    margin: 0;
    color: var(--color-inverse-text);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .site-footer ul {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
  }

  .site-footer a {
    color: var(--color-text-disabled);
    font-size: 0.875rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .site-footer a:hover {
    color: var(--color-inverse-text);
  }

  .site-footer a:focus-visible {
    outline: 2px solid #a78bfa;
    outline-offset: 3px;
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem 0;
    color: var(--color-text-soft);
    font-size: 0.875rem;
  }

  @media (max-width: 900px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .site-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__bottom {
      flex-direction: column;
    }
  }
</style>
