# Astro Website Environment Variables

# API endpoint for the worker
PUBLIC_API_URL=http://localhost:8787

# Optional: Analytics
PUBLIC_ANALYTICS_ID=

# Optional: Discord invite link
PUBLIC_DISCORD_INVITE=https://discord.gg/hwGJNnN3

# Optional: GitHub repository
PUBLIC_GITHUB_REPO=https://github.com/nosignupdev/fallbackpics

# Optional: Support email
PUBLIC_SUPPORT_EMAIL=support@fallback.pics