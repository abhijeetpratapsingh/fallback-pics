# Cloudflare Worker Environment Variables

# Optional: Custom domain for your instance
# CUSTOM_DOMAIN=your-domain.com

# Optional: Rate limiting (requests per day for free tier)
# RATE_LIMIT_FREE=1000

# Optional: Analytics
# ANALYTICS_ENABLED=true

# Optional: Custom default colors (hex without #)
# DEFAULT_BG_COLOR=7C3AED
# DEFAULT_TEXT_COLOR=FFFFFF

# Optional: Maximum image dimensions
# MAX_WIDTH=3000
# MAX_HEIGHT=3000

# Optional: Cache duration in seconds
# CACHE_DURATION=31536000